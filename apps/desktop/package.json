{
  "name": "@lymi/desktop",
  "productName": "Lymi",
  "version": "0.0.1",
  "license": "FSL-1.1-MIT",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "dev": "node node_modules/electron/install.js && tsc -p tsconfig.build.json && electron .",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "tray-icon": "sh scripts/tray-icon.sh",
    "app-icon": "sh scripts/app-icon.sh",
    "test": "vitest run",
    "package": "pnpm build && electron-forge package",
    "make": "pnpm build && electron-forge make",
    "launch-check": "node scripts/launch-check.js"
  },
  "devDependencies": {
    "@electron-forge/cli": "8.0.1",
    "@electron-forge/maker-zip": "8.0.1",
    "@electron-forge/plugin-fuses": "8.0.1",
    "@electron/fuses": "2.1.3",
    "@lymi/client": "workspace:*",
    "@playwright/test": "1.64.0",
    "@types/node": "^26.6.5",
    "electron": "45.0.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}

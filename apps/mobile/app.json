{
  "expo": {
    "name": "Lymi",
    "slug": "lymi",
    "scheme": "lymi",
    "version": "0.0.1",
    "platforms": ["ios", "android"],
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#130d09",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "ios": {
      "bundleIdentifier": "app.lymi",
      "supportsTablet": true,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.lymi",
      "adaptiveIcon": {
        "backgroundColor": "#130d09",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true
    },
    "experiments": {
      "typedRoutes": true,
      "tsconfigPaths": false
    },
    "buildCacheProvider": {
      "plugin": "./scripts/build-cache-provider.cjs"
    },
    "plugins": [
      "./plugins/no-push-entitlement.cjs",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-light.png",
          "imageWidth": 96,
          "backgroundColor": "#f8f6f4",
          "dark": {
            "image": "./assets/splash-dark.png",
            "backgroundColor": "#120f0c"
          }
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./node_modules/@expo-google-fonts/onest/400Regular/Onest_400Regular.ttf",
            "./node_modules/@expo-google-fonts/onest/500Medium/Onest_500Medium.ttf",
            "./node_modules/@expo-google-fonts/onest/600SemiBold/Onest_600SemiBold.ttf"
          ]
        }
      ],
      [
        "expo-widgets",
        {
          "widgets": [
            {
              "name": "TodayWidget",
              "displayName": "Lantern",
              "description": "What's due, under the lantern.",
              "ios": {
                "supportedFamilies": ["systemSmall", "systemMedium"]
              }
            },
            {
              "name": "WeekWidget",
              "displayName": "Week",
              "description": "Your streak's week, as seven lights.",
              "ios": {
                "supportedFamilies": ["systemMedium"]
              }
            },
            {
              "name": "LockWidget",
              "displayName": "Lantern",
              "description": "Cards due on your Lock Screen.",
              "ios": {
                "supportedFamilies": [
                  "accessoryCircular",
                  "accessoryRectangular",
                  "accessoryInline"
                ]
              }
            }
          ]
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Lymi uses your photos when you add a picture to a card.",
          "cameraPermission": "Lymi uses the camera when you take a picture for a card."
        }
      ],
      "expo-asset",
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ],
      "expo-notifications",
      "@bacons/apple-targets"
    ]
  }
}

{
  "cli": {
    "version": ">= 24.13.0",
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "node": "22.22.3",
      "pnpm": "10.16.1",
      "env": {
        "LYMI_APP_LINKS": "1",
        "POSTHOG_CLI_HOST": "https://eu.posthog.com",
        "POSTHOG_CLI_PROJECT_ID": "292417"
      },
      "ios": {
        "image": "latest"
      }
    },
    "beta": {
      "extends": "base",
      "channel": "beta",
      "environment": "preview",
      "autoIncrement": true
    },
    "production": {
      "extends": "base",
      "channel": "production",
      "environment": "production",
      "autoIncrement": true
    }
  },
  "submit": {
    "beta": {
      "ios": {
        "ascAppId": "6822912687"
      }
    },
    "production": {
      "ios": {
        "ascAppId": "6822912687"
      }
    }
  }
}

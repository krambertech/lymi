{
  "sourceLanguage": "en",
  "strings": {
    "Add ${term} to ${deck}": {
      "comment": "Shown by iOS for Lymi’s controls and intents. The translate skill fills uk and ru.",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавить ${term} в ${deck}"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Додати ${term} до ${deck}"
          }
        }
      }
    },
    "Add ${term} to Lymi": {
      "comment": "Shown by iOS for Lymi’s controls and intents. The translate skill fills uk and ru.",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавить ${term} в Lymi"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Додати ${term} в Lymi"
          }
        }
      }
    },
    "Add a card": {
      "comment": "Shown by iOS for Lymi’s controls and intents. The translate skill fills uk and ru.",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавить карточку"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Додати картку"
          }
        }
      }
    },
    "Add a word": {
      "comment": "Shown by iOS for Lymi’s controls and intents. The translate skill fills uk and ru.",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавить слово"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Додати слово"
          }
        }
      }
    },
    "Added “%@” to %@": {
      "comment": "Shown by iOS for Lymi’s controls and intents. The translate skill fills uk and ru.",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» добавлено в колоду %2$@"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» додано до колоди %2$@"
          }
        }
      }
    },
    "Adds a card without opening Lymi. Leave the deck empty and Lymi picks your deck for the term’s language.": {
      "comment": "Shown by iOS for Lymi’s controls and intents. The translate skill fills uk and ru.",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавляет карточку, не открывая Lymi. Если колода не выбрана, Lymi берёт твою колоду для языка термина."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Додає картку, не відкриваючи Lymi. Якщо колоду не вибрано, Lymi бере твою колоду для мови терміна."
          }
        }
      }
    },
    "Cards due": {
      "comment": "Shown by iOS for Lymi’s controls and intents. The translate skill fills uk and ru.",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Карточки к повторению"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Картки до повторення"
          }
        }
      }
    },
    "Create a deck in Lymi first.": {
      "comment": "Shown by iOS for Lymi’s controls and intents. The translate skill fills uk and ru.",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сначала создай колоду в Lymi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Спершу створи колоду в Lymi."
          }
        }
      }
    },
    "Deck": {
      "comment": "Shown by iOS for Lymi’s controls and intents. The translate skill fills uk and ru.",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Колода"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Колода"
          }
        }
      }
    },
    "Fill in with AI": {
      "comment": "Shown by iOS for Lymi’s controls and intents. The translate skill fills uk and ru.",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дополнить с AI"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Доповнити з AI"
          }
        }
      }
    },
    "Lymi can’t be reached. Open the app to add “%@” there.": {
      "comment": "Shown by iOS for Lymi’s controls and intents. The translate skill fills uk and ru.",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Lymi не на связи. Открой приложение, чтобы добавить «%@» там."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Lymi не на зв’язку. Відкрий застосунок, щоб додати «%@» там."
          }
        }
      }
    },
    "Meaning": {
      "comment": "Shown by iOS for Lymi’s controls and intents. The translate skill fills uk and ru.",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Значение"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Значення"
          }
        }
      }
    },
    "Open Lymi to see what’s due.": {
      "comment": "Shown by iOS for Lymi’s controls and intents. The translate skill fills uk and ru.",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открой Lymi, чтобы увидеть, что повторять."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкрий Lymi, щоб побачити, що повторювати."
          }
        }
      }
    },
    "Opens Add a word in Lymi, with the term filled in when you give one.": {
      "comment": "Shown by iOS for Lymi’s controls and intents. The translate skill fills uk and ru.",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открывает «Добавить слово» в Lymi и вписывает термин, если ты его назовёшь."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкриває «Додати слово» в Lymi і вписує термін, якщо ти його назвеш."
          }
        }
      }
    },
    "Opens Add a word in Lymi.": {
      "comment": "Shown by iOS for Lymi’s controls and intents. The translate skill fills uk and ru.",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открывает «Добавить слово» в Lymi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкриває «Додати слово» в Lymi."
          }
        }
      }
    },
    "Opens a review in Lymi and shows what’s due.": {
      "comment": "Shown by iOS for Lymi’s controls and intents. The translate skill fills uk and ru.",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открывает повторение в Lymi и показывает, что повторять."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкриває повторення в Lymi і показує, що повторювати."
          }
        }
      }
    },
    "Opens a review in Lymi.": {
      "comment": "Shown by iOS for Lymi’s controls and intents. The translate skill fills uk and ru.",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открывает повторение в Lymi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкриває повторення в Lymi."
          }
        }
      }
    },
    "Review": {
      "comment": "Shown by iOS for Lymi’s controls and intents. The translate skill fills uk and ru.",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Повторение"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Повторення"
          }
        }
      }
    },
    "Says how many cards are due and how today’s goal stands, without opening Lymi.": {
      "comment": "Shown by iOS for Lymi’s controls and intents. The translate skill fills uk and ru.",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Говорит, сколько карточек к повторению и как продвигается дневная цель, не открывая Lymi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Каже, скільки карток до повторення і як просувається денна мета, не відкриваючи Lymi."
          }
        }
      }
    },
    "Sign in to Lymi to add “%@”.": {
      "comment": "Shown by iOS for Lymi’s controls and intents. The translate skill fills uk and ru.",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Войди в Lymi, чтобы добавить «%@»."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Увійди в Lymi, щоб додати «%@»."
          }
        }
      }
    },
    "Term": {
      "comment": "Shown by iOS for Lymi’s controls and intents. The translate skill fills uk and ru.",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Термин"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Термін"
          }
        }
      }
    },
    "That deck isn’t in Lymi anymore. Choose another one in the shortcut.": {
      "comment": "Shown by iOS for Lymi’s controls and intents. The translate skill fills uk and ru.",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этой колоды больше нет в Lymi. Выбери другую в команде."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цієї колоди вже немає в Lymi. Вибери іншу в команді."
          }
        }
      }
    },
    "That didn’t work. Try again.": {
      "comment": "Shown by iOS for Lymi’s controls and intents. The translate skill fills uk and ru.",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не получилось. Попробуй ещё раз."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вийшло. Спробуй ще раз."
          }
        }
      }
    },
    "Update Lymi to add cards from Shortcuts.": {
      "comment": "Shown by iOS for Lymi’s controls and intents. The translate skill fills uk and ru.",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обнови Lymi, чтобы добавлять карточки из Быстрых команд."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Онови Lymi, щоб додавати картки з Команд."
          }
        }
      }
    },
    "What’s the term?": {
      "comment": "Shown by iOS for Lymi’s controls and intents. The translate skill fills uk and ru.",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Какой термин?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Який термін?"
          }
        }
      }
    },
    "Which deck?": {
      "comment": "Shown by iOS for Lymi’s controls and intents. The translate skill fills uk and ru.",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Какая колода?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Яка колода?"
          }
        }
      }
    },
    "“%@” is already in %@": {
      "comment": "Shown by iOS for Lymi’s controls and intents. The translate skill fills uk and ru.",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» уже есть в колоде %2$@"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» уже є в колоді %2$@"
          }
        }
      }
    }

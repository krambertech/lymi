{
  "name": "@lymi/site",
  "version": "0.0.1",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "wrangler dev",
    "deploy": "astro build && wrangler deploy",
    "deploy:ci": "node ../../scripts/apply-migrations-ci.mjs && wrangler deploy --tag \"$WORKERS_CI_COMMIT_SHA\"",
    "deploy:check": "wrangler deploy --dry-run",
    "typecheck": "astro check && tsc -p tsconfig.worker.json",
    "test": "vitest run --passWithNoTests",
    "cf-typegen": "wrangler types",
    "i18n:extract": "lingui extract --clean",
    "hand:audio": "node scripts/hand-audio.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.4",
    "@fontsource-variable/onest": "^5.3.1",
    "@fontsource/caveat": "5.3.0",
    "@lingui/core": "6.9.1",
    "@lingui/react": "6.9.1",
    "@lymi/core": "workspace:*",
    "@resvg/resvg-wasm": "2.6.2",
    "@tanstack/react-query": "^5.104.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.55.0",
    "motion": "^14.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/react": "^6.0.5",
    "@babel/core": "7.29.7",
    "@lingui/babel-plugin-lingui-macro": "6.9.1",
    "@lingui/cli": "6.9.1",
    "@lingui/format-po": "6.9.1",
    "@lingui/vite-plugin": "6.9.1",
    "@rolldown/plugin-babel": "0.2.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "astro": "^7.3.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3",
    "wrangler": "^4.149.0"
  }
}

{
  "name": "@lymi/site",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "wrangler dev",
    "deploy": "astro build && wrangler deploy",
    "deploy:ci": "node ../../scripts/apply-migrations-ci.mjs && wrangler deploy --tag \"$WORKERS_CI_COMMIT_SHA\"",
    "deploy:check": "wrangler deploy --dry-run",
    "typecheck": "astro check && tsc -p tsconfig.worker.json",
    "test": "vitest run --passWithNoTests",
    "cf-typegen": "wrangler types",
    "i18n:extract": "lingui extract --clean"
  },
  "dependencies": {
    "@lingui/core": "6.7.0",
    "@lingui/react": "6.7.0",
    "@lymi/core": "workspace:*",
    "@tanstack/react-query": "^5.102.8",
    "clsx": "^2.1.1",
    "lucide-react": "^1.41.0",
    "motion": "^13.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.6",
    "@astrojs/react": "^6.0.5",
    "@babel/core": "7.29.7",
    "@lingui/babel-plugin-lingui-macro": "6.7.0",
    "@lingui/cli": "6.7.0",
    "@lingui/format-po": "6.7.0",
    "@lingui/vite-plugin": "6.7.0",
    "@rolldown/plugin-babel": "0.2.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "astro": "^7.3.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0",
    "wrangler": "^4.129.0"
  }
}

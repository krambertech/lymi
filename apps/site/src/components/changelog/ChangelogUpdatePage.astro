---
import { ArrowLeft, ArrowRight } from "lucide-react";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { type ChangelogUpdate as Update, changelogDate, changelogUpdates } from "../../lib/changelog";
import { changelogUpdatePath, changelogUpdatePaths } from "../../lib/changelog-paths";
import { pageI18n } from "../../lib/i18n";
import { type Locale, localizedPath } from "../../lib/routes";
import { buttonClass } from "../Button";
import SiteHeader from "../islands/SiteHeader";
import { PageFooter } from "../PageFooter";
import ChangelogUpdate from "./ChangelogUpdate.astro";
import {
  CHANGELOG_ALL,
  CHANGELOG_FEED_TITLE,
  CHANGELOG_NEWER,
  CHANGELOG_OLDER,
  CHANGELOG_PAGER,
  CHANGELOG_SKIP,
} from "./changelog-copy";

interface Props {
  locale: Locale;
  slug: string;
}

const { locale, slug } = Astro.props;
const i18n = pageI18n(locale);
const updates = await changelogUpdates(locale);
const index = updates.findIndex((update) => update.slug === slug);
const update = updates[index] as Update;
const newer = updates[index - 1];
const older = updates[index + 1];
const listPath = localizedPath("changelog", locale);
---

<BaseLayout
  title={`${update.entry.data.title} · Lymi`}
  description={update.entry.data.summary}
  canonicalPath={changelogUpdatePath(slug, locale)}
  alternatePaths={changelogUpdatePaths(slug)}
>
  <link
    slot="head"
    rel="alternate"
    type="application/rss+xml"
    title={i18n._(CHANGELOG_FEED_TITLE)}
    href={`${listPath}/rss.xml`}
  />
  <div class="@container min-h-dvh overflow-x-clip bg-canvas text-ink">
    <a
      href="#update"
      class="sr-only rounded-sm bg-plate px-3 py-2 text-base text-ink edge focus:not-sr-only focus:absolute focus:start-3 focus:top-3 focus:z-(--z-tooltip)"
    >
      {i18n._(CHANGELOG_SKIP)}
    </a>
    <header>
      <SiteHeader client:load locale={locale} />
    </header>

    <main id="update" class="mx-auto max-w-[1040px] px-5 pt-10 pb-20 @2xl:px-10 @4xl:pt-14">
      <a href={listPath} class={buttonClass("ghost", "sm", "-ms-3")}>
        <ArrowLeft aria-hidden="true" data-icon="inline-start" className="rtl:-scale-x-100" />
        {i18n._(CHANGELOG_ALL)}
      </a>
      <div class="mt-10 grid gap-x-12 gap-y-3 @4xl:grid-cols-[180px_minmax(0,1fr)]">
        <p class="text-sm text-ink-muted">
          <time datetime={update.date.toISOString().slice(0, 10)}>{changelogDate(update.date, locale)}</time>
        </p>
        <ChangelogUpdate update={update} locale={locale} />
      </div>

      {
        (newer || older) && (
          <nav
            aria-label={i18n._(CHANGELOG_PAGER)}
            class="mt-16 grid gap-3 border-t border-edge pt-8 @xl:grid-cols-2 @4xl:ms-[calc(180px+3rem)]"
          >
            {older && (
              <a href={changelogUpdatePath(older.slug, locale)} class="group rounded-lg bg-plate p-4 edge hoverable:hover:edge-strong">
                <span class="flex items-center gap-1.5 text-sm text-ink-muted">
                  <ArrowLeft aria-hidden="true" className="size-4 rtl:-scale-x-100" />
                  {i18n._(CHANGELOG_OLDER)}
                </span>
                <span class="mt-1 block text-base font-medium text-ink">{older.entry.data.title}</span>
              </a>
            )}
            {newer && (
              <a
                href={changelogUpdatePath(newer.slug, locale)}
                class="group rounded-lg bg-plate p-4 text-end edge hoverable:hover:edge-strong @xl:col-start-2"
              >
                <span class="flex items-center justify-end gap-1.5 text-sm text-ink-muted">
                  {i18n._(CHANGELOG_NEWER)}
                  <ArrowRight aria-hidden="true" className="size-4 rtl:-scale-x-100" />
                </span>
                <span class="mt-1 block text-base font-medium text-ink">{newer.entry.data.title}</span>
              </a>
            )}
          </nav>
        )
      }
    </main>

    <script>
      import { fitChangelogStages } from "../../lib/changelog-stage";
      fitChangelogStages();
    </script>
    <PageFooter locale={locale} paths={changelogUpdatePaths(slug)} />
  </div>
</BaseLayout>

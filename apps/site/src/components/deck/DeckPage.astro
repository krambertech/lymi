---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { withNoteBlocks } from "../../lib/deck-notes";
import { deckPath, deckPaths, deckSharePath, jsonForScript, recallCue, sectionPath, stackCards } from "../../lib/deck-page";
import { pageI18n } from "../../lib/i18n";
import { localizedPath } from "../../lib/routes";
import { deckBreadcrumbs, deckStructuredData } from "../../lib/structured-data";
import { trayHue } from "../../lib/tray";
import type { DeckPage } from "../../lib/public-deck";
import PublicNav from "../islands/PublicNav";
import DeckClosing from "../islands/DeckClosing";
import DeckFeatures from "../islands/DeckFeatures";
import DeckStack from "../islands/DeckStack";
import { shelfLabel } from "../explore/explore-labels";
import { EXPLORE_NAME } from "../explore/explore-meta";
import { shelfPath } from "../../lib/explore";
import { deckDescription, deckShareText, deckTitle, MISSING_BLURB, MISSING_TITLE, UNAVAILABLE_BLURB, UNAVAILABLE_TITLE } from "./deck-meta";
import { addUrl, DeckFooter, DeckGone, DeckNeighbours, DeckRelated, editionOf } from "./DeckView";
import { DeckContents, DeckLadder, DeckLandingHero, ladderRungs, DeckHowItWorks, DeckStickyAdd } from "./DeckLanding";

interface Props {
  page: DeckPage;
}

const { page } = Astro.props;
const { locale } = page;
const i18n = pageI18n(locale);
const slug = page.status === 200 ? page.deck.slug : page.slug;
const paths = deckPaths(slug, page.status === 200 ? page.deck : undefined);
const deck = page.status === 200 ? page.deck : null;
const path = deck ? sectionPath(deck) : null;
const stack = deck ? withNoteBlocks(stackCards(deck)) : [];
const edition = deck ? editionOf(deck) : undefined;
const share = deck ? deckShareText(i18n, deck) : null;
// The bento's return lane follows one of the deck's first terms, the shortest, since its cards are small.
const laneTerm =
  stack
    .map((card) => card.term)
    .filter((term) => [...term].length <= 8 && !term.includes("\n"))
    .sort((a, b) => [...a].length - [...b].length)[0] ?? null;
// The language's levels, from the related decks and the language's others; a deck the ladder
// shows leaves More like this, so no deck is offered twice in a row.
const rungs = page.status === 200 ? ladderRungs(page.deck, [...page.related, ...page.links.language]) : [];
const laddered = new Set(rungs.flatMap(([, other]) => (other ? [other.slug] : [])));
const related = page.status === 200 ? page.related.filter((each) => !laddered.has(each.slug)) : [];
const shelf =
  page.status === 200 && page.links.shelf
    ? { name: shelfLabel(i18n, page.links.shelf), path: shelfPath(page.links.shelf.route, locale) }
    : null;
---

{
  page.status === 200 ? (
    <BaseLayout
      title={deckTitle(i18n, page.deck)}
      description={deckDescription(i18n, page.deck)}
      canonicalPath={deckPath(slug, locale)}
      alternatePaths={paths}
      shareImagePath={deckSharePath(slug, locale)}
      shareImageAlt={share?.alt}
    >
      <script
        slot="head"
        is:inline
        type="application/ld+json"
        set:html={jsonForScript(deckStructuredData(page.deck, locale))}
      />
      <script
        slot="head"
        is:inline
        type="application/ld+json"
        set:html={jsonForScript(deckBreadcrumbs(page.deck, locale, i18n._(EXPLORE_NAME), shelf))}
      />
      <div class="@container min-h-dvh overflow-x-clip bg-canvas text-ink">
        <header class="deck-hero-tint over-tint" data-hue={trayHue(slug)}>
          <PublicNav client:load locale={locale} />
          <DeckLandingHero deck={page.deck} locale={locale} spread={stack} canTry={stack.length > 0} />
        </header>
        <main class="deck-main">
          {path && <DeckContents deck={page.deck} locale={locale} steps={path.steps} inOrder={path.inOrder} />}
          <section id="how" aria-labelledby="how-title" class="scroll-mt-6 border-t border-edge px-5 py-16 @2xl:px-10 @4xl:py-24">
            <div class="mx-auto grid max-w-[1040px] items-center gap-12 @4xl:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)] @4xl:gap-20">
              <DeckHowItWorks locale={locale} cue={recallCue(stack)} />
              {stack.length > 0 && (
                <div id="try" class="min-w-0 scroll-mt-6" data-add="try">
                  <DeckStack
                    client:visible
                    locale={locale}
                    slug={slug}
                    cards={stack}
                    termLanguage={page.deck.language}
                    total={page.deck.cardCount}
                    addUrl={addUrl(slug, edition)}
                  />
                </div>
              )}
            </div>
          </section>
          <DeckFeatures client:visible locale={locale} term={laneTerm} lang={page.deck.language} />
          <DeckLadder deck={page.deck} locale={locale} rungs={rungs} />
          <DeckClosing client:visible locale={locale} name={page.deck.name} meaningLanguage={page.deck.meaningLanguage} addUrl={addUrl(slug, edition)} />
          <DeckRelated decks={related} locale={locale} />
          <DeckNeighbours deck={page.deck} links={page.links} locale={locale} />
        </main>
        <DeckStickyAdd deck={page.deck} locale={locale} />
        <script>
          import { startDeckPage } from "../../lib/deck-page-client";
          startDeckPage();
        </script>
        <DeckFooter locale={locale} languagePaths={paths} />
      </div>
    </BaseLayout>
  ) : (
    <BaseLayout
      title={i18n._(page.status === 410 ? UNAVAILABLE_TITLE : MISSING_TITLE)}
      description={i18n._(page.status === 410 ? UNAVAILABLE_BLURB : MISSING_BLURB)}
      canonicalPath={localizedPath("landing", locale)}
    >
      <meta slot="head" name="robots" content="noindex" />
      <div class="@container flex min-h-dvh flex-col overflow-x-clip bg-canvas text-ink">
        <header>
          <PublicNav client:load locale={locale} />
        </header>
        <div class="flex flex-1 flex-col justify-center">
          <DeckGone status={page.status} locale={locale} />
        </div>
        <DeckFooter locale={locale} languagePaths={paths} />
      </div>
    </BaseLayout>
  )
}

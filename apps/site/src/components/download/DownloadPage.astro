---
import { Download } from "lucide-react";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { pageI18n } from "../../lib/i18n";
import { downloadHref } from "../../lib/downloads";
import { type Locale, localizedPath } from "../../lib/routes";
import { buttonClass } from "../Button";
import { GetTheAppIn } from "../GetTheApp";
import SiteHeader from "../islands/SiteHeader";
import { PageFooter } from "../PageFooter";
import {
  DOWNLOAD_BUTTON,
  DOWNLOAD_DESCRIPTION,
  DOWNLOAD_HEADING,
  DOWNLOAD_INTEL,
  DOWNLOAD_INTEL_LABEL,
  DOWNLOAD_LEDE,
  DOWNLOAD_MAC_HEADING,
  DOWNLOAD_MAC_LEDE,
  DOWNLOAD_REQUIREMENT,
  DOWNLOAD_SKIP,
  DOWNLOAD_STEPS,
  DOWNLOAD_STEPS_HEADING,
  DOWNLOAD_TITLE,
} from "./download-copy";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const i18n = pageI18n(locale);
---

<BaseLayout
  title={i18n._(DOWNLOAD_TITLE)}
  description={i18n._(DOWNLOAD_DESCRIPTION)}
  canonicalPath={localizedPath("download", locale)}
  localizedPage="download"
>
  <div class="@container min-h-dvh overflow-x-clip bg-canvas text-ink">
    <a
      href="#download"
      class="sr-only rounded-sm bg-plate px-3 py-2 text-base text-ink edge focus:not-sr-only focus:absolute focus:start-3 focus:top-3 focus:z-(--z-tooltip)"
    >
      {i18n._(DOWNLOAD_SKIP)}
    </a>
    <header>
      <SiteHeader client:load locale={locale} />
    </header>

    <main
      class="mx-auto flex max-w-[1040px] flex-col items-center px-5 pt-16 pb-20 text-center @2xl:px-10 @4xl:pt-24 @4xl:pb-28"
    >
      <div class="hero-ground">
        <img src="/mac/icon.png" width="176" height="176" alt="" class="size-36 @2xl:size-44" />
      </div>
      <h1 class="mt-6 text-5xl font-medium tracking-[-0.038em] text-balance text-ink @4xl:text-[4.25rem] @4xl:leading-[0.98]">
        {i18n._(DOWNLOAD_HEADING)}
      </h1>
      <p class="mt-5 max-w-[40ch] text-lg text-pretty text-ink-secondary @2xl:text-xl">{i18n._(DOWNLOAD_LEDE)}</p>
      <div id="download" class="mt-9 flex w-full justify-center">
        <GetTheAppIn locale={locale} />
      </div>

      <section aria-labelledby="mac" class="mt-20 flex w-full max-w-[880px] flex-col items-center border-t border-edge pt-14 @4xl:mt-24">
        <h2 id="mac" class="text-3xl font-medium tracking-[-0.03em] text-ink @2xl:text-4xl">
          {i18n._(DOWNLOAD_MAC_HEADING)}
        </h2>
        <p class="mt-3 max-w-[36ch] text-base text-pretty text-ink-secondary @2xl:text-lg">{i18n._(DOWNLOAD_MAC_LEDE)}</p>
        <div class="mt-7 flex flex-col items-center gap-3">
          <a href={downloadHref("/download/mac", locale)} class={buttonClass("secondary", "lg")}>
            <Download aria-hidden="true" data-icon="inline-start" />
            {i18n._(DOWNLOAD_BUTTON)}
          </a>
          <p class="text-sm text-ink-muted">
            {i18n._(DOWNLOAD_REQUIREMENT)}
            <span aria-hidden="true" class="mx-1">·</span>
            <a
              href={downloadHref("/download/mac-intel", locale)}
              aria-label={i18n._(DOWNLOAD_INTEL_LABEL)}
              class="rounded-xs text-ink-secondary underline decoration-edge-strong underline-offset-4 hoverable:hover:text-ink hoverable:hover:decoration-current"
            >
              {i18n._(DOWNLOAD_INTEL)}
            </a>
          </p>
        </div>
      </section>

      <section class="mt-14 w-full max-w-[880px] pt-2 text-start">
        <h2 class="sr-only">{i18n._(DOWNLOAD_STEPS_HEADING)}</h2>
        <ol class="grid gap-8 @2xl:grid-cols-3">
          {
            DOWNLOAD_STEPS.map((step, index) => (
              <li class="flex gap-3">
                <span
                  aria-hidden="true"
                  class="grid size-7 shrink-0 place-items-center rounded-full bg-plate-nested text-sm font-medium tabular-nums text-ink-secondary edge"
                >
                  {index + 1}
                </span>
                <div>
                  <h3 class="text-base font-medium text-ink">{i18n._(step.title)}</h3>
                  <p class="mt-1 text-sm text-pretty text-ink-secondary">{i18n._(step.body)}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </section>
    </main>

    <PageFooter locale={locale} page="download" />
  </div>
</BaseLayout>

---
import { Download } from "lucide-react";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { pageI18n } from "../../lib/i18n";
import { type Locale, localizedPath } from "../../lib/routes";
import { buttonClass } from "../Button";
import SiteHeader from "../islands/SiteHeader";
import { PageFooter } from "../PageFooter";
import {
  DOWNLOAD_BUTTON,
  DOWNLOAD_DESCRIPTION,
  DOWNLOAD_FIGURE_ALT,
  DOWNLOAD_HEADING,
  DOWNLOAD_INTEL,
  DOWNLOAD_INTEL_LABEL,
  DOWNLOAD_LEDE,
  DOWNLOAD_REQUIREMENT,
  DOWNLOAD_SKIP,
  DOWNLOAD_TITLE,
} from "./download-copy";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const i18n = pageI18n(locale);
---

<BaseLayout
  title={i18n._(DOWNLOAD_TITLE)}
  description={i18n._(DOWNLOAD_DESCRIPTION)}
  canonicalPath={localizedPath("download", locale)}
  localizedPage="download"
>
  <div class="@container min-h-dvh overflow-x-clip bg-canvas text-text">
    <a
      href="#download"
      class="sr-only rounded-sm bg-plate px-3 py-2 text-base text-text edge focus:not-sr-only focus:absolute focus:start-3 focus:top-3 focus:z-(--z-tooltip)"
    >
      {i18n._(DOWNLOAD_SKIP)}
    </a>
    <header>
      <SiteHeader client:load locale={locale} />
    </header>

    <main
      class="mx-auto grid max-w-[1040px] items-center gap-x-16 gap-y-14 px-5 pt-12 pb-20 @2xl:px-10 @4xl:grid-cols-[minmax(0,5fr)_minmax(0,6fr)] @4xl:pt-20 @4xl:pb-28"
    >
      <div>
        <img src="/mac/icon.png" width="128" height="128" alt="" class="-ms-3 size-24 @2xl:size-32 @2xl:-ms-4" />
        <h1 class="mt-4 text-5xl font-medium tracking-[-0.038em] text-balance text-text @4xl:text-[4.25rem] @4xl:leading-[0.98]">
          {i18n._(DOWNLOAD_HEADING)}
        </h1>
        <p class="mt-5 max-w-[40ch] text-lg text-pretty text-text-2 @2xl:text-xl">{i18n._(DOWNLOAD_LEDE)}</p>
        <div id="download" class="mt-9 flex flex-col items-start gap-3">
          <a href="/download/mac" class={buttonClass("primary", "lg")}>
            <Download aria-hidden="true" data-icon="inline-start" />
            {i18n._(DOWNLOAD_BUTTON)}
          </a>
          <p class="text-sm text-muted">
            {i18n._(DOWNLOAD_REQUIREMENT)}
            <span aria-hidden="true" class="mx-1">·</span>
            <a
              href="/download/mac-intel"
              aria-label={i18n._(DOWNLOAD_INTEL_LABEL)}
              class="rounded-xs text-text-2 underline decoration-edge-2 underline-offset-4 hoverable:hover:text-text hoverable:hover:decoration-current"
            >
              {i18n._(DOWNLOAD_INTEL)}
            </a>
          </p>
        </div>
      </div>

      <figure class="mac-scene changelog-figure rounded-2xl" data-hue="4">
        <div class="mac-menubar" aria-hidden="true">
          <svg viewBox="12.5 12.5 95 95" class="size-4" fill="currentColor">
            <path d="M40.5 48 A19.5 30 0 0 1 79.5 48" fill="none" stroke="currentColor" stroke-width="7" stroke-linecap="round" />
            <rect x="33" y="50" width="7" height="46" rx="3.5" />
            <rect x="80" y="50" width="7" height="46" rx="3.5" />
            <path d="M50 36 H70 L87 51 H33 Z" stroke="currentColor" stroke-width="4" stroke-linejoin="round" />
            <path
              d="M60 58 C66.5 64.5 73.8 73 73.8 84 C73.8 90.9 67.62 96.5 60 96.5 C52.38 96.5 46.2 90.9 46.2 84 C46.2 73 53.5 64.5 60 58 Z M60 71.25 C63.25 74.5 66.9 78.75 66.9 84.25 C66.9 87.7 63.81 90.5 60 90.5 C56.19 90.5 53.1 87.7 53.1 84.25 C53.1 78.75 56.75 74.5 60 71.25 Z"
              fill-rule="evenodd"
            />
            <rect x="30" y="91" width="60" height="10" rx="5" />
            <rect x="38" y="101" width="44" height="6" rx="3" />
          </svg>
          <span class="tabular-nums">09:41</span>
        </div>
        {
          (["light", "dark"] as const).map((theme) => (
            <img
              src={`/mac/quick-add-${theme}.png`}
              width="480"
              height="56"
              alt={i18n._(DOWNLOAD_FIGURE_ALT)}
              decoding="async"
              class="mac-panel"
              data-theme-shot={theme}
            />
          ))
        }
      </figure>
    </main>

    <PageFooter locale={locale} page="download" />
  </div>
</BaseLayout>

---
import MarketingLayout from "../../layouts/MarketingLayout.astro";
import { LANGUAGE_PAGES } from "../../lib/language-pages";
import type { LanguageDecksPage } from "../../lib/public-catalog";
import LanguageView from "../islands/LanguageView";

interface Props {
  page: LanguageDecksPage;
}

const { locale, language, decks } = Astro.props.page;
const { page, title, blurb } = LANGUAGE_PAGES[language];
---

<MarketingLayout page={page} title={title} blurb={blurb} locale={locale}>
  <LanguageView client:load language={language} locale={locale} decks={decks} />
</MarketingLayout>

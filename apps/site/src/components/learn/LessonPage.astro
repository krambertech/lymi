---
import LearnLessonPage from "../islands/LearnLessonPage";
import { SHARE_IMAGE_ALT } from "../landing/LandingView";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { LESSON_PAGE_TITLE, lessonBySlug, lessonPath } from "../../lib/learn/catalogue";
import { learnI18n } from "../../lib/learn/i18n";
import { isPrelaunch, type Locale } from "../../lib/routes";
import { prepareLearnPage } from "./learn-page";

interface Props {
  locale: Locale;
  slug: string;
}

const { locale, slug } = Astro.props;
const lesson = lessonBySlug(slug);
if (!lesson?.blurb) throw new Error(`No lesson page for ${slug}`);
await prepareLearnPage({ kind: "lesson", slug }, locale);
const i18n = await learnI18n(locale);
const title = `${i18n._({ ...LESSON_PAGE_TITLE, values: { title: i18n._(lesson.title) } })} · Lymi`;
const alternatePaths = { en: lessonPath(slug, "en"), uk: lessonPath(slug, "uk"), ru: lessonPath(slug, "ru") };
---

<BaseLayout
  title={title}
  description={i18n._(lesson.blurb)}
  canonicalPath={lessonPath(slug, locale)}
  alternatePaths={alternatePaths}
  noindex={isPrelaunch("learn")}
  shareImageAlt={i18n._(SHARE_IMAGE_ALT)}
>
  <LearnLessonPage client:load locale={locale} slug={slug} />
</BaseLayout>

---
import onestLatin from "@fontsource-variable/onest/files/onest-latin-wght-normal.woff2?url";
import onestCyrillic from "@fontsource-variable/onest/files/onest-cyrillic-wght-normal.woff2?url";
import "../styles.css";

interface Props {
  title: string;
  description: string;
  canonicalPath: string;
  localizedPage?: "landing" | "join" | undefined;
  shareImageAlt?: string | undefined;
}

const { title, description, canonicalPath, localizedPage, shareImageAlt = "The Lymi lantern and wordmark above the line “Keep what you learn.”" } = Astro.props;
const site = Astro.site ?? "https://lymi.app";
const canonical = new URL(canonicalPath, site).toString();
// Rendered by scripts/icons.sh from the brand geometry.
const shareImage = new URL("/share.png", site).toString();
const locale = Astro.currentLocale ?? "en";
const localizedPath = (language: "en" | "uk" | "ru") => {
  const page = localizedPage === "join" ? "join" : "";
  return language === "en" ? `/${page}` : `/${language}/${page}`;
};
---

<!doctype html>
<html lang={Astro.currentLocale ?? "en"} data-lymi-surface="public">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover, interactive-widget=resizes-content"
    />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {
      localizedPage && (
        <>
          <link rel="alternate" hreflang="en" href={new URL(localizedPath("en"), site)} />
          <link rel="alternate" hreflang="uk" href={new URL(localizedPath("uk"), site)} />
          <link rel="alternate" hreflang="ru" href={new URL(localizedPath("ru"), site)} />
          <link rel="alternate" hreflang="x-default" href={new URL(localizedPath("en"), site)} />
        </>
      )
    }
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={shareImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={shareImage} />
    <meta name="twitter:image:alt" content={shareImageAlt} />
    <meta name="theme-color" content="#f8f7f5" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#151210" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/icon.svg" type="image/svg+xml" />
    <link rel="preload" href={onestLatin} as="font" type="font/woff2" crossorigin />
    {locale !== "en" && <link rel="preload" href={onestCyrillic} as="font" type="font/woff2" crossorigin />}
    <script is:inline>
      try {
        var t = localStorage.getItem("lymi-theme");
        var dark =
          t === "dark" ||
          ((!t || t === "system") && matchMedia("(prefers-color-scheme: dark)").matches);
        document.documentElement.dataset.theme = dark ? "dark" : "light";
      } catch (e) {}
    </script>
    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>

---
import SiteHeader from "../components/islands/SiteHeader";
import BaseLayout from "./BaseLayout.astro";

interface Props {
  title: string;
  description: string;
  canonicalPath: string;
  heading: string;
  lead: string;
  updated: string;
}

const { title, description, canonicalPath, heading, lead, updated } = Astro.props;
---

<BaseLayout title={title} description={description} canonicalPath={canonicalPath}>
  <div class="min-h-dvh bg-canvas text-text">
    <a
      href="#document-content"
      class="sr-only rounded-sm bg-plate px-3 py-2 text-base text-text edge focus:not-sr-only focus:absolute focus:left-3 focus:top-3 focus:z-(--z-tooltip)"
    >
      Skip to the document
    </a>

    <header>
      <SiteHeader client:load />
    </header>

    <main id="document-content" class="mx-auto max-w-[44rem] px-5 py-12 @2xl:px-10 @2xl:py-16">
      <header class="mb-10 border-b border-edge pb-8">
        <h1 class="text-4xl font-medium tracking-[-0.03em] text-text @2xl:text-5xl">{heading}</h1>
        <p class="mt-5 text-lg text-text-2">{lead}</p>
        <p class="mt-4 text-sm text-muted">Last updated {updated}</p>
      </header>
      <article class="doc-prose">
        <slot />
      </article>
    </main>

    <footer class="border-t border-edge px-5 py-8 @2xl:px-10">
      <div class="mx-auto flex max-w-[1040px] flex-wrap items-center justify-between gap-4 text-sm text-muted">
        <p>© 2026 Krambertech OÜ</p>
        <nav aria-label="Policies" class="flex flex-wrap gap-5">
          <a href="/privacy" class="rounded-xs hoverable:hover:text-text">Privacy</a>
          <a href="/terms" class="rounded-xs hoverable:hover:text-text">Terms</a>
          <a href="/support" class="rounded-xs hoverable:hover:text-text">Support</a>
        </nav>
      </div>
    </footer>
  </div>
</BaseLayout>

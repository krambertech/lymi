msgid "<0>Lähme!</0> means let’s go, and <1>las ta tuleb</1>, let him come. Two short ways to suggest and allow."
msgstr "<0>Lähme!</0> means let’s go, and <1>las ta tuleb</1>, let him come. Two short ways to suggest and allow."

msgid "<0>Läksin</0> is the past. Next week is still to come: <1>lähen</1>."
msgstr "<0>Läksin</0> is the past. Next week is still to come: <1>lähen</1>."

msgid "<0>Lapsed</0> is plural, so the verb takes the form of <1>nad</1>: <2>õpivad</2>."
msgstr "<0>Lapsed</0> is plural, so the verb takes the form of <1>nad</1>: <2>õpivad</2>."

msgid "<0>Las nad</0>, or <1>las lapsed</1>: the present form for <2>nad</2>."
msgstr "<0>Las nad</0>, or <1>las lapsed</1>: the present form for <2>nad</2>."

msgid "<0>Las ta</0>: the present form for <1>ta</1>."
msgstr "<0>Las ta</0>: the present form for <1>ta</1>."

msgid "<0>Last</0> is the third form, so it comes after <1>lapse</1>."
msgstr "<0>Last</0> is the third form, so it comes after <1>lapse</1>."

msgid "<0>Laua peal</0> and <1>laual</1> say the same, and so do <2>kasti sees</2> and <3>kastis</3>."
msgstr "<0>Laua peal</0> and <1>laual</1> say the same, and so do <2>kasti sees</2> and <3>kastis</3>."

msgid "<0>Lugesin</0> is I read, I was reading and I did read: one simple past for all three. Time words such as <1>eile</1> and <2>eelmisel nädalal</2> say when."
msgstr "<0>Lugesin</0> is I read, I was reading and I did read: one simple past for all three. Time words such as <1>eile</1> and <2>eelmisel nädalal</2> say when."

msgid "<0>Ma ei käi</0> is now. Kati asked about yesterday."
msgstr "<0>Ma ei käi</0> is now. Kati asked about yesterday."

msgid "<0>Ma ei tea</0> is I don’t know. <1>Kuidas läheb?</1> asks how you are."
msgstr "<0>Ma ei tea</0> is I don’t know. <1>Kuidas läheb?</1> asks how you are."

msgid "<0>Ma käisin</0> says you went. To say you didn’t: <1>ma ei käinud</1>."
msgstr "<0>Ma käisin</0> says you went. To say you didn’t: <1>ma ei käinud</1>."

msgid "<0>Ma olen Tartus käinud</0> and <1>ma olin juba söönud</1>: how to build them, and when Estonian uses them instead of the simple past."
msgstr "<0>Ma olen Tartus käinud</0> and <1>ma olin juba söönud</1>: how to build them, and when Estonian uses them instead of the simple past."

msgid "<0>Ma tahan lugeda</0> is I want to read, and <1>Ma pean lugema</1> is I have to read. The first verb decides whether the second takes its <2>-da</2> or its <3>-ma</3> form."
msgstr "<0>Ma tahan lugeda</0> is I want to read, and <1>Ma pean lugema</1> is I have to read. The first verb decides whether the second takes its <2>-da</2> or its <3>-ma</3> form."

msgid "<0>Ma</0> takes <1>-n</1>: <2>elan</2>."
msgstr "<0>Ma</0> takes <1>-n</1>: <2>elan</2>."

msgid "<0>Ma</0> takes <1>-n</1>: <2>õpin</2>."
msgstr "<0>Ma</0> takes <1>-n</1>: <2>õpin</2>."

msgid "<0>Majas</0> means in the house: the second form with <1>-s</1>. The second form itself is <2>maja</2>."
msgstr "<0>Majas</0> means in the house: the second form with <1>-s</1>. The second form itself is <2>maja</2>."

msgid "<0>marginal cost</0> <1>= cost of 1 more</1>"
msgstr "<0>marginal cost</0> <1>= cost of 1 more</1>"

msgid "<0>Mari</0> finished Week 3"
msgstr "<0>Mari</0> finished Week 3"

msgid "<0>me</0> now, <1>sime</1> in the past."
msgstr "<0>me</0> now, <1>sime</1> in the past."

msgid "<0>Meeldib</0> for one thing"
msgstr "<0>Meeldib</0> for one thing"

msgid "<0>Meeldib</0> goes with one thing or a verb, <1>meeldivad</1> with more than one thing: <2>Mulle meeldib lugeda. Mulle meeldivad kassid.</2>"
msgstr "<0>Meeldib</0> goes with one thing or a verb, <1>meeldivad</1> with more than one thing: <2>Mulle meeldib lugeda. Mulle meeldivad kassid.</2>"

msgid "<0>Meeldib</0> or <1>meeldivad</1>"
msgstr "<0>Meeldib</0> or <1>meeldivad</1>"

msgid "<0>Meeldivad</0> for more than one"
msgstr "<0>Meeldivad</0> for more than one"

msgid "<0>Mexican Spanish</0>, <1>informal examples</1>."
msgstr "<0>Mexican Spanish</0>, <1>informal examples</1>."

msgid "<0>Mina</0> is I. To say my, use <1>minu</1>: <2>minu raamat</2>."
msgstr "<0>Mina</0> is I. To say my, use <1>minu</1>: <2>minu raamat</2>."

msgid "<0>Mina</0> takes <1>olen</1>: <2>Mina olen Andres</2>."
msgstr "<0>Mina</0> takes <1>olen</1>: <2>Mina olen Andres</2>."

msgid "<0>Mina</0>, <1>sina</1> and <2>nemad</2> change: <3>minu, sinu, nende</3>. <4>Tema</4>, <5>meie</5> and <6>teie</6> stay as they are."
msgstr "<0>Mina</0>, <1>sina</1> and <2>nemad</2> change: <3>minu, sinu, nende</3>. <4>Tema</4>, <5>meie</5> and <6>teie</6> stay as they are."

msgid "<0>Mine</0> tells one person to go. To go together: <1>lähme</1>."
msgstr "<0>Mine</0> tells one person to go. To go together: <1>lähme</1>."

msgid "<0>Minu</0> and <1>sinu</1> often shorten to <2/> and <3/>. <4>Tema</4>, <5>meie</5> and <6>teie</6> shorten to <7>ta, me</7> and <8>te</8>, the same short forms you met for he or she, we and you. Lesson {questions} used <9>su</9>: <10/> means “What’s your name?”"
msgstr "<0>Minu</0> and <1>sinu</1> often shorten to <2/> and <3/>. <4>Tema</4>, <5>meie</5> and <6>teie</6> shorten to <7>ta, me</7> and <8>te</8>, the same short forms you met for he or she, we and you. Lesson {questions} used <9>su</9>: <10/> means “What’s your name?”"

msgid "<0>Mul on vaja</0> is I need: <1>Mul on vaja abi.</1>"
msgstr "<0>Mul on vaja</0> is I need: <1>Mul on vaja abi.</1>"

msgid "<0>Mul on</0> and <1>mulle meeldib</1>"
msgstr "<0>Mul on</0> and <1>mulle meeldib</1>"

msgid "<0>Mulle meeldib</0> is I like. Lesson {liking} explains how it works."
msgstr "<0>Mulle meeldib</0> is I like. Lesson {liking} explains how it works."

msgid "<0>Mulle meeldib</0> or <1>mulle meeldivad</1>?"
msgstr "<0>Mulle meeldib</0> or <1>mulle meeldivad</1>?"

msgid "<0>n</0> now, <1>sin</1> in the past."
msgstr "<0>n</0> now, <1>sin</1> in the past."

msgid "<0>Nad käivad</0> is they go, now. Kati asked about you, yesterday."
msgstr "<0>Nad käivad</0> is they go, now. Kati asked about you, yesterday."

msgid "<0>Nad on</0> is they are, now. Kati asked what you did yesterday."
msgstr "<0>Nad on</0> is they are, now. Kati asked what you did yesterday."

msgid "<0>Nad ostavad</0> is they buy, now. Kati asked what you bought."
msgstr "<0>Nad ostavad</0> is they buy, now. Kati asked what you bought."

msgid "<0>Nende</0> is their. For you and Martin, say <1>meie</1>, our."
msgstr "<0>Nende</0> is their. For you and Martin, say <1>meie</1>, our."

msgid "<0>Olen</0> for I, <1>oled</1> for you, <2>on</2> for he or she and for they."
msgstr "<0>Olen</0> for I, <1>oled</1> for you, <2>on</2> for he or she and for they."

msgid "<0>Olin</0> is for before another past moment. Kati asks about your life up to now: <1>olen</1>."
msgstr "<0>Olin</0> is for before another past moment. Kati asks about your life up to now: <1>olen</1>."

msgid "<0>On</0> is both he or she is and they are. Only the pronoun tells them apart."
msgstr "<0>On</0> is both he or she is and they are. Only the pronoun tells them apart."

msgid "<0>Oo</0> turns into <1>õ</1>, then <2>in</2>."
msgstr "<0>Oo</0> turns into <1>õ</1>, then <2>in</2>."

msgid "<0>Öö</0> turns into <1>õ</1>, then <2>in</2>."
msgstr "<0>Öö</0> turns into <1>õ</1>, then <2>in</2>."

msgid "<0>opportunity cost</0> <1>= what you give up</1>"
msgstr "<0>opportunity cost</0> <1>= what you give up</1>"

msgid "<0>Oskan</0> is for what you learned: <1>Ma oskan ujuda.</1> <2>Saan</2> says nothing stops you: <3>Ma saan homme tulla.</3>"
msgstr "<0>Oskan</0> is for what you learned: <1>Ma oskan ujuda.</1> <2>Saan</2> says nothing stops you: <3>Ma saan homme tulla.</3>"

msgid "<0>Oskan</0>: you learned how."
msgstr "<0>Oskan</0>: you learned how."

msgid "<0>Osmosis</0>: water crosses a membrane toward more dissolved substance."
msgstr "<0>Osmosis</0>: water crosses a membrane toward more dissolved substance."

msgid "<0>Ostsid</0> is for <1>sa</1> or <2>nad</2>. With <3>ma</3>, it’s <4>ostsin</4>."
msgstr "<0>Ostsid</0> is for <1>sa</1> or <2>nad</2>. With <3>ma</3>, it’s <4>ostsin</4>."

msgid "<0>P suletud</0> on a sign: closed on Sunday."
msgstr "<0>P suletud</0> on a sign: closed on Sunday."

msgid "<0>Pärnus</0> says in Pärnu. <1>Pärit</1> takes the form for where from: <2>Pärnust</2>."
msgstr "<0>Pärnus</0> says in Pärnu. <1>Pärit</1> takes the form for where from: <2>Pärnust</2>."

msgid "<0>Pärnusse</0> says to Pärnu. <1>Pärit</1> takes the form for where from: <2>Pärnust</2>."
msgstr "<0>Pärnusse</0> says to Pärnu. <1>Pärit</1> takes the form for where from: <2>Pärnust</2>."

msgid "<0>Pean, hakkan, lähen, tule</0> and <1>jään</1> take the <2>-ma</2> form."
msgstr "<0>Pean, hakkan, lähen, tule</0> and <1>jään</1> take the <2>-ma</2> form."

msgid "<0>Pean</0> is I have to. <1>Tuleb</1> with the <2>-da</2> form says it has to be done, naming no one. <3>Mul on vaja</3> is I need to."
msgstr "<0>Pean</0> is I have to. <1>Tuleb</1> with the <2>-da</2> form says it has to be done, naming no one. <3>Mul on vaja</3> is I need to."

msgid "<0>Pean</0> says you have to come. Nobody makes you; you’re free."
msgstr "<0>Pean</0> says you have to come. Nobody makes you; you’re free."

msgid "<0>Poe</0> is the second form. The third has the <1>d</1> back: <2>poodi</2>."
msgstr "<0>Poe</0> is the second form. The third has the <1>d</1> back: <2>poodi</2>."

msgid "<0>Poes</0> says where you are. After <1>lähen</1>, say where to: <2>poodi</2>."
msgstr "<0>Poes</0> says where you are. After <1>lähen</1>, say where to: <2>poodi</2>."

msgid "<0>Poes</0> says you’re in the shop. She asked where you’re going."
msgstr "<0>Poes</0> says you’re in the shop. She asked where you’re going."

msgid "<0>Pole</0> means the same as <1>ei ole</1>. You’ll hear both."
msgstr "<0>Pole</0> means the same as <1>ei ole</1>. You’ll hear both."

msgid "<0>Pood</0> loses its d, and the second o turns to e: <1>poe</1>. <2>Turg</2> and <3>laud</3> drop their last letter and gain a vowel: <4>turu, laua</4>."
msgstr "<0>Pood</0> loses its d, and the second o turns to e: <1>poe</1>. <2>Turg</2> and <3>laud</3> drop their last letter and gain a vowel: <4>turu, laua</4>."

msgid "<0>Pool</0>, <1>veerand</1> and <2>kolmveerand</2> name the hour that’s coming: <3>pool neli</3> is 3:30."
msgstr "<0>Pool</0>, <1>veerand</1> and <2>kolmveerand</2> name the hour that’s coming: <3>pool neli</3> is 3:30."

msgid "<0>Praegu</0>, right now: still eating, so the third form."
msgstr "<0>Praegu</0>, right now: still eating, so the third form."

msgid "<0>Praegu</0>, right now: still reading, so the third form."
msgstr "<0>Praegu</0>, right now: still reading, so the third form."

msgid "<0>price elasticity</0> ?"
msgstr "<0>price elasticity</0> ?"

msgid "<0>Sa oled</0> is you are: this tells Mari she’s from Ukraine."
msgstr "<0>Sa oled</0> is you are: this tells Mari she’s from Ukraine."

msgid "<0>Sa</0> takes <1>-d</1>: <2>töötad</2>."
msgstr "<0>Sa</0> takes <1>-d</1>: <2>töötad</2>."

msgid "<0>Sa</0> takes <1>oled</1>, not <2>on</2>."
msgstr "<0>Sa</0> takes <1>oled</1>, not <2>on</2>."

msgid "<0>Saan</0>: nothing stops you, not time, place or health."
msgstr "<0>Saan</0>: nothing stops you, not time, place or health."

msgid "<0>Sada</0> and <1>tuhat</1> need no “one”. Hundreds join up; thousands stay separate."
msgstr "<0>Sada</0> and <1>tuhat</1> need no “one”. Hundreds join up; thousands stay separate."

msgid "<0>Sain</0> is the past. To ask politely: <1>kas ma saaksin</1>."
msgstr "<0>Sain</0> is the past. To ask politely: <1>kas ma saaksin</1>."

msgid "<0>sin</0> when it happened; no ending after <1>ei</1>."
msgstr "<0>sin</0> when it happened; no ending after <1>ei</1>."

msgid "<0>Sinu</0> is your: that says the coffee is Mari’s."
msgstr "<0>Sinu</0> is your: that says the coffee is Mari’s."

msgid "<0>Sinu</0> is your: this says “Your name is Andres.”"
msgstr "<0>Sinu</0> is your: this says “Your name is Andres.”"

msgid "<0>Sklep</0> is a shop, not a crypt, and <1>dynia</1> is a pumpkin, not a melon. The ready-made decks say in a card’s notes where a Polish word only looks like yours, and AI writes the same note for the words you add."
msgstr "<0>Sklep</0> is a shop, not a crypt, and <1>dynia</1> is a pumpkin, not a melon. The ready-made decks say in a card’s notes where a Polish word only looks like yours, and AI writes the same note for the words you add."

msgid "<0>Sõber</0> sounds like “sober”: the friend who gets you home."
msgstr "<0>Sõber</0> sounds like “sober”: the friend who gets you home."

msgid "<0>Sõin</0> is the past, and the cake has only just come. With <1>ära</1>, the genitive: <2>koogi</2>."
msgstr "<0>Sõin</0> is the past, and the cake has only just come. With <1>ära</1>, the genitive: <2>koogi</2>."

msgid "<0>Sõnaveeb</0>, the free dictionary of the Institute of the Estonian Language, lists them under <1>Sõnavormid</1>, word forms. Search for a word and scroll to that table: its left column holds the three forms, top to bottom. The right column is the plural."
msgstr "<0>Sõnaveeb</0>, the free dictionary of the Institute of the Estonian Language, lists them under <1>Sõnavormid</1>, word forms. Search for a word and scroll to that table: its left column holds the three forms, top to bottom. The right column is the plural."

msgid "<0>Söö</0> tells one person to eat. To eat together: <1>sööme</1>."
msgstr "<0>Söö</0> tells one person to eat. To eat together: <1>sööme</1>."

msgid "<0>Sööma</0> and <1>jooma</1> break the pattern. Their commands build on the I form: <2>söön, sööge</2>; <3>joon, jooge</3>."
msgstr "<0>Sööma</0> and <1>jooma</1> break the pattern. Their commands build on the I form: <2>söön, sööge</2>; <3>joon, jooge</3>."

msgid "<0>Suured</0> ends in <1>-d</1>, so there is more than one room: <2>toad</2>."
msgstr "<0>Suured</0> ends in <1>-d</1>, so there is more than one room: <2>toad</2>."

msgid "<0>Ta</0> adds nothing after the i."
msgstr "<0>Ta</0> adds nothing after the i."

msgid "<0>Ta</0> drops the i: <1>läks</1>."
msgstr "<0>Ta</0> drops the i: <1>läks</1>."

msgid "<0>ta</0> gives way to <1>nud</1>, and the d stays: <2>oodanud</2>."
msgstr "<0>ta</0> gives way to <1>nud</1>, and the d stays: <2>oodanud</2>."

msgid "<0>Ta</0> is both he and she. <1>Te</1> is you, to more than one, and polite you to one person."
msgstr "<0>Ta</0> is both he and she. <1>Te</1> is you, to more than one, and polite you to one person."

msgid "<0>Ta</0> is one cat, so the adjective has no <1>-d</1>, like <2>ilus</2>."
msgstr "<0>Ta</0> is one cat, so the adjective has no <1>-d</1>, like <2>ilus</2>."

msgid "<0>Tahan, võin, saan, oskan, tohin, proovin, armastan</0> and <1>mulle meeldib</1> take the <2>-da</2> form."
msgstr "<0>Tahan, võin, saan, oskan, tohin, proovin, armastan</0> and <1>mulle meeldib</1> take the <2>-da</2> form."

msgid "<0>Täna</0>, <1>homme</1>, <2>eile</2>: today, tomorrow, yesterday. <3>Üle-</3> goes one day further."
msgstr "<0>Täna</0>, <1>homme</1>, <2>eile</2>: today, tomorrow, yesterday. <3>Üle-</3> goes one day further."

msgid "<0>Tartu</0> and <1>haigla</1> stay as they are, and <2>-s</2> or <3>-l</3> goes straight on."
msgstr "<0>Tartu</0> and <1>haigla</1> stay as they are, and <2>-s</2> or <3>-l</3> goes straight on."

msgid "<0>Tartust</0> says from Tartu. You’re going to Tartu: <1>Tartusse</1>."
msgstr "<0>Tartust</0> says from Tartu. You’re going to Tartu: <1>Tartusse</1>."

msgid "<0>te</0> now, <1>site</1> in the past."
msgstr "<0>te</0> now, <1>site</1> in the past."

msgid "<0>Teha, näha, süüa</0> and <1>juua</1> end in a bare <2>-a</2> and change their stem. Learn these four whole."
msgstr "<0>Teha, näha, süüa</0> and <1>juua</1> end in a bare <2>-a</2> and change their stem. Learn these four whole."

msgid "<0>Teie</0> is your. For you and Martin, say <1>meie</1>, our."
msgstr "<0>Teie</0> is your. For you and Martin, say <1>meie</1>, our."

msgid "<0>Tere</0> is hello, and Mari is leaving."
msgstr "<0>Tere</0> is hello, and Mari is leaving."

msgid "<0>Töötasin</0> is the past. For next weekend, the present: <1>ma töötan</1>."
msgstr "<0>Töötasin</0> is the past. For next weekend, the present: <1>ma töötan</1>."

msgid "<0>Töötasin</0> is the past. For tomorrow, the present: <1>töötan</1>."
msgstr "<0>Töötasin</0> is the past. For tomorrow, the present: <1>töötan</1>."

msgid "<0>Tule ka</0> tells Kati, the person you’re talking to, to come. About Jaan: <1>las ta tuleb</1>."
msgstr "<0>Tule ka</0> tells Kati, the person you’re talking to, to come. About Jaan: <1>las ta tuleb</1>."

msgid "<0>Tulema</0> again, as a command: come here to do it, so <1>-ma</1>."
msgstr "<0>Tulema</0> again, as a command: come here to do it, so <1>-ma</1>."

msgid "<0>Tulema</0> takes <1>-mast</1> or <2>-ma</2>: <3>Ma tulen ujumast. Tule sööma!</3>"
msgstr "<0>Tulema</0> takes <1>-mast</1> or <2>-ma</2>: <3>Ma tulen ujumast. Tule sööma!</3>"

msgid "<0>Ujuda</0> is a verb, and a verb takes <1>meeldib</1>."
msgstr "<0>Ujuda</0> is a verb, and a verb takes <1>meeldib</1>."

msgid "<0>vad</0> now, <1>sid</1> in the past, as for <2>sa</2>."
msgstr "<0>vad</0> now, <1>sid</1> in the past, as for <2>sa</2>."

msgid "<0>Veerand neli</0> is a quarter of the way to four, 3:15. <1>Kolmveerand neli</1> is three quarters, 3:45."
msgstr "<0>Veerand neli</0> is a quarter of the way to four, 3:15. <1>Kolmveerand neli</1> is three quarters, 3:45."

msgid "<0>Võin</0> and <1>tohin</1> both say it’s allowed; <2>võin</2> also offers: <3>Ma võin sind oodata.</3> <4>Tohin</4> is mostly heard with <5>ei</5>: <6>Siin ei tohi süüa.</6>"
msgstr "<0>Võin</0> and <1>tohin</1> both say it’s allowed; <2>võin</2> also offers: <3>Ma võin sind oodata.</3> <4>Tohin</4> is mostly heard with <5>ei</5>: <6>Siin ei tohi süüa.</6>"

msgid "<0>Võtsin</0> is the past, and one whole cake takes the genitive: <1>ma võtan ühe koogi</1>."
msgstr "<0>Võtsin</0> is the past, and one whole cake takes the genitive: <1>ma võtan ühe koogi</1>."

msgid "<0>Võtsin</0> is the past, I took. To order: <1>võtaksin</1>."
msgstr "<0>Võtsin</0> is the past, I took. To order: <1>võtaksin</1>."

msgid "<0>за́мок</0> is a castle."
msgstr "<0>за́мок</0> is a castle."

msgid "<0>はし</0> can mean chopsticks, a bridge or an edge. Only the pitch tells them apart. Lymi charts it under the word, so you learn how it’s said as well as how it’s read."
msgstr "<0>はし</0> can mean chopsticks, a bridge or an edge. Only the pitch tells them apart. Lymi charts it under the word, so you learn how it’s said as well as how it’s read."

msgid "<0>乗る</0> to get on, plus <1>換える</1> to swap: you get on a different train."
msgstr "<0>乗る</0> to get on, plus <1>換える</1> to swap: you get on a different train."

msgid "<0>换</0> to swap, <1>乘</1> to ride: you swap the line you ride."
msgstr "<0>换</0> to swap, <1>乘</1> to ride: you swap the line you ride."


msgid "<0>-l</0>, <1>-le</1> and <2>-lt</2> on a person usually express having, giving, calling or receiving."
msgstr "<0>-l</0>, <1>-le</1> і <2>-lt</2> з людиною зазвичай передають володіння, давання, дзвінок або отримання."

msgid "<0>-l</0>, <1>-le</1> and <2>-lt</2> on a person usually mean having, giving or receiving: <3>Emal on aed</3>, <4>helistan emale</4>, <5>sain emalt kirja</5>."
msgstr "<0>-l</0>, <1>-le</1> і <2>-lt</2> з людиною зазвичай означають «має», «кому» або «від кого»: <3>Emal on aed</3>, <4>helistan emale</4>, <5>sain emalt kirja</5>."

#. placeholder {0}: item.said
#. placeholder {1}: i18n._(TELL_MEANS[item.id])
msgid "<0>{0}</0> {1}"
msgstr "<0>{0}</0> — {1}"

msgid "<et>-l, -le, -lt</et> on a person usually express having, giving or receiving: <et>Emal on aed</et>, <et>helistan sõbrale</et>, <et>sain õelt kirja</et>."
msgstr "<et>-l, -le, -lt</et> з людиною зазвичай передають володіння, давання або отримання: <et>Emal on aed</et>, <et>helistan sõbrale</et>, <et>sain õelt kirja</et>."

msgid "20 minutes"
msgstr "20 хвилин"

msgid "7 exercises"
msgstr "7 вправ"

msgid "a friend has"
msgstr "у друга є"

msgid "All eight forms right."
msgstr "Усі вісім форм правильно."

msgid "All eight right."
msgstr "Усі вісім правильно."

msgid "All six found and fixed."
msgstr "Усі шість знайдено й виправлено."

msgid "All six sentences right."
msgstr "Усі шість речень правильно."

msgid "Annual eye test"
msgstr "Перевірка зору"

msgid "at a friend’s place"
msgstr "у друга вдома"

msgid "At her grandmother’s"
msgstr "Вдома в бабусі"

msgid "At his parents’ house"
msgstr "У батьків удома"

msgid "at mother’s place"
msgstr "у мами вдома"

msgid "at my place"
msgstr "у мене вдома"

msgid "At someone’s place"
msgstr "У когось удома"

msgid "at someone’s place, by"
msgstr "у когось удома, біля"

msgid "At someone’s place: <et>juures, juurde, juurest</et>"
msgstr "У когось удома: <et>juures, juurde, juurest</et>"

msgid "at the doctor’s"
msgstr "у лікаря"

msgid "At their place"
msgstr "У них удома"

msgid "At work"
msgstr "На роботі"

msgid "At, to or from their place"
msgstr "У когось, до когось або від когось"

msgid "Before <0>juurde</0>, pronouns take the genitive <1>minu</1>: <2>minu juurde</2>."
msgstr "Перед <0>juurde</0> займенники стоять у родовому відмінку <1>minu</1>: <2>minu juurde</2>."

msgid "Before <0>juurde</0>, the noun takes the genitive <1>ema</1>, not <2>emale</2>."
msgstr "Перед <0>juurde</0> іменник стоїть у родовому <1>ema</1>, а не <2>emale</2>."

msgid "Before <0>juurde</0>, use the genitive <1>minu</1>, not <2>mul</2>."
msgstr "Перед <0>juurde</0> вживай родовий <1>minu</1>, а не <2>mul</2>."

msgid "Before <0>juures</0>, the noun takes the genitive <1>sõbra</1>, not <2>sõbrale</2>."
msgstr "Перед <0>juures</0> іменник стоїть у родовому <1>sõbra</1>, а не <2>sõbrale</2>."

msgid "Before <et>juures, juurde</et> and <et>juurest</et>, nouns and pronouns take the genitive: <et>ema juures, sõbra juurde, minu juurde</et>."
msgstr "Перед <et>juures, juurde</et> і <et>juurest</et> іменники та займенники стоять у родовому: <et>ema juures, sõbra juurde, minu juurde</et>."

msgid "Being at someone’s place takes <0>juures</0>, not <1>juurde</1>."
msgstr "Перебування в когось потребує <0>juures</0>, а не <1>juurde</1>."

msgid "Being at, going to or coming from a person’s place usually uses the genitive plus <0>juures</0>, <1>juurde</1> or <2>juurest</2>."
msgstr "Щоб сказати «у когось», «до когось» або «від когось», зазвичай вживають родовий плюс <0>juures</0>, <1>juurde</1> або <2>juurest</2>."

msgid "Being at, going to or coming from a person’s place usually uses the genitive plus <et>juures, juurde, juurest</et>."
msgstr "Для місця в людини зазвичай вживають родовий плюс <et>juures, juurde, juurest</et>."

msgid "Being at, going to or coming from someone’s place usually uses the genitive plus <0>juures</0> (at), <1>juurde</1> (to) or <2>juurest</2> (from): <3>ema juures</3>, <4>arsti juurde</4>, <5>sõbra juurest</5>."
msgstr "Перебування чи рух до когось або від когось зазвичай виражають родовим плюс <0>juures</0> (у), <1>juurde</1> (до) або <2>juurest</2> (від): <3>ema juures</3>, <4>arsti juurde</4>, <5>sõbra juurest</5>."

msgid "brother has"
msgstr "у брата є"

msgid "Calling after the doctor’s visit"
msgstr "Дзвінок після візиту до лікаря"

msgid "Calling someone uses <0>-le</0> on the genitive <1>sõbra</1>: <2>sõbrale</2>."
msgstr "Коли телефонуєш комусь, до родового <1>sõbra</1> додається <0>-le</0>: <2>sõbrale</2>."

msgid "Check the table above, then try again."
msgstr "Переглянь таблицю вище й спробуй ще раз."

msgid "Come to my place in the evening!"
msgstr "Приходь увечері до мене!"

msgid "Coming from a person’s place takes the genitive plus <0>juurest</0>: <1>sõbra juurest</1>."
msgstr "Рух від когось бере родовий плюс <0>juurest</0>: <1>sõbra juurest</1>."

msgid "Coming from someone’s place takes <0>juurest</0>, not <1>juures</1>."
msgstr "Рух від когось потребує <0>juurest</0>, а не <1>juures</1>."

msgid "Complete the sentence"
msgstr "Доповни речення"

msgid "Each sentence has one wrong word: either the wrong direction or the wrong case before <0>juures</0> or <1>juurde</1>. Tap the wrong word, then type the right one."
msgstr "У кожному реченні одне слово помилкове: неправильний напрямок або відмінок перед <0>juures</0> чи <1>juurde</1>. Натисни на помилкове слово й впиши правильне."

msgid "Emal on väike aed."
msgstr "Emal on väike aed."

msgid "Estonian"
msgstr "Естонська"

msgid "Fix the sentence"
msgstr "Виправ речення"

msgid "For a quick check on his injured knee"
msgstr "Швидко перевірити ушкоджене коліно"

msgid "Form"
msgstr "Форма"

msgid "friend’s (genitive)"
msgstr "друга (родовий)"

msgid "From (receiving, asking)"
msgstr "Від кого (отримати, спитати)"

msgid "from a friend"
msgstr "від друга"

msgid "from a friend’s place"
msgstr "від друга (звідки)"

msgid "from mother"
msgstr "від мами"

msgid "from mother (getting, asking)"
msgstr "від мами (отримати, спитати)"

msgid "from mother’s place"
msgstr "від мами (звідки)"

msgid "from sister (getting)"
msgstr "від сестри (отримати)"

msgid "from someone’s place"
msgstr "від когось (звідки)"

msgid "from the doctor’s"
msgstr "від лікаря"

msgid "From their place"
msgstr "Від них"

msgid "Genitive before <et>juures</et>"
msgstr "Родовий перед <et>juures</et>"

msgid "Getting something from someone uses <0>-lt</0> on the genitive <1>õe</1>: <2>õelt</2>."
msgstr "Отримання чогось від людини бере <0>-lt</0> до родового <1>õe</1>: <2>õelt</2>."

msgid "Go through the table once more, then try again."
msgstr "Переглянь таблицю ще раз і спробуй знову."

msgid "Going to a person takes the genitive plus <0>juurde</0>: <1>arsti juurde</1>."
msgstr "Рух до людини бере родовий плюс <0>juurde</0>: <1>arsti juurde</1>."

msgid "Going to someone takes <0>juurde</0>, not <1>juures</1>."
msgstr "Рух до когось потребує <0>juurde</0>, а не <1>juures</1>."

msgid "Has / with"
msgstr "У кого є"

msgid "Having and giving: <et>-l, -le, -lt</et>"
msgstr "Володіння і давання: <et>-l, -le, -lt</et>"

msgid "Having or at their place?"
msgstr "Має чи перебуває в гостях?"

msgid "Having or giving"
msgstr "Володіння або давання"

msgid "Having or staying?"
msgstr "Має чи гостює?"

msgid "Having versus being at someone’s place"
msgstr "«У когось є» проти «у когось удома»"

msgid "Having, giving or getting"
msgstr "Володіння, давання чи отримання"

msgid "He or she is at a friend’s place today."
msgstr "Він чи вона сьогодні в друга."

msgid "He or she just came from a friend’s place."
msgstr "Він чи вона щойно прийшли від друга."

msgid "Hear each sentence and decide whether it is about having, giving or getting, or about being at, going to or coming from someone’s place."
msgstr "Послухай кожне речення й визнач: ідеться про володіння, давання чи отримання, чи про перебування в когось, похід до когось або повернення від когось."

msgid "Her grandmother"
msgstr "Бабуся Каті"

msgid "Her uncle"
msgstr "Дядько"

msgid "Her younger sister from university"
msgstr "Її молодша сестра з університету"

msgid "I am at my mother’s place today."
msgstr "Сьогодні я в мами."

msgid "I am calling a friend."
msgstr "Я телефоную другові."

msgid "I am coming from the doctor’s."
msgstr "Я йду від лікаря."

msgid "I am going to a friend’s place in the evening."
msgstr "Увечері я йду до друга."

msgid "I am going to my mother’s place tomorrow."
msgstr "Завтра я йду до мами."

msgid "I am going to the doctor tomorrow."
msgstr "Завтра я йду до лікаря."

msgid "I gave the key to my brother."
msgstr "Я віддав ключ братові."

msgid "I got a letter from my sister."
msgstr "Я отримав листа від сестри."

msgid "I got a prescription from the doctor."
msgstr "Я отримав рецепт від лікаря."

msgid "I went to my brother’s place yesterday."
msgstr "Учора я ходив до брата."

msgid "In a sentence"
msgstr "У реченні"

msgid "In lesson {having} you saw <0/> for what mother has: <1>Emal on auto</1>. In the same way, <2/> means to mother (giving or calling) and <3/> means from mother (receiving or asking)."
msgstr "В уроці {having} ти бачив <0/>, коли йдеться про те, що має мама: <1>Emal on auto</1>. Так само <2/> означає «мамі» (дати чи зателефонувати), а <3/> — «від мами» (отримати чи запитати)."

msgid "Inside a small wooden inn beside the harbour"
msgstr "У маленькому дерев’яному готелі біля порту"

msgid "Kati"
msgstr "Каті"

msgid "Kati calls Mart to see how he is doing after his doctor’s visit. Listen and answer. You can play the conversation twice."
msgstr "Каті телефонує Марту, щоб дізнатися, як його справи після візиту до лікаря. Послухай і дай відповіді. Розмову можна прослухати двічі."

msgid "Kati plans to stay at her grandmother’s until Monday afternoon."
msgstr "Каті планує залишитися в бабусі до понеділка по обіді."

msgid "Kati sends Mart a message from her grandmother’s house. Read and answer."
msgstr "Каті надсилає Марту повідомлення з бабусиного дому. Прочитай і дай відповіді."

msgid "Kati writes"
msgstr "Каті пише"

msgid "Kati’s grandmother has a small apple orchard behind her house."
msgstr "За будинком у бабусі Каті є невеликий яблуневий сад."

msgid "Late next Wednesday night after her train arrives"
msgstr "Пізно наступної середи ввечері після прибуття потяга"

msgid "Listen: Kati and Mart"
msgstr "Послухай: Каті і Март"

msgid "Listening only, no microphone"
msgstr "Лише аудіювання, без мікрофона"

msgid "Ma helistan emale."
msgstr "Ma helistan emale."

msgid "Ma lähen homme arsti juurde."
msgstr "Ma lähen homme arsti juurde."

msgid "Ma olen täna ema juures."
msgstr "Ma olen täna ema juures."

msgid "Ma sain emalt kirja."
msgstr "Ma sain emalt kirja."

msgid "Make the form"
msgstr "Утвори форму"

msgid "Mart"
msgstr "Март"

msgid "Mart went to the doctor this morning."
msgstr "Сьогодні вранці Март ходив до лікаря."

msgid "Mart’s sister brought him fresh bread from the bakery."
msgstr "Сестра Марта принесла свіжий хліб із пекарні."

msgid "Match each Estonian phrase with what it means."
msgstr "З’єднай кожну естонську фразу з її значенням."

msgid "Meaning"
msgstr "Значення"

msgid "mother has"
msgstr "у мами є"

msgid "Mother has a small garden."
msgstr "У мами невеликий сад."

msgid "my"
msgstr "мій"

msgid "Nearly. Check the genitive and place word in the ones you missed."
msgstr "Майже. Перевір родовий відмінок і слово місця в реченнях із помилками."

msgid "Nearly. Check whether the sentence is about having or a place."
msgstr "Майже. Перевір, чи йдеться про володіння, чи про місце."

msgid "Nearly. Play the ones you missed once more."
msgstr "Майже. Послухай ще раз ті речення, де були помилки."

msgid "Nearly. Read the reason under each one you missed."
msgstr "Майже. Прочитай пояснення під кожним помилковим реченням."

msgid "On Saturday"
msgstr "У суботу"

msgid "Person endings and place words"
msgstr "Закінчення з людьми та слова місця"

msgid "Pronouns work the same way: <0>Mul on aega</0> (I have time), but <1>Tule minu juurde</1> (Come to my place). With <2>arst</2>, you will also hear <3>käisin arstil</3> in everyday speech, though <4>arsti juures</4> always works."
msgstr "Займенники працюють так само: <0>Mul on aega</0> («У мене є час»), але <1>Tule minu juurde</1> («Приходь до мене»). Зі словом <2>arst</2> у розмовній мові також кажуть <3>käisin arstil</3>, хоча <4>arsti juures</4> завжди правильне."

msgid "Read What to remember below, then try again."
msgstr "Прочитай «Що запам’ятати» нижче й спробуй ще раз."

msgid "Saying someone has a free day uses <0>-l</0> on <1>venna</1>: <2>Vennal on</2>."
msgstr "Коли в когось вихідний, до <1>venna</1> додається <0>-l</0>: <2>Vennal on</2>."

msgid "Saying someone has something uses <0>-l</0>: <1>Emal on</1>."
msgstr "Коли в когось щось є, додається <0>-l</0>: <1>Emal on</1>."

msgid "Sore throat"
msgstr "Біль у горлі"

msgid "Staying at a person’s place usually takes the genitive plus <0>juures</0>: <1>ema juures</1>."
msgstr "Перебування в когось удома зазвичай бере родовий плюс <0>juures</0>: <1>ema juures</1>."

msgid "Ta elab sel nädalal sõbra juures."
msgstr "Ta elab sel nädalal sõbra juures."

msgid "Ta tuli just sõbra juurest."
msgstr "Ta tuli just sõbra juurest."

msgid "Tap a form"
msgstr "Натисни на форму"

msgid "The doctor told Mart to go running again tomorrow."
msgstr "Лікар сказав Марту знову бігати вже завтра."

msgid "To (giving, calling)"
msgstr "Кому (дати, зателефонувати)"

msgid "to a friend"
msgstr "другові"

msgid "to a friend (calling)"
msgstr "другові (телефонувати)"

msgid "to a friend’s place"
msgstr "до друга"

msgid "To borrow a warm jacket"
msgstr "Позичити теплу куртку"

msgid "To eat dinner"
msgstr "Повечеряти"

msgid "to mother"
msgstr "мамі"

msgid "to mother (giving, calling)"
msgstr "мамі (дати, зателефонувати)"

msgid "to mother’s place"
msgstr "до мами"

msgid "to my place"
msgstr "до мене"

msgid "To return the novel she borrowed last week"
msgstr "Повернути книжку, яку позичила минулого тижня"

msgid "To say you are physically at, going to or coming from someone’s place, Estonian usually uses the genitive from lesson {genitive} plus <0/> (<1>kus?</1>), <2/> (<3>kuhu?</3>) or <4/> (<5>kust?</5>): <6>Olen ema juures</6>, <7>Lähen arsti juurde</7>, <8>Tulen sõbra juurest</8>."
msgstr "Щоб сказати, що ти фізично в когось, ідеш до когось або повертаєшся від когось, естонська зазвичай бере родовий відмінок з уроку {genitive} плюс <0/> (<1>kus?</1>), <2/> (<3>kuhu?</3>) або <4/> (<5>kust?</5>): <6>Olen ema juures</6>, <7>Lähen arsti juurde</7>, <8>Tulen sõbra juurest</8>."

msgid "to someone’s place"
msgstr "до когось"

msgid "to the doctor"
msgstr "до лікаря"

msgid "To their place"
msgstr "До них"

msgid "Tomorrow afternoon around four"
msgstr "Завтра вдень близько четвертої"

msgid "Tule õhtul minu juurde!"
msgstr "Tule õhtul minu juurde!"

msgid "Type either the <0>-l / -le / -lt</0> form or the genitive plus <1>juures / juurde / juurest</1> to finish each sentence."
msgstr "Впиши або форму з <0>-l / -le / -lt</0>, або родовий плюс <1>juures / juurde / juurest</1>, щоб доповнити кожне речення."

msgid "Use <0>-l</0>, <1>-le</1> and <2>-lt</2> on a person for having, giving and getting (<3>Emal on auto</3>), and the genitive plus <4>juures</4>, <5>juurde</5> and <6>juurest</6> for being at, going to or coming from someone’s place (<7>Olen ema juures</7>)."
msgstr "Вживай <0>-l</0>, <1>-le</1> і <2>-lt</2> із людиною для володіння, давання й отримання (<3>Emal on auto</3>), а родовий плюс <4>juures</4>, <5>juurde</5> і <6>juurest</6> — коли йдеться про перебування чи рух до когось (<7>Olen ema juures</7>)."

msgid "Waiting outside the main railway station"
msgstr "Чекає надворі біля головного вокзалу"

msgid "Weekend at grandmother’s"
msgstr "Вихідні в бабусі"

msgid "What did Kati and her grandmother bake together? Write one word from the message."
msgstr "Що Каті та бабуся спекли разом? Напиши одне слово з повідомлення."

msgid "What did Mart get from the doctor? Write one word as he says it."
msgstr "Що Март отримав від лікаря? Напиши одне слово так, як він каже."

msgid "What does each phrase mean?"
msgstr "Що означає кожна фраза?"

msgid "What will Kati bring with her? Write one word as she says it."
msgstr "Що Каті принесе із собою? Напиши одне слово так, як вона каже."

msgid "When is Kati coming to Mart’s place?"
msgstr "Коли Каті прийде до Марта в гості?"

msgid "Where is Kati staying this weekend?"
msgstr "Де Каті гостює на цих вихідних?"

msgid "Where is Mart right now?"
msgstr "Де зараз Март?"

msgid "Who gave Kati old family photos?"
msgstr "Хто дав Каті старі сімейні фото?"

msgid "Why did Mart see the doctor?"
msgstr "Чому Март ходив до лікаря?"

msgid "Why is Kati going to Mart’s place on Sunday evening?"
msgstr "Чому Каті зайде до Марта в неділю ввечері?"

msgid "With an old friend in Pärnu"
msgstr "У давнього друга в Пярну"

msgid "With pronouns, use the genitive before <0>juures</0>: <1>minu juures</1> (at my place), not <2>mul juures</2>."
msgstr "Із займенниками перед <0>juures</0> ставиться родовий відмінок: <1>minu juures</1> («у мене»), а не <2>mul juures</2>."

msgid "Write each sentence in Estonian, choosing <0>-l / -le / -lt</0> or <1>juures / juurde / juurest</1>."
msgstr "Напиши кожне речення естонською, обравши <0>-l / -le / -lt</0> або <1>juures / juurde / juurest</1>."

msgid "Write it in Estonian"
msgstr "Напиши естонською"

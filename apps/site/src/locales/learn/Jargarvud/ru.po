msgid "The fifth"
msgstr "На пятом"

msgid "The final <0>ne</0> turns into <1>sel</1>."
msgstr "Конечное <0>ne</0> становится <1>sel</1>."

msgid "The final <0>s</0> turns into <1>ndal</1>."
msgstr "Конечное <0>s</0> становится <1>ndal</1>."

msgid "The first day of the week."

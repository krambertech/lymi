msgid "ten"
msgstr "десять"

msgid "tenth"
msgstr "десятый"

msgid "Tenth is <et>kümnes</et>: the genitive <et>kümne</et> with <et>-s</et>."
msgstr "«Десятый» — <et>kümnes</et>: родительный <et>kümne</et> с <et>-s</et>."

msgid "The book costs ten euros."
msgstr "Книга стоит десять евро."

msgid "The eleventh"

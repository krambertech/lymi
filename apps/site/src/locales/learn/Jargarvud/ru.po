msgstr "Родительный падеж плюс <0>s</0>."

msgid "The genitive, the form for “of”: <0>{genitive}</0>."
msgstr "Родительный падеж, форма на «чей? чего?»: <0>{genitive}</0>."

msgid "The month has <0>l</0>, so the ordinal takes it too: <1>viiendal mail</1>."
msgstr "У месяца есть <0>l</0>, значит, и у порядкового числительного: <1>viiendal mail</1>."

msgid "The months"
msgstr "Месяцы"

msgid "The same <0>l</0> says on which floor: <1><2/>.</1> To ask, use <3/>: <4/> <5/> is a floor, and <6/> a birthday."
msgstr "То же <0>l</0> нужно и для этажа: <1><2/>.</1> Чтобы спросить, используй <3/>: <4/> <5/> — это этаж, а <6/> — день рождения."

msgid "The same question, word for word “which one is it today?”"
msgstr "Тот же вопрос, дословно «которое сегодня?»"

msgid "The second"
msgstr "На втором"

msgid "The shop is closed on 25 December."
msgstr "25 декабря магазин закрыт."

msgid "The tenth is <0>kümnes</0>, the genitive <1>kümne</1> with <2>s</2>."
msgstr "«Десятое» — <0>kümnes</0>, родительный <1>kümne</1> с <2>s</2>."

msgid "third"

msgid "The full stop makes it an ordinal, and after <0>on</0> the date keeps its plain form."
msgstr "Точка делает число порядковым, а после <0>on</0> дата остаётся в основной форме."

msgid "the genitive"
msgstr "родительный падеж"

msgid "The genitive of <et>seitse</et> is <et>seitsme</et>, so seventh is <et>seitsmes</et>."
msgstr "Родительный от <et>seitse</et> — <et>seitsme</et>, так что «седьмой» — <et>seitsmes</et>."


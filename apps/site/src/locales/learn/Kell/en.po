msgid "{past} minutes past {struck}."
msgstr "{past} minutes past {struck}."

msgid "<0/> counts on from the hour that has struck; <1/> counts down to the hour that’s coming. Mix them up and the time comes out wrong by up to forty minutes. Listen, then pick the time."
msgstr "<0/> counts on from the hour that has struck; <1/> counts down to the hour that’s coming. Mix them up and the time comes out wrong by up to forty minutes. Listen, then pick the time."

msgid "<0/> means half, and it looks ahead. <1/> is halfway to four, so it’s 3:30, not 4:30."
msgstr "<0/> means half, and it looks ahead. <1/> is halfway to four, so it’s 3:30, not 4:30."

msgid "<0>Pool</0>, <1>veerand</1> and <2>kolmveerand</2> name the hour that’s coming: <3>pool neli</3> is 3:30."
msgstr "<0>Pool</0>, <1>veerand</1> and <2>kolmveerand</2> name the hour that’s coming: <3>pool neli</3> is 3:30."

msgid "<0>Veerand neli</0> is a quarter of the way to four, 3:15. <1>Kolmveerand neli</1> is three quarters, 3:45."
msgstr "<0>Veerand neli</0> is a quarter of the way to four, 3:15. <1>Kolmveerand neli</1> is three quarters, 3:45."

msgid "<et>Läbi</et> counts on from the hour that has struck."
msgstr "<et>Läbi</et> counts on from the hour that has struck."

msgid "<et>Pärast</et> counts down to the hour that’s coming."
msgstr "<et>Pärast</et> counts down to the hour that’s coming."

msgid "<et>Pool</et>, <et>veerand</et> and <et>kolmveerand</et> name the hour that’s coming."
msgstr "<et>Pool</et>, <et>veerand</et> and <et>kolmveerand</et> name the hour that’s coming."

msgid "18 minutes"
msgstr "18 minutes"

msgid "6 quizzes and a voice message"
msgstr "6 quizzes and a voice message"


msgstr "a time"

msgid "After a number from two up, minut becomes minutit."
msgstr "After a number from two up, minut becomes minutit."

msgid "after; in, as in “in ten minutes”"
msgstr "after; in, as in “in ten minutes”"

msgid "All six right."
msgstr "All six right."

msgid "All six, every word in its place."
msgstr "All six, every word in its place."

msgid "All six, every word spelled right."
msgstr "All six, every word spelled right."

msgid "Also a bell."
msgstr "Also a bell."


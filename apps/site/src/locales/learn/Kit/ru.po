msgid "Estonian perfect and pluperfect"
msgstr "Перфект и плюсквам­перфект в эстонском языке"

msgid "Estonian personal pronouns and “to be”"
msgstr "Эстонские личные местоимения и «быть»"

msgid "Estonian personal pronouns in every case"
msgstr "Склонение личных местоимений в эстонском"

msgid "Estonian plural"
msgstr "Множественное число в эстонском языке"

msgid "Estonian plural cases"
msgstr "Падежи множественного числа в эстонском языке"

msgid "Estonian plural partitive"
msgstr "Партитив множественного числа в эстонском языке"

msgid "Estonian postpositions: on, under, behind"
msgstr "Эстонские послелоги: на, под, за"

msgid "Estonian practice: last weekend and next week"
msgstr "Практика эстонского: прошлые выходные и следующая неделя"

msgid "Estonian practice: looking for a flat"
msgstr "Практика эстонского: поиск квартиры"

msgid "Estonian practice: shopping at the market"
msgstr "Практика эстонского: покупки на рынке"

msgid "Estonian present tense"
msgstr "Настоящее время в эстонском языке"

msgid "Estonian pronunciation"
msgstr "Эстонское произношение"

msgid "Estonian reading and listening practice: a day in Tallinn"
msgstr "Эстонский язык: чтение и аудирование. День в Таллине"

msgid "Estonian relative clauses: who, which and where"
msgstr "Эстонские придаточные предложения: кто, что и где"

msgid "Estonian reported speech and the -vat form"
msgstr "Косвенная речь и форма на -vat в эстонском"

msgid "Estonian somebody and nobody: -gi and -ki"
msgstr "Эстонские «кто-то» и «никто»: -gi и -ki"

msgid "Estonian time expressions: when things happen"
msgstr "Как сказать «когда» по-эстонски"

msgid "Estonian total and partial object"
msgstr "Полный и частичный объект в эстонском языке"

msgid "Estonian word order: the verb usually comes second"
msgstr "Порядок слов в эстонском: глагол обычно второй"

msgid "Estonian writing practice: a message to the landlord"
msgstr "Эстонский язык: практика письма. Письмо арендодателю"

msgid "Every word has a group. Check when you’re ready."
msgstr "Все слова в группах. Можно проверять."

msgid "Every word is in its group."
msgstr "Каждое слово в своей группе."


msgstr "Хто це каже?"

msgid "Whose it is"
msgstr "Чиє це"

msgid "With *olen* for have, *olin* for had."
msgstr "З *olen* — до цього моменту, з *olin* — до якогось моменту в минулому."

msgid "With endings like -s"
msgstr "Із закінченнями на зразок -s"

msgid "With words like “love”"
msgstr "Зі словами на зразок «кохати»"

msgid "With, without, until and as in Estonian"
msgstr "«З», «без», «аж до» і «як» естонською"

msgid "With, without, until, as"
msgstr "З, без, до, як"

msgid "Without doing it"
msgstr "Не зробивши"

msgid "Word changes"
msgstr "Як змінюється слово"

msgid "Word meanings open once you have answered."
msgstr "Значення слів відкриються, коли відповіси."

msgid "Word order: the verb comes second"

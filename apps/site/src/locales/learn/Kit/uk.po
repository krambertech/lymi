msgstr "Введи форму"

msgid "Type the number"
msgstr "Введи число"

msgid "Type the question"
msgstr "Напиши запитання"

msgid "Type the sentence"
msgstr "Напиши речення"

msgid "under"
msgstr "під"

msgid "Use"
msgstr "Випадок"

msgid "Use every word."
msgstr "Використай усі слова."

msgid "Usually *-sin* for I, *-sid* for you, *-s* for he or she."
msgstr "Зазвичай *-sin* — я, *-sid* — ти, *-s* — він чи вона."

msgid "Usually after any number but *üks*."
msgstr "Зазвичай після будь-якого числа, крім *üks*."

msgid "Usually the ending goes on the genitive."
msgstr "Зазвичай закінчення додають до родового."

msgid "Usually, when such a word stands after the noun."
msgstr "Зазвичай, коли таке слово стоїть після іменника."

msgid "Verbs"
msgstr "Дієслова"

msgid "Verbs or nouns"
msgstr "Дієслова чи іменники"

msgid "Warm-up"
msgstr "Розминка"

msgid "Wash your hands before eating!"
msgstr "Помий руки перед їжею!"


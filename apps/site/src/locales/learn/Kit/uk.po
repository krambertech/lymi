msgstr "Книжка непрочитана."

msgid "The bus had already left."
msgstr "Автобус уже поїхав."

msgid "The car is in front of the house."
msgstr "Машина перед будинком."

msgid "The cat comes out of the house."
msgstr "Кіт виходить з будинку."

msgid "The cat goes into the house."
msgstr "Кіт заходить у будинок."

msgid "The cat is behind the box."
msgstr "Кіт за коробкою."

msgid "The cat is coming back from eating."
msgstr "Кіт повертається після їжі."

msgid "The cat is in front of the box."
msgstr "Кіт перед коробкою."

msgid "The cat is in the house."
msgstr "Кіт у будинку."

msgid "The cat is inside the box."
msgstr "Кіт у коробці."


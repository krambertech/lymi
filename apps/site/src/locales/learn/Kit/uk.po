msgstr "-b зараз; у минулому лише -s."

msgid "-d now, -sid in the past."
msgstr "-d зараз, -sid у минулому."

msgid "-me now, -sime in the past."
msgstr "-me зараз, -sime у минулому."

msgid "-n now, -sin in the past."
msgstr "-n зараз, -sin у минулому."

msgid "-te now, -site in the past."
msgstr "-te зараз, -site у минулому."

msgid "-vad now; -sid in the past, as for sa."
msgstr "-vad зараз; -sid у минулому, як для sa."

msgid ", in the right group"
msgstr ", у правильній групі"


msgstr "The -v form"

msgid "The -v form changes with its noun: <0>jooksvat vett</0>."
msgstr "The -v form changes with its noun: <0>jooksvat vett</0>."

msgid "The -v form changes with its noun: <0>magavat last</0>."
msgstr "The -v form changes with its noun: <0>magavat last</0>."


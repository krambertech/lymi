msgid "<0/> can only mean I am, so <1/> can go. <2/> means both he or she is and they are, so <3/> or <4/> has to stay."
msgstr "<0/> can only mean I am, so <1/> can go. <2/> means both he or she is and they are, so <3/> or <4/> has to stay."

msgid "<0/> has no ending, and it serves both he or she and they. That makes <1/> irregular: other verbs add an ending there too, as lesson {regularVerbs} shows."
msgstr "<0/> has no ending, and it serves both he or she and they. That makes <1/> irregular: other verbs add an ending there too, as lesson {regularVerbs} shows."

msgid "<0/> is he and she alike; Estonian pronouns have no gender. <1/> is also the polite you to one person, like French vous."
msgstr "<0/> is he and she alike; Estonian pronouns have no gender. <1/> is also the polite you to one person, like French vous."

msgid "<0/> means to be. Its ending changes with the person: <1/> is I am, <2/> is you are. Tap an ending."
msgstr "<0/> means to be. Its ending changes with the person: <1/> is I am, <2/> is you are. Tap an ending."

msgid "<0>Olen, oled, oleme, olete</0>: the ending says who."
msgstr "<0>Olen, oled, oleme, olete</0>: the ending says who."

msgid "<0>On</0> has no ending, so only <1>ta</1> or <2>nad</2> says who."
msgstr "<0>On</0> has no ending, so only <1>ta</1> or <2>nad</2> says who."

msgid "<0>On</0> is both he or she is and they are. Only the pronoun tells them apart."
msgstr "<0>On</0> is both he or she is and they are. Only the pronoun tells them apart."

msgid "<0>Ta</0> is both he and she. <1>Te</1> is you, to more than one, and polite you to one person."
msgstr "<0>Ta</0> is both he and she. <1>Te</1> is you, to more than one, and polite you to one person."

#. placeholder {0}: capital(long)
msgid "<et>{0} {verb}</et>; the short form is <et>{short} {verb}</et>."
msgstr "<et>{0} {verb}</et>; the short form is <et>{short} {verb}</et>."

#. placeholder {0}: capital(pronoun)
msgid "<et>{0}</et> takes <et>{verb}</et>."
msgstr "<et>{0}</et> takes <et>{verb}</et>."

msgid "<et>Oled</et> can only be you are, to one person."
msgstr "<et>Oled</et> can only be you are, to one person."

msgid "<et>Oleme</et> can only be we are."
msgstr "<et>Oleme</et> can only be we are."

msgid "<et>Olen</et> can only be I am."
msgstr "<et>Olen</et> can only be I am."

msgid "<et>Olete</et> can only be you are, to more than one, or polite you."
msgstr "<et>Olete</et> can only be you are, to more than one, or polite you."

msgid "<et>On</et> has no ending, so <et>ta</et> stays."
msgstr "<et>On</et> has no ending, so <et>ta</et> stays."

msgid "<et>On</et> with <et>nad</et>: they are."
msgstr "<et>On</et> with <et>nad</et>: they are."

msgid "<et>On</et> with <et>ta</et>: he or she is."
msgstr "<et>On</et> with <et>ta</et>: he or she is."

msgid "<et>Te olete</et>: you are, to more than one, or polite you."
msgstr "<et>Te olete</et>: you are, to more than one, or polite you."


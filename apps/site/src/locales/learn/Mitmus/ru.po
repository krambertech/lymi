msgid "<et>{0}, {1}</et>: the plural is <et>{2}</et>."
msgstr "<et>{0}, {1}</et>: множественное число — <et>{2}</et>."

msgid "20 minutes"
msgstr "20 минут"

msgid "7 exercises"
msgstr "7 упражнений"

msgid "a beautiful room"
msgstr "красивая комната"

msgid "a big house"
msgstr "большой дом"


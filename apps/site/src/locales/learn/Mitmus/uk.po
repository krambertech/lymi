msgstr "місто"

msgid "towns, cities"
msgstr "міста"

msgid "two cats"
msgstr "два коти"

msgid "Two people joined by <0/> count as many too, so the verb takes the form of <1>nad</1>: <2/>"
msgstr "Двоє людей, з’єднаних <0/>, — це теж багато, тож дієслово стоїть у формі для <1>nad</1>: <2/>"

msgid "Two people joined by <0>ja</0> take the verb form of <1>nad</1> too: <2>Ema ja isa töötavad.</2>"
msgstr "Із двома людьми, з’єднаними <0>ja</0>, дієслово теж стоїть у формі для <1>nad</1>: <2>Ema ja isa töötavad.</2>"

msgid "Type the plural"
msgstr "Введи множину"


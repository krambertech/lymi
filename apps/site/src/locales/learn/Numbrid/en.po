msgid "-teist or -kümmend?"
msgstr "-teist or -kümmend?"

msgid "<0/> has a short a and a k before the s; <1/> has a long uu. <2/> starts with ka, <3/> with ü. The numbers built from them differ the same way. Listen, then pick."
msgstr "<0/> has a short a and a k before the s; <1/> has a long uu. <2/> starts with ka, <3/> with ü. The numbers built from them differ the same way. Listen, then pick."

msgid "<0/> is a hundred and <1/> a thousand, with no “one” in front of either. Hundreds join into one word, <2/>, but thousands stay separate: <3/>."
msgstr "<0/> is a hundred and <1/> a thousand, with no “one” in front of either. Hundreds join into one word, <2/>, but thousands stay separate: <3/>."

msgid "<0/> is twelve and <1/> is twenty. Both start with kaks, so listen to how the word ends."
msgstr "<0/> is twelve and <1/> is twenty. Both start with kaks, so listen to how the word ends."

msgid "<0>Sada</0> and <1>tuhat</1> need no “one”. Hundreds join up; thousands stay separate."
msgstr "<0>Sada</0> and <1>tuhat</1> need no “one”. Hundreds join up; thousands stay separate."

msgid "<et>-teist</et> makes eleven to nineteen; <et>-kümmend</et> makes the tens."
msgstr "<et>-teist</et> makes eleven to nineteen; <et>-kümmend</et> makes the tens."

msgid "<et>-teist</et> or <et>-kümmend</et>"
msgstr "<et>-teist</et> or <et>-kümmend</et>"

msgid "<et>Kaks</et> has a short a and a k; <et>kuus</et> a long uu. <et>Kaheksa</et> starts with ka, <et>üheksa</et> with ü."
msgstr "<et>Kaks</et> has a short a and a k; <et>kuus</et> a long uu. <et>Kaheksa</et> starts with ka, <et>üheksa</et> with ü."

msgid "<et>Tuhat</et> alone, with no “one” in front."
msgstr "<et>Tuhat</et> alone, with no “one” in front."


msgid "Now type each phrase in the form the cue asks for."
msgstr "Теперь напиши каждое словосочетание в форме, которую требует подсказка."

msgid "old"
msgstr "старый"

msgid "One"
msgstr "Одна"

msgid "Only the noun takes <0>-ga</0>; the adjective stays in the genitive."
msgstr "Только существительное получает <0>-ga</0>; прилагательное остаётся в родительном."

msgid "Only the noun: <et>suure autoga</et>"
msgstr "Только существительное: <et>suure autoga</et>"

msgid "partitive"
msgstr "партитив"


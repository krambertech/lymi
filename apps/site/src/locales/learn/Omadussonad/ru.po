msgid "It adds the ending to its own genitive: <0>uus, uue, uues</0>; <1>väike, väikese, väikeses</1>."
msgstr "Окончание оно добавляет к своему родительному: <0>uus, uue, uues</0>; <1>väike, väikese, väikeses</1>."

msgid "Its genitive is sooja."
msgstr "Родительный — sooja."

msgid "Jaan"
msgstr "Яан"

msgid "Jaan drives a new car."
msgstr "Яан ездит на новой машине."

msgid "Jaan lives in a beautiful town."
msgstr "Яан живёт в красивом городе."

msgid "Jaan tells Kati about his brother’s house in Tartu."
msgstr "Яан рассказывает Кати о доме своего брата в Тарту."


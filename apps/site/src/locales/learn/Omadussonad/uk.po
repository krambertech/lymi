msgid "<0/> is big, and <1>suur maja</1> is a big house. The adjective goes into the same case as the noun: <2/>, in a big house; <3/>, a new book, as the object of <4>loen</4>, I’m reading. Each word builds the case on its own forms, so the endings can differ: <5>suurt maja</5>. Four endings work differently; a section below shows them."
msgstr "<0/> — «великий», а <1>suur maja</1> — «великий будинок». Прикметник стоїть у тому самому відмінку, що й іменник: <2/> — «у великому будинку»; <3/> — «нову книжку», як додаток до <4>loen</4>, «читаю». Кожне слово утворює відмінок від своїх форм, тому закінчення можуть різнитися: <5>suurt maja</5>. Чотири закінчення працюють інакше, про них розповідає розділ нижче."

msgid "<et>Soe</et> takes <et>-s</et> on its genitive <et>sooja</et>: <et>soojas toas</et>."
msgstr "<et>Soe</et> додає <et>-s</et> до свого родового <et>sooja</et>: <et>soojas toas</et>."

msgid "<et>Uus</et> takes <et>-s</et> on its genitive <et>uue</et>: <et>uues majas</et>."
msgstr "<et>Uus</et> додає <et>-s</et> до свого родового <et>uue</et>: <et>uues majas</et>."

msgid "<et>Väike</et> takes <et>-s</et> on its genitive <et>väikese</et>: <et>väikeses toas</et>."
msgstr "<et>Väike</et> додає <et>-s</et> до свого родового <et>väikese</et>: <et>väikeses toas</et>."

msgid "16 minutes"
msgstr "16 хвилин"

msgid "5 exercises, 3 of them typed, and a conversation"
msgstr "5 вправ, у 3 з них треба писати, і розмова"


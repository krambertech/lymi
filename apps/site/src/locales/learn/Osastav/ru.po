#. placeholder {0}: means(row.no, i18n)
msgid "{0} The sentence starts with the cat, so <0>kass</0> keeps its first form, even with <1>pole</1>."
msgstr "{0} Предложение начинается с кошки, поэтому <0>kass</0> остаётся в первой форме, хотя в предложении есть <1>pole</1>."

msgid "<0/> asks how many, and the noun after it takes its third form too. For a price, ask with <1>kui palju</1>, how much, from lesson {questions}."
msgstr "<0/> спрашивает «сколько» о том, что можно посчитать, и существительное после него тоже стоит в третьей форме. Цену спрашивают через <1>kui palju</1> из урока {questions}."

msgid "<0/> I have a cat. To say you don’t, use <1/> from lesson {negation}, and the cat takes its third form: <2/> (Lesson {have} teaches <3>Mul on</3>.)"
msgstr "<0/> У меня есть кошка. Чтобы сказать, что кошки нет, возьми <1/> из урока {negation}, а кошка перейдёт в третью форму: <2/> (О <3>Mul on</3> — в уроке {have}.)"

msgid "<0/> is a cup of coffee. The amount comes first, and what it measures follows in its third form: <1/> becomes <2/>."
msgstr "<0/> — чашка кофе. Сначала идёт слово количества, а за ним то, что меряют, в третьей форме: <1/> становится <2/>. По-русски так же: «стакан воды», а не «стакан вода»."

msgid "<0/> is one cat; <1/> is two cats. After a number from two up, a noun takes its third form, the partitive, and stays singular: <2/> has no plural ending."
msgstr "<0/> — одна кошка, <1/> — две кошки. После числа от двух и больше существительное стоит в третьей форме, партитиве, и остаётся в единственном числе: у <2/> нет окончания множественного числа."

msgid "<0/>, a lot, <1/>, a little, and <2/>, not much, work the same way. The same rule is behind <3>Kui palju kohvi sa jood?</3> from lesson {questions}."
msgstr "<0/> (много), <1/> (немного) и <2/> (мало) работают так же. То же правило стоит за <3>Kui palju kohvi sa jood?</3> из урока {questions}."

#. placeholder {0}: means(text, i18n)
msgid "<0>{text}</0>, {0}"
msgstr "<0>{text}</0>, {0}"

#. placeholder {0}: means(text, i18n)
msgid "<0>{text}</0>, {0}; its third form is <1>maja</1> too, so it looks the same."
msgstr "<0>{text}</0>, {0}; третья форма тоже <1>maja</1>, поэтому слово не меняется."

msgid "<et>Sul on auto</et>: with <et>on</et>, the first form."
msgstr "<et>Sul on auto</et>: с <et>on</et> — первая форма."

msgid "<et>Sul pole autot</et>: with <et>pole</et>, the third form."
msgstr "<et>Sul pole autot</et>: с <et>pole</et> — третья форма."

msgid "<et>Tal on laps</et>: with <et>on</et>, the first form."
msgstr "<et>Tal on laps</et>: с <et>on</et> — первая форма."

msgid "<et>Tal pole last</et>: with <et>pole</et>, the third form."
msgstr "<et>Tal pole last</et>: с <et>pole</et> — третья форма."


msgid "coffee"
msgstr "кава"

msgid "Coffee, please."
msgstr "Кави, будь ласка."

msgid "Compare each row’s two sentences. The last row starts with the cat."
msgstr "Порівняй два речення в кожному рядку. Останній рядок починається з кота."

msgid "cup"
msgstr "чашка"

msgid "Each round shows a number. Pick the form of the noun that follows it, then hear the two together."
msgstr "У кожному раунді — число. Обери форму іменника, що йде після нього, і послухай їх разом."

msgid "Each round shows a sentence with a gap. Pick the form that fills it. Is the gap after <0>pole</0>, or at the start of the sentence?"
msgstr "У кожному раунді — речення з пропуском. Обери форму, яка туди підходить. Пропуск стоїть після <0>pole</0> чи на початку речення?"

msgid "euro"
msgstr "євро"

msgid "Five"
msgstr "П’ять"

msgid "five books"
msgstr "п’ять книжок"

msgid "five cars"
msgstr "п’ять машин"

msgid "five cats"
msgstr "п’ять котів"

msgid "five children"
msgstr "п’ятеро дітей"

msgid "five euros"
msgstr "п’ять євро"

msgid "Five euros."
msgstr "П’ять євро."


msgstr "6 вправ"

msgid "a cup of coffee"
msgstr "чашка кави"

msgid "a glass of water"
msgstr "склянка води"

msgid "a kilo of cheese"
msgstr "кілограм сиру"

msgid "a little"
msgstr "трохи"

msgid "a little milk"
msgstr "трохи молока"

msgid "a lot of money"
msgstr "багато грошей"

msgid "a lot, much, many"
msgstr "багато"

msgid "A voice message from the market"
msgstr "Голосове повідомлення з ринку"

msgid "Aeg, aja, aega."
msgstr "Aeg, aja, aega."

msgid "After <0>pole</0>, what isn’t there takes the third form."
msgstr "Після <0>pole</0> те, чого немає, стоїть у третій формі."

msgid "After <0>pole</0>, what someone hasn’t got, or what there is none of in a place, takes the third form: <1>Mul pole kassi, Laual pole leiba</1>. When the sentence starts with the thing, it keeps its first: <2>Kass pole laual</2>."
msgstr "Після <0>pole</0> те, чого в когось немає або чого немає в якомусь місці, стоїть у третій формі: <1>Mul pole kassi, Laual pole leiba</1>. Якщо речення починається з самої речі, вона лишається в першій: <2>Kass pole laual</2>."

msgid "After <0>pole</0>, what there is none of in a place takes the third form: <1>pole leiba</1>."
msgstr "Після <0>pole</0> те, чого немає в якомусь місці, стоїть у третій формі: <1>pole leiba</1>."

msgid "After <0>üks</0> on its own, a noun keeps its first form. From two up, it takes its third."
msgstr "Після самого <0>üks</0> іменник лишається в першій формі. Від двох — стоїть у третій."

msgid "After <0>üks</0> on its own, the first form: <1>üks kass</1>."
msgstr "Після самого <0>üks</0> — перша форма: <1>üks kass</1>."

msgid "After <0>üks</0> on its own, the first form: <1>üks leib</1>."
msgstr "Після самого <0>üks</0> — перша форма: <1>üks leib</1>."

msgid "After <et>pole</et> or <et>ei ole</et>, what isn’t there takes the third form."
msgstr "Після <et>pole</et> чи <et>ei ole</et> те, чого немає, стоїть у третій формі."

msgid "After <et>üks</et> on its own, the first form."
msgstr "Лише <et>üks</et> — отже, перша форма."

msgid "After a number from two up"
msgstr "Після числа від двох"

msgid "After a number from two up, a noun takes its third form and stays singular: <0>kaks kassi, viis eurot</0>. After <1>üks</1> on its own, it keeps its first: <2>üks kass</2>."
msgstr "Після числа від двох іменник стоїть у третій формі й лишається в однині: <0>kaks kassi, viis eurot</0>. Після самого <1>üks</1> він лишається в першій: <2>üks kass</2>."

msgid "After a number from two up, or <et>mitu</et>, the third form."
msgstr "Після числа від двох або <et>mitu</et> — третя форма."

msgid "After a number from two up, the third form: <0>seitse eurot</0>."
msgstr "Після числа від двох — третя форма: <0>seitse eurot</0>."

msgid "After an amount"
msgstr "Після слів кількості"

msgid "After an amount, the third form: <0>kilo juustu</0>."
msgstr "Після слова кількості — третя форма: <0>kilo juustu</0>."

msgid "After an amount, the third form."
msgstr "Після слова кількості — третя форма."

msgid "After an amount, what it measures takes the third form: <0>tass kohvi, palju raha</0>."
msgstr "Після слова кількості те, що міряють, стоїть у третій формі: <0>tass kohvi, palju raha</0>."

msgid "All four. You told a gap after <0>pole</0> from a gap at the start."
msgstr "Усі чотири: ти розрізняєш пропуск після <0>pole</0> і пропуск на початку."

msgid "All seven, typed in full."
msgstr "Усі сім набрані повністю."

msgid "All six, typed in full."
msgstr "Усі шість набрані повністю."

msgid "All six. You picked the right form after every number."
msgstr "Усі шість: після кожного числа правильна форма."

msgid "Amounts"
msgstr "Слова кількості"

msgid "An answer with <0>üks</0> keeps the first form: <1/>"
msgstr "У відповіді з <0>üks</0> лишається перша форма: <1/>"

msgid "Ask how many with <0>mitu</0> and the third form: <1>Mitu last sul on?</1>"
msgstr "Щоб спитати «скільки», кажи <0>mitu</0> і став іменник у третю форму: <1>Mitu last sul on?</1>"

msgid "Asking how many"
msgstr "Як спитати «скільки»"

msgid "At the market"
msgstr "На ринку"

msgid "book"
msgstr "книжка"

msgid "bread"
msgstr "хліб"

msgid "café"
msgstr "кав’ярня"

msgid "car"
msgstr "машина"

msgid "cat"
msgstr "кіт"


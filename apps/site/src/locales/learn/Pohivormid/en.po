msgstr "The second form of {first}."

msgid "The second form of <0>{first}</0>."
msgstr "The second form of <0>{first}</0>."

msgid "The second loses the <0>b</0> and the <1>u</1> turns into <2>o</2>; the third is the first again."
msgstr "The second loses the <0>b</0> and the <1>u</1> turns into <2>o</2>; the third is the first again."

msgid "The third adds <0>-t</0>."
msgstr "The third adds <0>-t</0>."


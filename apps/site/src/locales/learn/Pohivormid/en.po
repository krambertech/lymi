msgstr "The third form of <0>{first}</0>."

msgid "The third form of <0>laps</0> ends in <1>-st</1>: <2>last</2>."
msgstr "The third form of <0>laps</0> ends in <1>-st</1>: <2>last</2>."

msgid "The third is the second with <0>-t</0>."
msgstr "The third is the second with <0>-t</0>."


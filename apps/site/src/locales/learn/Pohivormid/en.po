msgid "<0>-ne</0> becomes <1>-se</1>, then <2>-st</2>."
msgstr "<0>-ne</0> becomes <1>-se</1>, then <2>-st</2>."

msgid "<0>-ne</0> becomes <1>-st</1>."
msgstr "<0>-ne</0> becomes <1>-st</1>."

msgid "<0>-us</0> becomes <1>-use</1>, then <2>-ust</2>."
msgstr "<0>-us</0> becomes <1>-use</1>, then <2>-ust</2>."

msgid "<0>-us</0> takes <1>-t</1>."
msgstr "<0>-us</0> takes <1>-t</1>."

msgid "<0>Last</0> is the third form, so it comes after <1>lapse</1>."
msgstr "<0>Last</0> is the third form, so it comes after <1>lapse</1>."

msgid "<0>Majas</0> means in the house: the second form with <1>-s</1>. The second form itself is <2>maja</2>."
msgstr "<0>Majas</0> means in the house: the second form with <1>-s</1>. The second form itself is <2>maja</2>."

msgid "<0>Poe</0> is the second form. The third has the <1>d</1> back: <2>poodi</2>."
msgstr "<0>Poe</0> is the second form. The third has the <1>d</1> back: <2>poodi</2>."

msgid "<0>Sõnaveeb</0>, the free dictionary of the Institute of the Estonian Language, lists them under <1>Sõnavormid</1>, word forms. Search for a word and scroll to that table: its left column holds the three forms, top to bottom. The right column is the plural."
msgstr "<0>Sõnaveeb</0>, the free dictionary of the Institute of the Estonian Language, lists them under <1>Sõnavormid</1>, word forms. Search for a word and scroll to that table: its left column holds the three forms, top to bottom. The right column is the plural."

msgid "12 minutes"
msgstr "12 minutes"

msgid "2 quizzes and a conversation"
msgstr "2 quizzes and a conversation"

msgid "A dictionary gives a noun in three forms, always in the same order: <0>kool, kooli, kooli</0>."
msgstr "A dictionary gives a noun in three forms, always in the same order: <0>kool, kooli, kooli</0>."

msgid "A final vowel doesn’t promise matching forms, though. <0/>, car, ends in a vowel like <1/>, but its third form is <2/>. And <3/>, book, goes <4>raamatu, raamatut</4>. The dictionary settles it."
msgstr "A final vowel doesn’t promise matching forms, though. <0/>, car, ends in a vowel like <1/>, but its third form is <2/>. And <3/>, book, goes <4>raamatu, raamatut</4>. The dictionary settles it."

msgid "A noun has three forms"
msgstr "A noun has three forms"

msgid "A one-syllable word that ends in a long vowel, such as <0/>, work, keeps its second form the same and adds <1>-d</1> for the third: <2>töö, töö, tööd</2>."
msgstr "A one-syllable word that ends in a long vowel, such as <0/>, work, keeps its second form the same and adds <1>-d</1> for the third: <2>töö, töö, tööd</2>."

msgid "A printed dictionary puts them on one line instead: <0>pood poe poodi</0>."
msgstr "A printed dictionary puts them on one line instead: <0>pood poe poodi</0>."

msgid "All six. You typed the third form right every time."
msgstr "All six. You typed the third form right every time."

msgid "All three forms are the same."
msgstr "All three forms are the same."


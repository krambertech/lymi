msgid "<0>-ke</0> makes a thing small or dear. It usually joins the genitive."
msgstr "<0>-ke</0> додає значення малого розміру або пестливості. Зазвичай його додають до родового."

msgid "<0>-ke</0> makes something small or dear, and usually joins the genitive: <1>majake, tükike, linnake</1>. It changes like <2>-ne</2>: <3>majakese, majakest</3>."
msgstr "<0>-ke</0> додає значення малого розміру або пестливості й зазвичай приєднується до родового: <1>majake, tükike, linnake</1>. Такі слова відмінюються, як слова на <2>-ne</2>: <3>majakese, majakest</3>."

msgid "<0>-ke</0>: a small one."
msgstr "<0>-ke</0> — щось маленьке."

msgid "<0>-lik</0> usually makes an adjective meaning like it, having it or to do with it."
msgstr "Суфікс <0>-lik</0> зазвичай утворює прикметник зі значенням подібності, наявності чогось або зв’язку з чимось."

msgid "<0>-lik</0> usually makes an adjective meaning like it, having it or to do with it. <1>Kohalik</1> means local, of the place. <2>Tervislik</2> means healthy, good for your health."
msgstr "Суфікс <0>-lik</0> зазвичай утворює прикметник зі значенням подібності, наявності чогось або зв’язку з чимось. <1>Kohalik</1> означає «місцевий», тобто пов’язаний із місцем. <2>Tervislik</2> означає «корисний для здоров’я»."

msgid "<0>-tu</0> and <1>-ke</1> usually join the genitive: <2>viga, vea, veatu</2>. Before <3>-lik</3> the stem varies: <4>sõbra-lik</4> but <5>oht-lik</5>. Pick an ending and tap the words."
msgstr "<0>-tu</0> й <1>-ke</1> зазвичай додають до родового: <2>viga, vea, veatu</2>. Перед <3>-lik</3> основа буває різною: <4>sõbra-lik</4>, а от <5>oht-lik</5>. Вибери суфікс і торкайся слів."

msgid "<0>-tu</0> gives an adjective the same meaning as the case ending <1>-ta</1> from lesson {without}: <2>koer on koduta</2> and <3>kodutu koer</3> both describe a dog without a home."
msgstr "<0>-tu</0> передає в прикметнику те саме «без», що й відмінок на <1>-ta</1> з уроку {without}. І <2>koer on koduta</2>, і <3>kodutu koer</3> описують собаку без дому."

msgid "<0>-tu</0> means without, and usually joins the genitive: <1>kodutu, töötu, veatu</1>."
msgstr "<0>-tu</0> означає «без». Його зазвичай додають до родового: <1>kodutu, töötu, veatu</1>."

msgid "<0>-tu</0> means without, like English -less. It usually joins the genitive."
msgstr "<0>-tu</0> означає «без», як у слові «безробітний». Його зазвичай додають до родового."

msgid "<0>-tu</0>: without it."
msgstr "<0>-tu</0> — без чогось."

#. placeholder {0}: item.answer
#. placeholder {1}: i18n._(KIND_LABELS[item.kind])
msgid "<0>{0}</0>: {1}."
msgstr "<0>{0}</0>: {1}."

msgid "<0>Sõber</0> gives <1>sõbralik</1>, friendly; <2>kodu</2> gives <3>kodutu</3>, homeless; <4>maja</4> gives <5>majake</5>, a little house. Three endings make new words from nouns you know."
msgstr "Від <0>Sõber</0> маємо <1>sõbralik</1> («дружній»), від <2>kodu</2> — <3>kodutu</3> («бездомний»), а від <4>maja</4> — <5>majake</5> («будиночок»). Три суфікси утворюють нові слова від знайомих іменників."

msgid "<et>-ke</et> makes something small or dear, and usually joins the genitive."
msgstr "<et>-ke</et> додає значення малого розміру або пестливості. Зазвичай його додають до родового."

msgid "<et>-ke</et>: a small one"
msgstr "<et>-ke</et> — щось маленьке"

msgid "<et>-lik</et> usually makes an adjective meaning like it, having it or to do with it."
msgstr "Суфікс <et>-lik</et> зазвичай утворює прикметник зі значенням подібності, наявності чогось або зв’язку з чимось."

msgid "<et>-tu</et> means without, and usually joins the genitive."
msgstr "<et>-tu</et> означає «без». Його зазвичай додають до родового."

msgid "<et>-tu</et>: without it"
msgstr "<et>-tu</et> — без чогось"

msgid "<et>Linnake</et>, a small town; in it, <et>linnakeses</et>."
msgstr "<et>Linnake</et> — містечко, а «в містечку» — <et>linnakeses</et>."

msgid "<et>Poisike</et> is a little boy, from <et>poiss</et>."
msgstr "<et>Poisike</et> — маленький хлопчик, від <et>poiss</et>."

msgid "<et>Tükike</et> is a little piece; after it, the partitive: <et>kooki</et>."
msgstr "<et>Tükike</et> — шматочок. Далі потрібен партитив: <et>kooki</et>."

msgid "24 minutes"
msgstr "24 хвилини"

msgid "7 exercises"
msgstr "7 вправ"

msgid "A <0>-ke</0> word changes like <1>-ne</1>: <2>majakese</2>, so <3>majakeses</3>."
msgstr "Слово на <0>-ke</0> відмінюється, як слово на <1>-ne</1>: <2>majakese</2>, звідси <3>majakeses</3>."

msgid "A <et>-ke</et> word changes like <et>-ne</et>: <et>majakeses</et>."
msgstr "Слово на <et>-ke</et> відмінюється, як слово на <et>-ne</et>: <et>majakeses</et>."

msgid "A busy road"
msgstr "Жвава дорога"

msgid "A cottage by the sea"
msgstr "Будиночок біля моря"

msgid "A dog is grateful even for a short walk."
msgstr "Собака вдячний навіть за коротку прогулянку."

msgid "a little boy"
msgstr "хлопчик"

msgid "a little cat"
msgstr "котик"

msgid "a little house"
msgstr "будиночок"

msgid "A little house on Saaremaa"
msgstr "Будиночок на Сааремаа"

msgid "a little piece"
msgstr "шматочок"

msgid "a small one"
msgstr "щось маленьке"

msgid "A small one"
msgstr "Щось маленьке"

msgid "a small town"
msgstr "містечко"

msgid "Add an ending to a noun and you get a new word. <0/> is like a friend, so friendly. <1/> is without a home. <2/> is a little house."
msgstr "Суфікс додає іменнику нове значення. <0/> — схожий на друга, тобто дружній. <1/> — без дому. <2/> — маленький будинок."

msgid "Adjective with -lik"
msgstr "Прикметник на -lik"

msgid "Adjectives with <et>-lik</et>"
msgstr "Прикметники на <et>-lik</et>"

msgid "After <0>tükike</0>, use the partitive: <1>kooki</1>."
msgstr "Після <0>tükike</0> потрібен партитив: <1>kooki</1>."

msgid "All eight, typed in full."
msgstr "Усі вісім, повністю написані."

msgid "All nine: you heard the ending every time."
msgstr "Усі дев’ять суфіксів розпізнано на слух."

msgid "All seven, each word with its ending."
msgstr "У всіх семи словах правильні суфікси."

msgid "All six found and fixed."
msgstr "Усі шість знайдено й виправлено."

msgid "An animal shelter"
msgstr "Притулок для тварин"

msgid "Ask if the cottage is free when you want it."
msgstr "Запитай, чи вільний будинок у потрібні дні."

msgid "Ask two more questions."
msgstr "Постав іще два запитання."

msgid "Bring old blankets and towels."
msgstr "Принесіть старі ковдри й рушники."

msgid "Cheaper per night"
msgstr "Дешевше за ніч"

msgid "child"
msgstr "дитина"

msgid "childish"
msgstr "дитячий, по-дитячому незрілий"

msgid "Cleaning"
msgstr "Прибирання"

msgid "dangerous"
msgstr "небезпечний"

msgid "Each round gives a noun and what to add. Type the new word. In these examples with <0>-tu</0> and <1>-ke</1>, start from the genitive."
msgstr "У кожному завданні є іменник і суфікс. Напиши нове слово. З <0>-tu</0> й <1>-ke</1> тут бери за основу родовий."

msgid "Each sentence has one wrong word: the wrong ending, or a form that doesn’t agree. Tap it, then type it right."
msgstr "У кожному реченні одне слово неправильне: помилка в суфіксі або в узгодженні. Торкнися слова й виправ його."

msgid "Endings"
msgstr "Суфікси"

msgid "endless"
msgstr "нескінченний"

msgid "Fix the sentence"
msgstr "Виправ речення"

msgid "Foxes live in the forest"
msgstr "У лісі живуть лисиці"

msgid "friend"
msgstr "друг, подруга"

msgid "friendly"
msgstr "дружній"

msgid "From kodu, home."
msgstr "Від kodu («дім»)."

msgid "From koht, place."
msgstr "Від koht («місце»)."

msgid "From maja. Majakeses, in the little house."
msgstr "Від maja. Majakeses — у будиночку."

msgid "From sõber, friend."
msgstr "Від sõber («друг»)."

msgid "From töö, work."
msgstr "Від töö («робота»)."

msgid "From tükk, genitive tüki."
msgstr "Від tükk, у родовому — tüki."

msgid "Give me a little piece of cake."
msgstr "Дай мені шматочок торта."

msgid "He’s thirty, but very childish."
msgstr "Йому тридцять, а поводиться він зовсім по-дитячому."

msgid "healthy"
msgstr "здоровий"

msgid "Hear a word, then pick what its ending usually adds."
msgstr "Послухай слово й обери, якого значення зазвичай надає йому це закінчення."

msgid "helpless"
msgstr "безпорадний"

msgid "home"
msgstr "дім"

msgid "homeless"
msgstr "бездомний"

msgid "house"
msgstr "будинок"

msgid "How many dogs does the shelter have now?"
msgstr "Скільки собак зараз у притулку?"

msgid "How much does it cost to take a cat home? Write the number as Kati says it."
msgstr "Скільки коштує забрати кота додому? Напиши число так, як сказала Каті."

msgid "In a sentence"
msgstr "У реченні"

msgid "It can only be rented by the week in summer"
msgstr "Улітку будинок здають лише на тиждень"

msgid "It costs the same as seven nights"
msgstr "Коштує стільки ж, скільки сім ночей"

msgid "Kalev"
msgstr "Калев"

msgid "Kalev visits an animal shelter in Viljandi and talks to Kati, a volunteer."
msgstr "Калев відвідує притулок для тварин у Вільянді й розмовляє з волонтеркою Каті."

msgid "Kati"
msgstr "Каті"

msgid "Kati first came to the shelter when she had no job."
msgstr "Каті вперше прийшла до притулку, коли не мала роботи."

msgid "Like a child is <0>lapselik</0>. With <1>-tu</1>, the word would mean without children."
msgstr "По-дитячому — <0>lapselik</0>. З <1>-tu</1> слово означало б «без дітей»."

msgid "like it, having it or to do with it"
msgstr "схожий, наділений або пов’язаний"

msgid "Listen: Kalev and Kati"
msgstr "Послухай розмову Калева й Каті"

msgid "Listening only, no microphone"
msgstr "Лише слухання, без мікрофона"

msgid "local"
msgstr "місцевий"

msgid "Make the word"
msgstr "Утвори слово"

msgid "Match each word with its meaning."
msgstr "З’єднай кожне слово з його значенням."

msgid "Meaning"
msgstr "Значення"

msgid "mistake"
msgstr "помилка"

msgid "Muki was friendly from the first day."
msgstr "Мукі був дружнім із першого дня."

msgid "Nearly. Check the ending in the ones you missed."
msgstr "Перевір суфікси у відповідях із помилками."

msgid "Nearly. Check the stem in the ones you got wrong."
msgstr "Перевір основи слів у відповідях із помилками."

msgid "Nearly. Play the ones you got wrong once more."
msgstr "Майже. Ще раз послухай ті, де є помилка."

msgid "Nearly. Read the reason under each one you got wrong."
msgstr "Майже. Прочитай пояснення під кожною помилкою."

msgid "New words from nouns"
msgstr "Нові слова від іменників"

msgid "Now write to the owner in about 80 words, then compare your letter with a model."
msgstr "Напиши власникові листа приблизно на 80 слів і порівняй його зі зразком."

msgid "piece"
msgstr "шматок"

msgid "place"
msgstr "місце"

msgid "Read an advert for a summer cottage and answer the questions, as in the reading part of the B1 exam."
msgstr "Прочитай оголошення про оренду літнього будиночка й дай відповіді, як у завданні з читання на іспиті B1."

msgid "Read What to remember below, then try again."
msgstr "Прочитай «Що запам’ятати» нижче, потім спробуй знову."

msgid "Say what you’re writing about."
msgstr "Напиши, з якого приводу звертаєшся."

msgid "Sign off politely."
msgstr "Увічливо попрощайся."

msgid "Someone local who has seen a dog in the street"
msgstr "Хтось із місцевих, хто побачив собаку на вулиці"

msgid "Taking photos of the animals for the website"
msgstr "Фотографувати тварин для сайту"

msgid "Tap a form"
msgstr "Торкнися форми"

msgid "Tap the words for each ending once more, then try again."
msgstr "Ще раз прослухай слова з кожним суфіксом і повтори вправу."

msgid "Tap the words in the table once more, then try again."
msgstr "Ще раз прослухай слова в таблиці й повтори вправу."

msgid "tasteless"
msgstr "без смаку"

msgid "That’s sad."
msgstr "Сумно."

msgid "The adjective and noun are both genitive here: <0>kodutu kassi</0>."
msgstr "Тут іменник і прикметник у родовому: <0>kodutu kassi</0>."

msgid "The adjective and noun are both genitive here: <et>kodutu kassi</et>."
msgstr "Тут іменник і прикметник у родовому: <et>kodutu kassi</et>."

msgid "The adjective is plural like its noun: <0>kodutud koerad</0>."
msgstr "Іменник і прикметник тут у множині: <0>kodutud koerad</0>."

msgid "The adjective is plural like its noun: <et>kodutud koerad</et>."
msgstr "Іменник і прикметник тут у множині: <et>kodutud koerad</et>."

msgid "The adjective takes the genitive before <0>-ga</0>: <1>sõbraliku naisega</1>."
msgstr "Коли іменник має <0>-ga</0>, прикметник стоїть у родовому: <1>sõbraliku naisega</1>."

msgid "The adjective takes the genitive before <et>-ga</et>: <et>sõbraliku naisega</et>."
msgstr "Коли іменник має <et>-ga</et>, прикметник стоїть у родовому: <et>sõbraliku naisega</et>."

msgid "The beach is safe for children."
msgstr "Пляж безпечний для дітей."

msgid "The cottage has two rooms."
msgstr "У будиночку дві кімнати."

msgid "The genitive of <0>tükk</0> is <1>tüki</1>, so <2>tükike</2>."
msgstr "Родовий від <0>tükk</0> — <1>tüki</1>, звідси <2>tükike</2>."

msgid "The genitive of <0>viga</0> is <1>vea</1>, so <2>veatu</2>, without mistakes."
msgstr "Родовий від <0>viga</0> — <1>vea</1>, звідси <2>veatu</2> («без помилок»)."

msgid "The genitive of <et>tükk</et> is <et>tüki</et>, so <et>tükike</et>."
msgstr "Родовий від <et>tükk</et> — <et>tüki</et>, звідси <et>tükike</et>."

msgid "The genitive of <et>viga</et> is <et>vea</et>, so <et>veatu</et>."
msgstr "Родовий від <et>viga</et> — <et>vea</et>, звідси <et>veatu</et>."

msgid "The local shop is closed."
msgstr "Місцева крамниця зачинена."

msgid "The nearest neighbour lives a kilometre away"
msgstr "Найближчий сусід живе за кілометр"

msgid "The new neighbour is very friendly."
msgstr "Новий сусід дуже привітний."

msgid "The new word"
msgstr "Нове слово"

msgid "The new words are ordinary adjectives and nouns, so they agree as lesson {adjectives} showed: <0>kodutu kass</0>, <1>kodutu kassi</1>, <2>kodutud kassid</2>. Write each sentence in Estonian."
msgstr "Це звичайні іменники й прикметники. Вони узгоджуються, як в уроці {adjectives}: <0>kodutu kass</0>, <1>kodutu kassi</1>, <2>kodutud kassid</2>. Напиши кожне речення естонською."

msgid "The new words change like any adjective or noun: <0>sõbraliku naisega, kodutud koerad</0>."
msgstr "Нові слова відмінюються, як звичайні прикметники й іменники: <0>sõbraliku naisega, kodutud koerad</0>."

msgid "The noun"
msgstr "Іменник"

msgid "The owners of the animals"
msgstr "Власники тварин"

msgid "The partitive of <0>majake</0> is <1>majakest</1>."
msgstr "Партитив від <0>majake</0> — <1>majakest</1>."

msgid "The partitive of <et>majake</et> is <et>majakest</et>."
msgstr "Партитив від <et>majake</et> — <et>majakest</et>."

msgid "The police"
msgstr "Поліція"

msgid "The road is dangerous in winter."
msgstr "Узимку дорога небезпечна."

msgid "The sea is only two hundred metres away and cats can’t swim"
msgstr "До моря лише двісті метрів, а коти не вміють плавати"

msgid "The shelter is open every day."
msgstr "Притулок відчинений щодня."

msgid "The soup had no taste."
msgstr "Суп був геть без смаку."

msgid "There are more homeless animals in summer."
msgstr "Улітку бездомних тварин більше."

msgid "There’s no shop nearby"
msgstr "Поблизу немає крамниці"

msgid "There’s no television"
msgstr "Немає телевізора"

msgid "This soup is tasteless."
msgstr "Цей суп зовсім без смаку."

msgid "Three endings"
msgstr "Три закінчення"

msgid "Type the new word"
msgstr "Напиши нове слово"

msgid "unemployed"
msgstr "безробітний"

msgid "Use one word with -lik, -tu or -ke."
msgstr "Уживи одне слово на -lik, -tu або -ke."

msgid "Walking the dogs"
msgstr "Вигулювати собак"

msgid "We found a homeless cat."
msgstr "Ми знайшли бездомного кота."

msgid "We live in a small town."
msgstr "Ми живемо в невеликому місті."

msgid "What does it mean?"
msgstr "Що це означає?"

msgid "What does the advert say about a week?"
msgstr "Що в оголошенні сказано про оренду на тиждень?"

msgid "What does the ending add?"
msgstr "Якого значення додає суфікс?"

msgid "What else local does the shop sell besides bread? Write it as the advert does."
msgstr "Що ще місцевого продають у крамниці, крім хліба? Напиши, як в оголошенні."

msgid "What is the most important job for volunteers?"
msgstr "Що найважливіше в роботі волонтерів?"

msgid "What the ending adds"
msgstr "Що додає закінчення"

msgid "Where were the five kittens found? Write it as Kati says it."
msgstr "Де знайшли п’ятьох кошенят? Напиши словами Каті."

msgid "Who says it?"
msgstr "Хто це каже?"

msgid "Who usually calls the shelter?"
msgstr "Хто зазвичай телефонує до притулку?"

msgid "Why is it quiet there?"
msgstr "Чому там тихо?"

msgid "Why is the garden dangerous for cats?"
msgstr "Чим сад небезпечний для котів?"

msgid "without it"
msgstr "без чогось"

msgid "Without it"
msgstr "Без чогось"

msgid "Without taste is <0>-tu</0>: <1>maitsetu</1>."
msgstr "«Без смаку» утворюємо з <0>-tu</0>: <1>maitsetu</1>."

msgid "Word"
msgstr "Слово"

msgid "work"
msgstr "робота"

msgid "work, job"
msgstr "робота"

msgid "Write it in Estonian"
msgstr "Напиши естонською"

msgid "Write to the owner"
msgstr "Напиши власникові"

msgid "You can take an animal home on your first visit."
msgstr "Тварину можна забрати додому під час першого візиту."

msgid "You want to rent the cottage for a week in July. Ask if it’s free and ask two more questions."
msgstr "Ти хочеш орендувати будиночок на тиждень у липні. Запитай, чи він вільний, і постав іще два запитання."

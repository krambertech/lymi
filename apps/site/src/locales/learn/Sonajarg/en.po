msgid "<0>Ei</0> goes right before the verb, so the person can’t stand between them: <1>laupäeval ma ei tule</1>."
msgstr "<0>Ei</0> goes right before the verb, so the person can’t stand between them: <1>laupäeval ma ei tule</1>."

msgid "<0>Ei</0> goes right before the verb."
msgstr "<0>Ei</0> goes right before the verb."

msgid "<0>Läheme</0> takes second place, and <1>ujuma</1> goes last."
msgstr "<0>Läheme</0> takes second place, and <1>ujuma</1> goes last."

msgid "<0>Ma lähen täna Tartusse</0> is I’m going to Tartu today. Start it with <1>täna</1> instead, and the verb stays in second place while the person moves after it: <2/> <3>Tartusse</3>."
msgstr "<0>Ma lähen täna Tartusse</0> is I’m going to Tartu today. Start it with <1>täna</1> instead, and the verb stays in second place while the person moves after it: <2/> <3>Tartusse</3>."

msgid "<0>Pean</0> takes second place, and the other verb, <1>minema</1>, goes last."
msgstr "<0>Pean</0> takes second place, and the other verb, <1>minema</1>, goes last."

msgid "<0>Tahan</0> takes second place, and <1>lugeda</1> goes last."
msgstr "<0>Tahan</0> takes second place, and <1>lugeda</1> goes last."

msgid "16 minutes"
msgstr "16 minutes"

msgid "5 exercises, 2 of them typed, and a conversation"
msgstr "5 exercises, 2 of them typed, and a conversation"

msgid "A question works differently. After a question word from lesson {questions}, the short pronoun, such as <0>sa</0> or <1>te</1>, comes next and the verb after it: <2/>, where do you live? A question with <3>kas</3> puts <4>kas</4> in front of a plain statement: <5>Kas sa tuled homme?</5>"
msgstr "A question works differently. After a question word from lesson {questions}, the short pronoun, such as <0>sa</0> or <1>te</1>, comes next and the verb after it: <2/>, where do you live? A question with <3>kas</3> puts <4>kas</4> in front of a plain statement: <5>Kas sa tuled homme?</5>"


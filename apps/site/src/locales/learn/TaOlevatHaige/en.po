msgid "A question that starts with a question word keeps the word and drops <0>kas</0>: <1>Peeter küsis, millal ma tulen.</1> Tap a sentence to hear it."
msgstr "A question that starts with a question word keeps the word and drops <0>kas</0>: <1>Peeter küsis, millal ma tulen.</1> Tap a sentence to hear it."

msgid "A question word stays as it is: <0>kus</0>, where. There is no <1>kas</1> and no <2>et</2>."
msgstr "A question word stays as it is: <0>kus</0>, where. There is no <1>kas</1> and no <2>et</2>."

msgid "A statement after <0>rääkis</0> takes <1>et</1>. <2>Kas</2> is for yes-or-no questions."
msgstr "A statement after <0>rääkis</0> takes <1>et</1>. <2>Kas</2> is for yes-or-no questions."

msgid "A yes-or-no question after <0>küsis</0> takes <1>kas</1>, not <2>et</2>."
msgstr "A yes-or-no question after <0>küsis</0> takes <1>kas</1>, not <2>et</2>."

msgid "A yes-or-no question follows <0/> with <1>kas</1>, not <2>et</2>: <3>Mari küsis: „Kas sa tuled?“</3> becomes <4>Mari küsis, kas ma tulen.</4> The person changes as before."
msgstr "A yes-or-no question follows <0/> with <1>kas</1>, not <2>et</2>: <3>Mari küsis: „Kas sa tuled?“</3> becomes <4>Mari küsis, kas ma tulen.</4> The person changes as before."

msgid "A yes-or-no question follows <0>kas</0>, and a question word stays where it was."
msgstr "A yes-or-no question follows <0>kas</0>, and a question word stays where it was."

msgid "A yes-or-no question follows <0>küsis</0> with <1>kas</1>, not <2>et</2>."
msgstr "A yes-or-no question follows <0>küsis</0> with <1>kas</1>, not <2>et</2>."

msgid "A yes-or-no question follows <0>küsis</0> with <1>kas</1>: <2>Mari küsis, kas ma tulen.</2> A question word stays and <3>kas</3> goes: <4>Peeter küsis, millal ma tulen.</4>"
msgstr "A yes-or-no question follows <0>küsis</0> with <1>kas</1>: <2>Mari küsis, kas ma tulen.</2> A question word stays and <3>kas</3> goes: <4>Peeter küsis, millal ma tulen.</4>"

msgid "A yes-or-no question follows <et>küsis</et> with <et>kas</et>. A question word stays where it was."
msgstr "A yes-or-no question follows <et>küsis</et> with <et>kas</et>. A question word stays where it was."

msgid "A yes-or-no question keeps <0>kas</0>. Only the person changes: <1>sul</1> becomes <2>mul</2>."
msgstr "A yes-or-no question keeps <0>kas</0>. Only the person changes: <1>sul</1> becomes <2>mul</2>."


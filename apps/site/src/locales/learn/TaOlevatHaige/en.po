msgid "<0>{0}</0> {1}"
msgstr "<0>{0}</0> {1}"

msgid "<0>Ma</0> becomes <1>ta</1>, and the verb takes the new person’s ending: <2>tulen</2> becomes <3>tuleb</3>. <4>Homme</4> stays."
msgstr "<0>Ma</0> becomes <1>ta</1>, and the verb takes the new person’s ending: <2>tulen</2> becomes <3>tuleb</3>. <4>Homme</4> stays."

msgid "<0>Mida</0>, what, stays too. <1>Sa</1> becomes <2>ma</2>, and <3>teed</3> becomes <4>teen</4>."
msgstr "<0>Mida</0>, what, stays too. <1>Sa</1> becomes <2>ma</2>, and <3>teed</3> becomes <4>teen</4>."

msgid "<0>Mu</0>, my, becomes <1>tema</1>, his or her."
msgstr "<0>Mu</0>, my, becomes <1>tema</1>, his or her."

msgid "<0>Mul</0> becomes <1>tal</1> when the person is someone else."
msgstr "<0>Mul</0> becomes <1>tal</1> when the person is someone else."

msgid "<0>olema</0> without <1>-ma</1>, plus <2>-vat</2>: <3>olevat</3>."
msgstr "<0>olema</0> without <1>-ma</1>, plus <2>-vat</2>: <3>olevat</3>."

msgid "<0>Ta ütles, et tal on kiire</0> reports what someone said. <1>Ta olevat haige</1> passes on what is said about someone. Learn to make the first and to recognise the second."
msgstr "<0>Ta ütles, et tal on kiire</0> reports what someone said. <1>Ta olevat haige</1> passes on what is said about someone. Learn to make the first and to recognise the second."

msgid "<0>Ütles, et</0> and <1>rääkis, et</1> name who said it."
msgstr "<0>Ütles, et</0> and <1>rääkis, et</1> name who said it."

msgid "<0>Ütles, et</0> names the person. <1>-vat</1> usually names no one: it passes the news on."
msgstr "<0>Ütles, et</0> names the person. <1>-vat</1> usually names no one: it passes the news on."

msgid "<et>Ütles, et</et> and <et>rääkis, et</et> name who said it. <et>-vat</et> usually passes the news on without saying who said it."
msgstr "<et>Ütles, et</et> and <et>rääkis, et</et> name who said it. <et>-vat</et> usually passes the news on without saying who said it."


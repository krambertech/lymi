#. placeholder {0}: item.said
#. placeholder {1}: i18n._(TELL_MEANS[item.id])
msgid "<0>{0}</0> {1}"
msgstr "<0>{0}</0> {1}"

msgid "18 minutes"
msgstr "18 минут"

msgid "7 exercises"
msgstr "7 упражнений"

msgid "A friend sends bus details before a trip to Pärnu. Read and answer."
msgstr "Подруга присылает детали об автобусе перед поездкой в Пярну. Прочитай и ответь."

msgid "A ticket to a city takes the into form: <0>Tartusse</0>, not <1>Tartus</1>."
msgstr "Билет в город требует формы направления «куда»: <0>Tartusse</0>, а не <1>Tartus</1>."

msgid "All eight right."
msgstr "Все восемь верно."

msgid "All six found and fixed."
msgstr "Все шесть найдены и исправлены."

msgid "All six sentences right."
msgstr "Все шесть предложений верны."

msgid "Ask for directions and buy a ticket: <0>otse</0> (straight ahead), <1>vasakule</1> and <2>paremale</2> for turning, <3>vasakul</3> and <4>paremal</4> for which side something is on, and everyday station phrases."
msgstr "Спроси дорогу и купи билет: <0>otse</0> (прямо), <1>vasakule</1> и <2>paremale</2> для поворота, <3>vasakul</3> и <4>paremal</4> для того, с какой стороны что-то находится, и повседневные фразы на вокзале."

msgid "Ask the way"
msgstr "Спроси дорогу"

msgid "Asking where something is uses <0>Kus</0>, not <1>Kuhu</1>."
msgstr "Чтобы спросить, где что-то находится, нужно слово <0>Kus</0>, а не <1>Kuhu</1>."

msgid "At a station or stop, three words come up right away: <0/>, <1/> and <2/>."
msgstr "На вокзале или остановке сразу пригодятся три слова: <0/>, <1/> и <2/>."

msgid "At eleven o’clock"
msgstr "В одиннадцать часов"

msgid "At her own home"
msgstr "У себя дома"

msgid "At nine o’clock"
msgstr "В девять утра"

msgid "At seven at night"
msgstr "В семь вечера"

msgid "At the station: <et>pilet, peatus, jaam</et>"
msgstr "На вокзале: <et>pilet, peatus, jaam</et>"

msgid "At the train station"
msgstr "На железнодорожном вокзале"

msgid "Behind the café"
msgstr "За кофейней"

msgid "Bus to Pärnu"
msgstr "Автобус в Пярну"

msgid "Check the table above, then try again."
msgstr "Загляни в таблицу выше и попробуй ещё раз."

msgid "Clerk"
msgstr "Кассир"

msgid "Directions follow the same <0>-le</0> / <1>-l</1> pattern from lesson {surface}: <2/> and <3/> mean turning toward a side, while <4/> and <5/> say which side a place is on. Straight ahead is <6/>."
msgstr "Направления строятся по той же схеме <0>-le</0> / <1>-l</1> из урока {surface}: <2/> и <3/> означают поворот в сторону, а <4/> и <5/> говорят, с какой стороны находится место. Прямо — <6/>."

msgid "Directions in Estonian"
msgstr "Направления по-эстонски"

msgid "Each sentence has one wrong direction or place word. Tap the wrong word, then type the right one."
msgstr "В каждом предложении одно слово направления или места неверное. Нажми на него и впиши правильное."

msgid "Estonian"
msgstr "По-эстонски"

msgid "Fix the sentence"
msgstr "Исправь предложение"

msgid "Go straight ahead (polite)."
msgstr "Идите прямо (вежливо)."

msgid "Go to the left at the park."
msgstr "Иди налево у парка."

msgid "Hear each sentence and decide whether it tells you which way to turn (<0>-le</0>) or which side a place is on (<1>-l</1>)."
msgstr "Послушай каждое предложение и реши, подсказывает ли оно, куда повернуть (<0>-le</0>), или с какой стороны находится место (<1>-l</1>)."

msgid "How many euros does the ticket cost? Write the number word as the clerk says it."
msgstr "Сколько евро стоит билет? Напиши числительное словом, как говорит кассир."

msgid "In a sentence"
msgstr "В предложении"

msgid "In ten minutes"
msgstr "Через десять минут"

msgid "In twenty minutes"
msgstr "Через двадцать минут"

msgid "In two full hours"
msgstr "Через два полных часа"

msgid "Jaam on paremal."
msgstr "Вокзал справа."

msgid "Kind"
msgstr "Значение"

msgid "Kohvik on vasakul."
msgstr "Кафе слева."

msgid "Kus on bussipeatus?"
msgstr "Где автобусная остановка?"

msgid "Left, right and straight ahead"
msgstr "Налево, направо и прямо"

msgid "Listen: at the ticket desk"
msgstr "Послушай: у кассы"

msgid "Listening only, no microphone"
msgstr "Только аудио, без микрофона"

msgid "Location"
msgstr "Расположение"

msgid "Location (which side)"
msgstr "Расположение (с какой стороны)"

msgid "Location: <et>vasakul, paremal</et>"
msgstr "Расположение: <et>vasakul, paremal</et>"

msgid "Mart"
msgstr "Март"

msgid "Mart buys a return ticket for the same evening."
msgstr "Март покупает билет туда и обратно на тот же вечер."

msgid "Mart buys a train ticket to Tartu at the station. Listen and answer. You can play the conversation twice."
msgstr "Март покупает на вокзале билет на поезд в Тарту. Послушай и ответь. Разговор можно включить дважды."

msgid "Mart pays by card."
msgstr "Март платит картой."

msgid "Match each Estonian travel word with its meaning."
msgstr "Соедини каждое эстонское слово для поездки с его значением."

msgid "Meaning"
msgstr "Значение"

msgid "Minge otse edasi."
msgstr "Идите прямо вперёд."

msgid "Near a big hotel"
msgstr "У большого отеля"

msgid "Bus stop on the left (where)"
msgstr "Остановка слева (где)"

msgid "Nearly. Check the direction ending in the ones you missed."
msgstr "Почти. Проверь окончание направления там, где была ошибка."

msgid "Nearly. Listen for -le versus -l at the end."
msgstr "Почти. Прислушайся к окончанию -le против -l в конце."

msgid "Nearly. Read the reason under each one you missed."
msgstr "Почти. Прочитай объяснение под каждым предложением с ошибкой."

msgid "on the left"
msgstr "слева (где)"

msgid "On the left (where)"
msgstr "Слева (где)"

msgid "On the left side"
msgstr "Слева от входа"

msgid "on the right"
msgstr "справа (где)"

msgid "On the right (where)"
msgstr "Справа (где)"

msgid "On the right side"
msgstr "С правой стороны"

msgid "On the street"
msgstr "На улице"

msgid "One ticket to Tartu, please."
msgstr "Один билет в Тарту, пожалуйста."

msgid "Palun üks pilet Tartusse."
msgstr "Пожалуйста, один билет в Тарту."

msgid "Passer-by"
msgstr "Прохожий"

msgid "Pöörake paremale."
msgstr "Поверните направо."

msgid "Pöörake vasakule."
msgstr "Поверните налево."

msgid "Read What to remember below, then try again."
msgstr "Прочитай «Что запомнить» ниже и попробуй ещё раз."

msgid "Right by the park"
msgstr "У парка"

msgid "Rongijaam on siin lähedal."
msgstr "Железнодорожный вокзал здесь рядом."

msgid "Saying which side a place is on takes <0>-l</0>: <1>Kohvik on vasakul</1>, <2>Jaam on paremal</2>."
msgstr "Чтобы сказать, с какой стороны место, нужно окончание <0>-l</0>: <1>Kohvik on vasakul</1>, <2>Jaam on paremal</2>."

msgid "Saying which side a place is on takes <et>-l</et>: <et>Kohvik on vasakul</et>, <et>Jaam on paremal</et>."
msgstr "Чтобы сказать, с какой стороны место, нужно окончание <et>-l</et>: <et>Kohvik on vasakul</et>, <et>Jaam on paremal</et>."

msgid "Saying which side something is on takes <0>-l</0>: <1>paremal</1>, not <2>paremale</2>."
msgstr "Чтобы сказать, с какой стороны что-то находится, нужно <0>-l</0>: <1>paremal</1>, а не <2>paremale</2>."

msgid "Saying which side something is on takes <0>-l</0>: <1>vasakul</1> (on the left) and <2>paremal</2> (on the right)."
msgstr "Чтобы сказать, с какой стороны что-то находится, нужно <0>-l</0>: <1>vasakul</1> (слева) и <2>paremal</2> (справа)."

msgid "Saying which side something is on takes <0>-l</0>: <1>vasakul</1>, not <2>vasakule</2>."
msgstr "Чтобы сказать, с какой стороны что-то находится, нужно <0>-l</0>: <1>vasakul</1>, а не <2>vasakule</2>."

msgid "station"
msgstr "вокзал, станция"

msgid "stop (bus, tram)"
msgstr "остановка"

msgid "straight ahead"
msgstr "прямо"

msgid "Straight ahead"
msgstr "Прямо"

msgid "Tap a word"
msgstr "Нажми на слово"

msgid "That asks for coffee, not directions to the station."
msgstr "Это просьба дать кофе, а не вопрос о дороге к вокзалу."

msgid "That asks their name rather than how far the station is."
msgstr "Это вопрос об имени, а не о том, далеко ли вокзал."

msgid "That asks what time it is, not which side the station is on."
msgstr "Это вопрос о времени, а не о том, с какой стороны вокзал."

msgid "That says where you live instead of asking for the railway station."
msgstr "Эта фраза о том, где ты живёшь, а не вопрос о железнодорожном вокзале."

msgid "That says you do not know, instead of checking whether the station is on the right."
msgstr "Это значит «я не знаю», а не уточнение, справа ли вокзал."

msgid "The bus stop is on the left."
msgstr "Автобусная остановка слева."

msgid "The café is on the left."
msgstr "Кафе слева."

msgid "The passer-by is not selling tickets; ask whether it is far."
msgstr "Прохожий не продаёт билеты; спроси, далеко ли идти."

msgid "The shop is on the right."
msgstr "Магазин справа."

msgid "The station is on the right."
msgstr "Вокзал справа."

msgid "There is a small kiosk next to the waiting hall."
msgstr "Рядом с залом ожидания есть небольшой киоск."

msgid "They will take a taxi from Pärnu bus station to the beach."
msgstr "Они поедут на такси от автовокзала Пярну к пляжу."

msgid "ticket"
msgstr "билет"

msgid "To a stranger on the street, Estonians usually use polite <0>te</0> commands: <1>Minge otse</1> (go straight), <2>Pöörake vasakule</2> (turn left)."
msgstr "К незнакомцу на улице в Эстонии обычно обращаются вежливо на <0>te</0>: <1>Minge otse</1> (идите прямо), <2>Pöörake vasakule</2> (поверните налево)."

msgid "to Tartu"
msgstr "в Тарту"

msgid "to the left"
msgstr "налево (куда)"

msgid "to the right"
msgstr "направо (куда)"

msgid "Track four on the left"
msgstr "Четвёртый путь слева"

msgid "Track one by the exit"
msgstr "Первый путь у выхода"

msgid "Track two on the right"
msgstr "Второй путь справа"

msgid "Trip details"
msgstr "Детали поездки"

msgid "Turn left (polite)."
msgstr "Поверните налево (вежливо)."

msgid "Turn left (where to)"
msgstr "Поверни налево (куда)"

msgid "Turn left!"
msgstr "Поверни налево!"

msgid "Turn right (where to)"
msgstr "Поверни направо (куда)"

msgid "Turn right at the school."
msgstr "Поверни направо у школы."

msgid "Turn right!"
msgstr "Поверни направо!"

msgid "Turning"
msgstr "Поворот"

msgid "Turning (where to)"
msgstr "Поворот (куда)"

msgid "Turning or location?"
msgstr "Поворот или расположение?"

msgid "Turning takes <0>-le</0>: <1>paremale</1>, not <2>paremal</2>."
msgstr "Поворот требует <0>-le</0>: <1>paremale</1>, а не <2>paremal</2>."

msgid "Turning takes <0>-le</0>: <1>Pöörake vasakule</1> (turn left), <2>Pöörake paremale</2> (turn right); straight ahead is <3>otse</3>."
msgstr "Поворот требует <0>-le</0>: <1>Pöörake vasakule</1> (поверните налево), <2>Pöörake paremale</2> (поверните направо); прямо — <3>otse</3>."

msgid "Turning takes <0>-le</0>: <1>vasakule</1> (to the left) and <2>paremale</2> (to the right)."
msgstr "Поворот требует <0>-le</0>: <1>vasakule</1> (налево) и <2>paremale</2> (направо)."

msgid "Turning takes <0>-le</0>: <1>vasakule</1>, not <2>vasakul</2>."
msgstr "Поворот требует <0>-le</0>: <1>vasakule</1>, а не <2>vasakul</2>."

msgid "Turning toward a side takes <et>-le</et>: <et>Pöörake vasakule</et>, <et>Pöörake paremale</et>."
msgstr "Поворот в сторону требует <et>-le</et>: <et>Pöörake vasakule</et>, <et>Pöörake paremale</et>."

msgid "Turning: <et>otse, vasakule, paremale</et>"
msgstr "Поворот: <et>otse, vasakule, paremale</et>"

msgid "Useful station phrases: <et>Kus on bussipeatus?</et>, <et>Palun üks pilet Tartusse.</et>, <et>Mis kell rong väljub?</et>"
msgstr "Полезные фразы на вокзале: <et>Kus on bussipeatus?</et>, <et>Palun üks pilet Tartusse.</et>, <et>Mis kell rong väljub?</et>"

msgid "Useful travel questions: <0>Kus on bussipeatus?</0>, <1>Palun üks pilet Tartusse.</1>, <2>Mis kell rong väljub?</2>"
msgstr "Полезные фразы в дороге: <0>Kus on bussipeatus?</0>, <1>Palun üks pilet Tartusse.</1>, <2>Mis kell rong väljub?</2>"

msgid "Wait until the station to buy a ticket."
msgstr "Билет купишь уже на вокзале."

msgid "What does each word mean?"
msgstr "Что означает каждое слово?"

msgid "What time does the bus to Pärnu leave? Write two words from the message."
msgstr "Во сколько отправляется автобус в Пярну? Напиши два слова из сообщения."

msgid "What time does the train leave?"
msgstr "Во сколько отправляется поезд?"

msgid "When does the bus reach Pärnu?"
msgstr "Когда автобус прибывает в Пярну?"

msgid "When does the next train leave?"
msgstr "Когда отправляется следующий поезд?"

msgid "Where does the train leave from?"
msgstr "Откуда отправляется поезд?"

msgid "Where is Mari waiting in Pärnu?"
msgstr "Где Мари ждёт в Пярну?"

msgid "Where is the bus stop?"
msgstr "Где автобусная остановка?"

msgid "Which city is Mart buying a train ticket to? Write one word as he says it."
msgstr "В какой город Март покупает билет на поезд? Напиши одно слово так, как он его говорит."

msgid "Which side is platform four on?"
msgstr "С какой стороны четвёртая платформа?"

msgid "Word"
msgstr "Слово"

msgid "Write each travel phrase in Estonian."
msgstr "Напиши каждую фразу для поездки по-эстонски."

msgid "Write it in Estonian"
msgstr "Напиши по-эстонски"

msgid "You already have the directions — thank the person and say goodbye."
msgstr "Дорогу тебе уже объяснили — поблагодари и попрощайся."

msgid "You are asking a passer-by for the way to the railway station."
msgstr "Ты спрашиваешь у прохожего дорогу к железнодорожному вокзалу."

msgid "You are looking for the railway station. Listen to the passer-by and pick the right reply."
msgstr "Ты ищешь железнодорожный вокзал. Послушай прохожего и выбери правильный ответ."

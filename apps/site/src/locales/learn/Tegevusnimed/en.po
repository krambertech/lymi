msgid "<0/> <1/> Lesson {going} explains what the <2>-ma</2> infinitive means after <3>lähen</3>. Tap a verb to hear it in a sentence."
msgstr "<0/> <1/> Lesson {going} explains what the <2>-ma</2> infinitive means after <3>lähen</3>. Tap a verb to hear it in a sentence."

msgid "<0/> takes the <1>-ma</1> infinitive, and so do <2/>, <3/>, <4/> and <5/>."
msgstr "<0/> takes the <1>-ma</1> infinitive, and so do <2/>, <3/>, <4/> and <5/>."

msgid "<0/>, <1/> and <2/> can all translate as I can. Lesson {canMay} tells them apart; the form after them is the same."
msgstr "<0/>, <1/> and <2/> can all translate as I can. Lesson {canMay} tells them apart; the form after them is the same."

msgid "<0/>, I like, is the eighth: <1/> Tap a verb to hear it in a sentence."
msgstr "<0/>, I like, is the eighth: <1/> Tap a verb to hear it in a sentence."

msgid "<0/>, to learn, takes the <1>-ma</1> infinitive when you learn to do something: <2/>"
msgstr "<0/>, to learn, takes the <1>-ma</1> infinitive when you learn to do something: <2/>"

msgid "<0>Ma tahan lugeda</0> is I want to read, and <1>Ma pean lugema</1> is I have to read. The first verb decides whether the second takes its <2>-da</2> or its <3>-ma</3> infinitive."
msgstr "<0>Ma tahan lugeda</0> is I want to read, and <1>Ma pean lugema</1> is I have to read. The first verb decides whether the second takes its <2>-da</2> or its <3>-ma</3> infinitive."

msgid "<0>Mulle meeldib</0> is I like. Lesson {liking} explains how it works."
msgstr "<0>Mulle meeldib</0> is I like. Lesson {liking} explains how it works."

msgid "<0>Pean, hakkan, lähen, tule</0> and <1>jään</1> take the <2>-ma</2> infinitive."
msgstr "<0>Pean, hakkan, lähen, tule</0> and <1>jään</1> take the <2>-ma</2> infinitive."

msgid "<0>Tahan, võin, saan, oskan, tohin, proovin, armastan</0> and <1>mulle meeldib</1> take the <2>-da</2> infinitive."
msgstr "<0>Tahan, võin, saan, oskan, tohin, proovin, armastan</0> and <1>mulle meeldib</1> take the <2>-da</2> infinitive."

msgid "12 minutes"
msgstr "12 minutes"

msgid "A sort, sentences to build and a message to fill in"
msgstr "A sort, sentences to build and a message to fill in"

msgid "After <0/>, I want, comes the <1>-da</1> infinitive: <2/> After <3/>, I have to, comes the <4>-ma</4> infinitive: <5/>"
msgstr "After <0/>, I want, comes the <1>-da</1> infinitive: <2/> After <3/>, I have to, comes the <4>-ma</4> infinitive: <5/>"

msgid "After <0>{lead}</0>, the <1>-da</1> infinitive, and it goes last."
msgstr "After <0>{lead}</0>, the <1>-da</1> infinitive, and it goes last."

msgid "After <0>{lead}</0>, the <1>-ma</1> infinitive, and it goes last."
msgstr "After <0>{lead}</0>, the <1>-ma</1> infinitive, and it goes last."

msgid "After <0>mulle meeldib</0>, the <1>-da</1> infinitive."
msgstr "After <0>mulle meeldib</0>, the <1>-da</1> infinitive."

msgid "After <0>pean</0>, the <1>-ma</1> infinitive, even with words between."
msgstr "After <0>pean</0>, the <1>-ma</1> infinitive, even with words between."

msgid "After <0>pean</0>, the <1>-ma</1> infinitive."
msgstr "After <0>pean</0>, the <1>-ma</1> infinitive."

msgid "After <0>tahad</0>, from <1>tahtma</1>, the <2>-da</2> form."
msgstr "After <0>tahad</0>, from <1>tahtma</1>, the <2>-da</2> form."

msgid "After <0>tahan</0>, <1>pean</1> and the other verbs in this lesson, the second verb takes its <2>-da</2> or <3>-ma</3> infinitive: <4>Ma tahan lugeda. Ma pean lugema.</4>"
msgstr "After <0>tahan</0>, <1>pean</1> and the other verbs in this lesson, the second verb takes its <2>-da</2> or <3>-ma</3> infinitive: <4>Ma tahan lugeda. Ma pean lugema.</4>"

msgid "After <0>tahan</0>, the <1>-da</1> infinitive."
msgstr "After <0>tahan</0>, the <1>-da</1> infinitive."

msgid "All three. Each second verb took the right form and went last."
msgstr "All three. Each second verb took the right form and went last."

msgid "Build each sentence from what it means. One tile is the wrong form of the second verb and stays out."
msgstr "Build each sentence from what it means. One tile is the wrong form of the second verb and stays out."

msgid "Build the sentence"
msgstr "Build the sentence"

msgid "Check which form each second verb takes and where it goes, then try again."
msgstr "Check which form each second verb takes and where it goes, then try again."


msgid "<0/> asks <1>kellele?</1>, so you phone to someone: <2>mulle</2>, <3>sulle</3>, <4>teile</4>. For what already happened, use the past: <5>helistasin</5>, as in lesson {past}. For what will happen, the present with a time word such as <6/> is usually enough: <7>helistan</7> <8>homme</8>."
msgstr "<0/> asks <1>kellele?</1>, so you phone to someone: <2>mulle</2>, <3>sulle</3>, <4>teile</4>. For what already happened, use the past: <5>helistasin</5>, as in lesson {past}. For what will happen, the present with a time word such as <6/> is usually enough: <7>helistan</7> <8>homme</8>."

msgid "<0>Eile</0>, yesterday, needs the past: <1>helistasin</1>."
msgstr "<0>Eile</0>, yesterday, needs the past: <1>helistasin</1>."

msgid "<0>Helistama</0> asks <1>kellele?</1>: <2>mulle</2>, <3>sulle</3>, <4>teile</4>. The past is <5>helistasin</5>, and the present with a time word usually says the future: <6>helistan homme</6>."
msgstr "<0>Helistama</0> asks <1>kellele?</1>: <2>mulle</2>, <3>sulle</3>, <4>teile</4>. The past is <5>helistasin</5>, and the present with a time word usually says the future: <6>helistan homme</6>."

msgid "<0>Helistama</0> asks <1>kellele?</1>: <2>mulle</2>."
msgstr "<0>Helistama</0> asks <1>kellele?</1>: <2>mulle</2>."

msgid "<0>Homme</0>, tomorrow, takes the present: <1>helistan</1>."
msgstr "<0>Homme</0>, tomorrow, takes the present: <1>helistan</1>."

msgid "<0>Mardist</0> is about Mart. To speak with him, use <1>Mardiga</1>."
msgstr "<0>Mardist</0> is about Mart. To speak with him, use <1>Mardiga</1>."

msgid "<0>Palun</0> answers a thank you, and Kati has not thanked you. Say <1>aitäh</1>."
msgstr "<0>Palun</0> answers a thank you, and Kati has not thanked you. Say <1>aitäh</1>."

msgid "<0>Rääkima</0> asks <1>kellega?</1>, so the name takes <2>ga</2>: <3>Kas ma saaksin rääkida Mardiga?</3>"
msgstr "<0>Rääkima</0> asks <1>kellega?</1>, so the name takes <2>ga</2>: <3>Kas ma saaksin rääkida Mardiga?</3>"

msgid "<0>Rääkima</0> asks <1>kellega?</1>, so the name takes <2>ga</2>: <3>Mardiga</3>."
msgstr "<0>Rääkima</0> asks <1>kellega?</1>, so the name takes <2>ga</2>: <3>Mardiga</3>."

msgid "<0>Te</0> is you to one person you don’t know well, as in lesson {pronouns}. The command for <1>te</1> usually ends in <2>ge</2>: <3>rääkige</3>, <4>helistage</4>."
msgstr "<0>Te</0> is you to one person you don’t know well, as in lesson {pronouns}. The command for <1>te</1> usually ends in <2>ge</2>: <3>rääkige</3>, <4>helistage</4>."

msgid "<0>Teie</0> is Kati’s word for your. You give your own number: <1>minu</1>."
msgstr "<0>Teie</0> is Kati’s word for your. You give your own number: <1>minu</1>."

msgid "<0>Tere</0> is hello. The call is ending, so say <1>head aega</1>."
msgstr "<0>Tere</0> is hello. The call is ending, so say <1>head aega</1>."

msgid "<et>Helistama</et> asks <et>kellele?</et>: <et>mulle</et>, <et>sulle</et>, <et>teile</et>."
msgstr "<et>Helistama</et> asks <et>kellele?</et>: <et>mulle</et>, <et>sulle</et>, <et>teile</et>."


msgid "<0>Nad</0> takes <1>vad</1>: <2>nad hakkavad</2>."
msgstr "<0>Nad</0> takes <1>vad</1>: <2>nad hakkavad</2>."

msgid "<0>Saab olema</0> means will be. You’ll hear it, and the present usually says the same: <1>Homme on külm.</1>"
msgstr "<0>Saab olema</0> means will be. You’ll hear it, and the present usually says the same: <1>Homme on külm.</1>"

msgid "<0>Täna</0> is today. Kati asked about tomorrow."
msgstr "<0>Täna</0> is today. Kati asked about tomorrow."

msgid "<0>Töötasin</0> is the past. The job in Tallinn hasn’t started yet."
msgstr "<0>Töötasin</0> is the past. The job in Tallinn hasn’t started yet."


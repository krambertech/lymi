msgstr "<0>Kes</0> asks who, so a person answers it."

msgid "<0>Kus</0> asks where, so a place answers it."
msgstr "<0>Kus</0> asks where, so a place answers it."

msgid "<0>Kust</0> asks where you’re from, not where you live."
msgstr "<0>Kust</0> asks where you’re from, not where you live."

msgid "<0>Ma ei tea</0> is I don’t know. <1>Kuidas läheb?</1> asks how you are."
msgstr "<0>Ma ei tea</0> is I don’t know. <1>Kuidas läheb?</1> asks how you are."


msgid "<0/> and <1/> both translate as to read. Estonian uses each after different words: after <2/>, I want, comes the <3>-da</3> infinitive, <4/>. Lesson {infinitives} shows which words take which."
msgstr "<0/> and <1/> both translate as to read. Estonian uses each after different words: after <2/>, I want, comes the <3>-da</3> infinitive, <4/>. Lesson {infinitives} shows which words take which."

msgid "<0/> and <1/> change their long vowel: <2/>, <3/>. Learn these four whole."
msgstr "<0/> and <1/> change their long vowel: <2/>, <3/>. Learn these four whole."

msgid "<0/>, <1/> and <2/> drop <3>-ema</3> and add <4>-la</4> or <5>-na</5>, repeating the l or n: <6/>, <7/>, <8/>."
msgstr "<0/>, <1/> and <2/> drop <3>-ema</3> and add <4>-la</4> or <5>-na</5>, repeating the l or n: <6/>, <7/>, <8/>."

msgid "<0>-da</0> infinitive"
msgstr "<0>-da</0> infinitive"

msgid "<0>-ma</0> infinitive"
msgstr "<0>-ma</0> infinitive"

msgid "<0>{said}</0> is the <1>-da</1> infinitive of <2>{ma}</2>, {means}."
msgstr "<0>{said}</0> is the <1>-da</1> infinitive of <2>{ma}</2>, {means}."

msgid "<0>{said}</0> is the <1>-ma</1> infinitive itself, {means}."
msgstr "<0>{said}</0> is the <1>-ma</1> infinitive itself, {means}."

msgid "<0>{said}</0> is the present of <1>{ma}</1>, {means}."
msgstr "<0>{said}</0> is the present of <1>{ma}</1>, {means}."

msgid "<0>Sööma</0> and <1>jooma</1> break the pattern. Their commands build on the present: <2>söön, sööge</2>; <3>joon, jooge</3>."
msgstr "<0>Sööma</0> and <1>jooma</1> break the pattern. Their commands build on the present: <2>söön, sööge</2>; <3>joon, jooge</3>."

msgid "<0>Teha, näha, süüa</0> and <1>juua</1> end in a bare <2>-a</2> and change their stem. Learn these four whole."
msgstr "<0>Teha, näha, süüa</0> and <1>juua</1> end in a bare <2>-a</2> and change their stem. Learn these four whole."

msgid "12 minutes"
msgstr "12 minutes"

msgid "3 quizzes and a passage"
msgstr "3 quizzes and a passage"

msgid "A command again, built on the <0>-da</0> infinitive: <1>rääkida, rääkige</1>."
msgstr "A command again, built on the <0>-da</0> infinitive: <1>rääkida, rääkige</1>."

msgid "A command to the class, built on the <0>-da</0> infinitive: <1>istuda, istuge</1>."
msgstr "A command to the class, built on the <0>-da</0> infinitive: <1>istuda, istuge</1>."

msgid "A command, built on the <0>-da</0> infinitive: <1>lugeda, lugege</1>."
msgstr "A command, built on the <0>-da</0> infinitive: <1>lugeda, lugege</1>."

msgid "A question about what the class does, so the present: <0>räägin, räägite</0>."
msgstr "A question about what the class does, so the present: <0>räägin, räägite</0>."

msgid "All nine. You knew which verb each <0>-da</0> infinitive belongs to."
msgstr "All nine. You knew which verb each <0>-da</0> infinitive belongs to."

msgid "All six. You made every kind of <0>-da</0> infinitive."
msgstr "All six. You made every kind of <0>-da</0> infinitive."

msgid "All six. You told the three forms apart every time."
msgstr "All six. You told the three forms apart every time."

msgid "Be. To more than one, or polite."
msgstr "Be. To more than one, or polite."

msgid "Come. To more than one, or polite."
msgstr "Come. To more than one, or polite."

msgid "Commands for more than one"
msgstr "Commands for more than one"

msgid "Do it. To more than one, or polite."
msgstr "Do it. To more than one, or polite."

msgid "Fill the gaps"
msgstr "Fill the gaps"

msgid "Four short verbs"
msgstr "Four short verbs"

msgid "From tahtma, to want."
msgstr "From tahtma, to want."

msgid "Go back through the forms above, then try again."
msgstr "Go back through the forms above, then try again."

msgid "Hear a <0>-da</0> infinitive and pick what its verb means. These are the ones that look least like their <1>-ma</1> infinitive."
msgstr "Hear a <0>-da</0> infinitive and pick what its verb means. These are the ones that look least like their <1>-ma</1> infinitive."

msgid "Hear one form of a verb and pick which of the three it was. Listen to how it ends."
msgstr "Hear one form of a verb and pick which of the three it was. Listen to how it ends."

msgid "Here are the ten verbs of lesson {present} with their three forms. The <0>-da</0> infinitive is outlined. Tap a form to hear it."
msgstr "Here are the ten verbs of lesson {present} with their three forms. The <0>-da</0> infinitive is outlined. Tap a form to hear it."


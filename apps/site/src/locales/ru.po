msgstr "Начать со слов A1"

msgid "Start with A1."
msgstr "Начни с A1."

msgid "Start with chapter one."
msgstr "Начни с первой главы."

msgid "Start with everyday phrases"
msgstr "Начать с бытовых фраз"

msgid "Start with HSK 1"
msgstr "Начать с HSK 1"

msgid "Start with HSK 1."
msgstr "Начни с HSK 1."


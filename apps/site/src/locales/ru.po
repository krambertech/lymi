msgid "<0>{0}</0>: <1>{1}</1>"
msgstr "<0>{0}</0>: <1>{1}</1>"

msgid "<0>{base}</0> becomes <1>{form}</1>"
msgstr "<0>{base}</0> становится <1>{form}</1>"

msgid "<0>{before}</0> blank <1>{after}</1>"
msgstr "<0>{before}</0> пропуск <1>{after}</1>"

msgid "<0>{plannedCount}</0> planned, A1 to B1"
msgstr "Запланировано: <0>{plannedCount}</0>, от A1 до B1"

msgid "<0>{said}</0> is the <1>-da</1> form of <2>{ma}</2>, {means}."
msgstr "<0>{said}</0> — форма на <1>-da</1> от <2>{ma}</2>, «{means}»."

msgid "<0>{said}</0> is the <1>-ma</1> form itself, {means}."
msgstr "<0>{said}</0> — это сама форма на <1>-ma</1>, «{means}»."

msgid "<0>{said}</0> is the genitive of <1>{word}</1>, {means}."
msgstr "<0>{said}</0> — родительный от <1>{word}</1>: {means}."

msgid "<0>{said}</0> is the I form of <1>{ma}</1>, {means}."
msgstr "<0>{said}</0> — форма для «я» от <1>{ma}</1>, «{means}»."

msgid "<0>{said}</0> is the third form of <1>{word}</1>, {means}."
msgstr "<0>{said}</0> — третья форма от <1>{word}</1>: {means}."

#. placeholder {0}: means(text, i18n)
msgid "<0>{text}</0>, {0}"
msgstr "<0>{text}</0>, {0}"

#. placeholder {0}: means(text, i18n)
msgid "<0>{text}</0>, {0}; its third form is <1>maja</1> too, so it looks the same."
msgstr "<0>{text}</0>, {0}; третья форма тоже <1>maja</1>, поэтому слово не меняется."

msgid "<0>Active transport</0> moves substances against the gradient."
msgstr "<0>Активный транспорт</0> переносит вещества против градиента."

msgid "<0>Aiko</0> finished Week 3"
msgstr "<0>Aiko</0> прошла неделю 3"

msgid "<0>Ära</0> before the stem"
msgstr "<0>Ära</0> перед основой"

msgid "<0>b</0> now, only <1>s</1> in the past."
msgstr "<0>b</0> сейчас, в прошлом только <1>s</1>."

msgid "<0>d</0> now, <1>sid</1> in the past."
msgstr "<0>d</0> сейчас, <1>sid</1> в прошлом."

msgid "<0>da</0> gives way to <1>nud</1>."
msgstr "<0>da</0> меняется на <1>nud</1>."

msgid "<0>Diffusion</0>: particles move from high to low concentration."
msgstr "<0>Диффузия</0>: частицы движутся от высокой концентрации к низкой."

msgid "<0>E–R</0> on a sign: Monday to Friday."
msgstr "<0>E–R</0> на табличке: с понедельника по пятницу."

msgid "<0>Ei loe</0> is now, <1>ei lugenud</1> the past. <2>Ei olnud</2>, or <3>polnud</3>, is wasn’t."
msgstr "<0>Ei loe</0> — сейчас, <1>ei lugenud</1> — в прошлом. <2>Ei olnud</2>, или <3>polnud</3>, — «не был»."

msgid "<0>Ei meeldi</0> for both"
msgstr "<0>Ei meeldi</0> в обоих случаях"

msgid "<0>Ei meeldi</0> is the same for one thing or more."
msgstr "<0>Ei meeldi</0> — и когда что-то одно, и когда несколько."

msgid "<0>Ei ole</0> in one word"
msgstr "<0>Ei ole</0> одним словом"

msgid "<0>Ei ole</0> is now. For yesterday, say <1>ei olnud</1>."
msgstr "<0>Ei ole</0> — это сейчас. Про вчера говорят <1>ei olnud</1>."

msgid "<0>Ei oska</0> says you never learned. You learned as a child."
msgstr "<0>Ei oska</0> значит, что ты не умеешь. А тебя научили ещё в детстве."

msgid "<0>Ei pea</0> is don’t have to, and <1>ei tohi</1> is mustn’t: <2>Sa ei pea tulema. Sa ei tohi tulla.</2>"
msgstr "<0>Ei pea</0> — это «не обязательно», а <1>ei tohi</1> — «нельзя»: <2>Sa ei pea tulema. Sa ei tohi tulla.</2>"

msgid "<0>Ei pea</0> says you don’t have to work. You do work tomorrow."
msgstr "<0>Ei pea</0> значит, что работать тебе не обязательно. А завтра ты работаешь."

msgid "<0>Ei saa</0> says something stops you. She asked whether you know how."
msgstr "<0>Ei saa</0> значит, что тебе что-то мешает. А она спросила, умеешь ли ты."

msgid "<0>Ei tohi</0> says you’re not allowed to swim. Nothing stops you today."
msgstr "<0>Ei tohi</0> значит, что тебе нельзя плавать. А сегодня тебе ничто не мешает."

msgid "<0>Ei</0> before the verb, and the ending is gone: <1>ei {stem}</1>."
msgstr "<0>Ei</0> перед глаголом, а окончание пропало: <1>ei {stem}</1>."

msgid "<0>Ei</0> says what someone doesn’t do; <1>ära</1> tells them not to: <2>Ma ei istu. Ära istu!</2>"
msgstr "<0>Ei</0> говорит, чего человек не делает; <1>ära</1> просит этого не делать: <2>Ma ei istu. Ära istu!</2>"

msgid "<0>Ei</0>, and the verb without its ending."
msgstr "<0>Ei</0> и глагол без окончания."

msgid "<0>Ema ja isa</0> are two people, like <1>nad</1>, so the verb ends in <2>-vad</2>."
msgstr "<0>Ema ja isa</0> — это два человека, как <1>nad</1>, поэтому глагол оканчивается на <2>-vad</2>."

msgid "<0>Hakkad</0> is for <1>sa</1>, and after it comes the <2>ma</2> form: <3>ma hakkan õppima</3>."
msgstr "<0>Hakkad</0> — для <1>sa</1>, а после него идёт форма на <2>ma</2>: <3>ma hakkan õppima</3>."

msgid "<0>Hakkama</0> and a <1>ma</1> form say what you’re going to do or start doing: <2>Ma hakkan eesti keelt õppima</2>."
msgstr "<0>Hakkama</0> и форма на <1>ma</1> говорят, что ты будешь делать или начнёшь делать: <2>Ma hakkan eesti keelt õppima</2>."

msgid "<0>Hakkama</0> takes the person’s ending, and the verb after it stays the same: <1>ma hakkan õppima, nad hakkavad õppima</1>."
msgstr "<0>Hakkama</0> меняется по лицам, а глагол после него — нет: <1>ma hakkan õppima, nad hakkavad õppima</1>."

msgid "<0>Hakkama</0> takes the person’s ending; the verb after it stays in its <1>ma</1> form."
msgstr "<0>Hakkama</0> получает окончание лица; глагол после него остаётся в форме на <1>ma</1>."

msgid "<0>Homme</0> is tomorrow, so the present: <1>olen</1>."
msgstr "<0>Homme</0> — это завтра, так что настоящее время: <1>olen</1>."

msgid "<0>in</0> goes on <1>ol-</1>."
msgstr "<0>in</0> добавляется к <1>ol-</1>."

msgid "<0>in</0> goes on <1>tul-</1>."
msgstr "<0>in</0> добавляется к <1>tul-</1>."

msgid "<0>Jonas</0> added 4 cards to Week 4"
msgstr "<0>Jonas</0> добавил 4 карточки в неделю 4"

msgid "<0>Jonas</0> finished Week 2"
msgstr "<0>Jonas</0> прошёл неделю 2"

msgid "<0>Käin</0> is the present. Kati asked about yesterday."
msgstr "<0>Käin</0> — это настоящее время. Кати спрашивала о вчерашнем дне."

msgid "<0>Kass</0> is one cat, like <1>ta</1>, so the verb ends in <2>-b</2>: <3>magab</3>."
msgstr "<0>Kass</0> — это одна кошка, как <1>ta</1>, поэтому глагол оканчивается на <2>-b</2>: <3>magab</3>."

msgid "<0>kassi</0> + <1>d</1> = <2>kassid</2>"
msgstr "<0>kassi</0> + <1>d</1> = <2>kassid</2>"

msgid "<0>Kassid</0> is more than one, so it’s <1>meeldivad</1>."
msgstr "<0>Kassid</0> — множественное число, поэтому нужно <1>meeldivad</1>."

msgid "<0>Kassid</0> is more than one: <1>meeldivad</1>."
msgstr "<0>Kassid</0> — множественное число: <1>meeldivad</1>."

msgid "<0>Kes</0> asks about people, <1>mis</1> about things."
msgstr "<0>Kes</0> спрашивает о людях, <1>mis</1> — о вещах."

msgid "<0>Kodu</0> is one home, so the adjective has no <1>-d</1>: <2>väike</2>."
msgstr "<0>Kodu</0> — это один дом, поэтому прилагательное без <1>-d</1>: <2>väike</2>."

msgid "<0>Kohv</0> is one thing, so it’s <1>meeldib</1>."
msgstr "<0>Kohv</0> — что-то одно, поэтому нужно <1>meeldib</1>."

msgid "<0>Kokk</0> has the genitive <1>koka</1>, so as a cook is <2>kokana</2>."
msgstr "Родительный падеж от <0>kokk</0> — <1>koka</1>, поэтому «поваром» — это <2>kokana</2>."

msgid "<0>Kool</0> gains an i: <1>kooli</1>. It’s the vowel you heard in <2>koolis</2>."
msgstr "У <0>kool</0> на конце появляется i: <1>kooli</1>. Это та же гласная, что в <2>koolis</2>."

msgid "<0>Koolis</0> says where you are. To say where from, use <1>-st</1>: <2>koolist</2>."
msgstr "<0>Koolis</0> говорит, где ты находишься. Чтобы сказать «откуда», нужно <1>-st</1>: <2>koolist</2>."

msgid "<0>Koolisse</0> says where to: you’d be coming to school. She asked where from."
msgstr "<0>Koolisse</0> отвечает на «куда?»: получилось бы, что ты приходишь в школу. Мари спросила, откуда."

msgid "<0>Kuhu?</0> {means}"
msgstr "<0>Kuhu?</0> {means}"

msgid "<0>Kus?</0> {means}"
msgstr "<0>Kus?</0> {means}"

msgid "<0>Kus</0>, <1>kuhu</1> or <2>kust</2>"
msgstr "<0>Kus</0>, <1>kuhu</1> или <2>kust</2>"

msgid "<0>Kus</0>, <1>kuhu</1> or <2>kust</2>?"
msgstr "<0>Kus</0>, <1>kuhu</1> или <2>kust</2>?"

msgid "<0>Kust?</0> {means}"
msgstr "<0>Kust?</0> {means}"

msgid "<0>Kust</0> asks where you’re from, not where you live."
msgstr "<0>Kust</0> спрашивает, откуда ты, а не где живёшь."

msgid "<0>la</0> gives way to <1>nud</1>."
msgstr "<0>la</0> меняется на <1>nud</1>."

msgid "<0>Lähen ujuma</0> is I’m going swimming, <1>olen ujumas</1> I’m out swimming, and <2>tulen ujumast</2> I’m coming back from swimming. The ending says which."
msgstr "<0>Lähen ujuma</0> — это «я иду плавать», <1>olen ujumas</1> — «я на плавании», а <2>tulen ujumast</2> — «я возвращаюсь с плавания». Какое из трёх — показывает окончание."

msgid "<0>Läksin</0> is the past. Next week is still to come: <1>lähen</1>."
msgstr "<0>Läksin</0> — прошедшее время. Следующая неделя ещё впереди: <1>lähen</1>."

msgid "<0>Lapsed</0> is plural, so the verb takes the form of <1>nad</1>: <2>õpivad</2>."
msgstr "<0>Lapsed</0> — множественное число, поэтому глагол стоит в форме для <1>nad</1>: <2>õpivad</2>."

msgid "<0>Last</0> is the third form, so it comes after <1>lapse</1>."
msgstr "<0>Last</0> — третья форма, поэтому она идёт после <1>lapse</1>."

msgid "<0>Laua peal</0> and <1>laual</1> say the same, and so do <2>kasti sees</2> and <3>kastis</3>."
msgstr "<0>Laua peal</0> и <1>laual</1> значат одно и то же, как и <2>kasti sees</2> и <3>kastis</3>."

msgid "<0>Lugesin</0> is I read, I was reading and I did read: one simple past for all three. Time words such as <1>eile</1> and <2>eelmisel nädalal</2> say when."
msgstr "В простом прошедшем нет рода: <0>lugesin</0> — это и «я читал», и «я читала». Когда именно, показывают слова вроде <1>eile</1> или <2>eelmisel nädalal</2>."

msgid "<0>Ma ei käi</0> is now. Kati asked about yesterday."
msgstr "<0>Ma ei käi</0> — это сейчас. Кати спрашивала про вчера."

msgid "<0>Ma ei tea</0> is I don’t know. <1>Kuidas läheb?</1> asks how you are."
msgstr "<0>Ma ei tea</0> — это «я не знаю». <1>Kuidas läheb?</1> — это «Как дела?»."

msgid "<0>Ma käisin</0> says you went. To say you didn’t: <1>ma ei käinud</1>."
msgstr "<0>Ma käisin</0> значит «да». Чтобы сказать «нет»: <1>ma ei käinud</1>."

msgid "<0>Ma tahan lugeda</0> is I want to read, and <1>Ma pean lugema</1> is I have to read. The first verb decides whether the second takes its <2>-da</2> or its <3>-ma</3> form."
msgstr "<0>Ma tahan lugeda</0> — это «я хочу читать», а <1>Ma pean lugema</1> — «мне надо читать». Первый глагол решает, в какой форме будет второй: на <2>-da</2> или на <3>-ma</3>."

msgid "<0>Ma</0> takes <1>-n</1>: <2>elan</2>."
msgstr "После <0>ma</0> глагол оканчивается на <1>-n</1>: <2>elan</2>."

msgid "<0>Ma</0> takes <1>-n</1>: <2>õpin</2>."
msgstr "После <0>ma</0> глагол оканчивается на <1>-n</1>: <2>õpin</2>."

msgid "<0>Majas</0> means in the house: the second form with <1>-s</1>. The second form itself is <2>maja</2>."
msgstr "<0>Majas</0> значит «в доме»: это вторая форма с <1>-s</1>. А сама вторая форма — <2>maja</2>."

msgid "<0>marginal cost</0> <1>= cost of 1 more</1>"
msgstr "<0>предельные издержки</0> <1>= цена ещё 1 шт.</1>"

msgid "<0>Mari</0> finished Week 3"
msgstr "<0>Mari</0> прошла неделю 3"

msgid "<0>me</0> now, <1>sime</1> in the past."
msgstr "<0>me</0> сейчас, <1>sime</1> в прошлом."

msgid "<0>Meeldib</0> for one thing"
msgstr "<0>Meeldib</0>, когда что-то одно"

msgid "<0>Meeldib</0> goes with one thing or a verb, <1>meeldivad</1> with more than one thing: <2>Mulle meeldib lugeda. Mulle meeldivad kassid.</2>"
msgstr "<0>Meeldib</0> — когда нравится что-то одно или действие, <1>meeldivad</1> — когда несколько: <2>Mulle meeldib lugeda. Mulle meeldivad kassid.</2>"

msgid "<0>Meeldib</0> or <1>meeldivad</1>"
msgstr "<0>Meeldib</0> или <1>meeldivad</1>"

msgid "<0>Meeldivad</0> for more than one"
msgstr "<0>Meeldivad</0>, когда несколько"

msgid "<0>Mexican Spanish</0>, <1>informal examples</1>."
msgstr "<0>Мексиканский испанский</0>, <1>разговорные примеры</1>."

msgid "<0>Mina</0> is I. To say my, use <1>minu</1>: <2>minu raamat</2>."
msgstr "<0>Mina</0> — это «я». «Моя» будет <1>minu</1>: <2>minu raamat</2>."

msgid "<0>Mina</0> takes <1>olen</1>: <2>Mina olen Andres</2>."
msgstr "После <0>mina</0> идёт <1>olen</1>: <2>Mina olen Andres</2>."

msgid "<0>Mina</0>, <1>sina</1> and <2>nemad</2> change: <3>minu, sinu, nende</3>. <4>Tema</4>, <5>meie</5> and <6>teie</6> stay as they are."
msgstr "<0>Mina</0>, <1>sina</1> и <2>nemad</2> меняются: <3>minu, sinu, nende</3>. <4>Tema</4>, <5>meie</5> и <6>teie</6> остаются как есть."

msgid "<0>Minu</0> and <1>sinu</1> often shorten to <2/> and <3/>. <4>Tema</4>, <5>meie</5> and <6>teie</6> shorten to <7>ta, me</7> and <8>te</8>, the same short forms you met for he or she, we and you. Lesson {questions} used <9>su</9>: <10/> means “What’s your name?”"
msgstr "<0>Minu</0> и <1>sinu</1> часто сокращаются до <2/> и <3/>. <4>Tema</4>, <5>meie</5> и <6>teie</6> сокращаются до <7>ta, me</7> и <8>te</8> — тех же кратких форм, что и для «он или она», «мы» и «вы». В уроке {questions} уже было <9>su</9>: <10/> — «Как тебя зовут?»"

msgid "<0>Mul on vaja</0> is I need: <1>Mul on vaja abi.</1>"
msgstr "<0>Mul on vaja</0> — это «мне нужно»: <1>Mul on vaja abi.</1>"

msgid "<0>Mul on</0> and <1>mulle meeldib</1>"
msgstr "<0>Mul on</0> и <1>mulle meeldib</1>"

msgid "<0>Mulle meeldib</0> is I like. Lesson {liking} explains how it works."
msgstr "<0>Mulle meeldib</0> — это «мне нравится». Как это устроено, объясняет урок {liking}."

msgid "<0>Mulle meeldib</0> or <1>mulle meeldivad</1>?"
msgstr "<0>Mulle meeldib</0> или <1>mulle meeldivad</1>?"

msgid "<0>n</0> now, <1>sin</1> in the past."
msgstr "<0>n</0> сейчас, <1>sin</1> в прошлом."

msgid "<0>Nad käivad</0> is they go, now. Kati asked about you, yesterday."
msgstr "<0>Nad käivad</0> — это «они ходят», сейчас. Кати спрашивала о тебе и о вчерашнем дне."

msgid "<0>Nad on</0> is they are, now. Kati asked what you did yesterday."
msgstr "<0>Nad on</0> — это «они есть», сейчас. Кати спрашивала о твоём вчерашнем дне."

msgid "<0>Nad ostavad</0> is they buy, now. Kati asked what you bought."
msgstr "<0>Nad ostavad</0> — это «они покупают», сейчас. Кати спрашивала о вчерашних покупках."

msgid "<0>Nende</0> is their. For you and Martin, say <1>meie</1>, our."
msgstr "<0>Nende</0> — это «их». Про себя и Мартина говори <1>meie</1>, «наш»."

msgid "<0>Olen</0> for I, <1>oled</1> for you, <2>on</2> for he or she and for they."
msgstr "<0>Olen</0> для «я», <1>oled</1> для «ты», <2>on</2> для «он или она» и для «они»."

msgid "<0>On</0> is both he or she is and they are. Only the pronoun tells them apart."
msgstr "<0>On</0> — и «он или она есть», и «они есть». Различить их можно только по местоимению."

msgid "<0>Oo</0> turns into <1>õ</1>, then <2>in</2>."
msgstr "<0>Oo</0> превращается в <1>õ</1>, потом <2>in</2>."

msgid "<0>Öö</0> turns into <1>õ</1>, then <2>in</2>."
msgstr "<0>Öö</0> превращается в <1>õ</1>, потом <2>in</2>."

msgid "<0>opportunity cost</0> <1>= what you give up</1>"
msgstr "<0>альтернативная стоимость</0> <1>= чем жертвуешь</1>"

msgid "<0>Oskan</0> is for what you learned: <1>Ma oskan ujuda.</1> <2>Saan</2> says nothing stops you: <3>Ma saan homme tulla.</3>"
msgstr "<0>Oskan</0> — про умение: <1>Ma oskan ujuda.</1> <2>Saan</2> — когда тебе ничто не мешает: <3>Ma saan homme tulla.</3>"

msgid "<0>Oskan</0>: you learned how."
msgstr "<0>Oskan</0>: ты это умеешь."

msgid "<0>Osmosis</0>: water crosses a membrane toward more dissolved substance."
msgstr "<0>Осмос</0>: вода проходит через мембрану туда, где больше растворённого вещества."

msgid "<0>Ostsid</0> is for <1>sa</1> or <2>nad</2>. With <3>ma</3>, it’s <4>ostsin</4>."
msgstr "<0>Ostsid</0> — для <1>sa</1> или <2>nad</2>. Для <3>ma</3> будет <4>ostsin</4>."

msgid "<0>P suletud</0> on a sign: closed on Sunday."
msgstr "<0>P suletud</0> на табличке: в воскресенье закрыто."

msgid "<0>Pärnus</0> says in Pärnu. <1>Pärit</1> takes the form for where from: <2>Pärnust</2>."
msgstr "<0>Pärnus</0> — это «в Пярну». После <1>pärit</1> нужна форма «откуда»: <2>Pärnust</2>."

msgid "<0>Pärnusse</0> says to Pärnu. <1>Pärit</1> takes the form for where from: <2>Pärnust</2>."
msgstr "<0>Pärnusse</0> отвечает на «куда?». После <1>pärit</1> нужна форма «откуда»: <2>Pärnust</2>."

msgid "<0>Pean, hakkan, lähen, tule</0> and <1>jään</1> take the <2>-ma</2> form."
msgstr "<0>Pean, hakkan, lähen, tule</0> и <1>jään</1> требуют формы на <2>-ma</2>."

msgid "<0>Pean</0> is I have to. <1>Tuleb</1> with the <2>-da</2> form says it has to be done, naming no one. <3>Mul on vaja</3> is I need to."
msgstr "<0>Pean</0> — это «мне надо». <1>Tuleb</1> с формой на <2>-da</2> говорит, что что-то надо сделать, и никого не называет. <3>Mul on vaja</3> — это «мне нужно»."

msgid "<0>Pean</0> says you have to come. Nobody makes you; you’re free."
msgstr "<0>Pean</0> значит, что тебе надо прийти. Тебя никто не заставляет, у тебя просто свободный день."

msgid "<0>Poe</0> is the second form. The third has the <1>d</1> back: <2>poodi</2>."
msgstr "<0>Poe</0> — вторая форма. В третьей <1>d</1> возвращается: <2>poodi</2>."

msgid "<0>Poes</0> says where you are. After <1>lähen</1>, say where to: <2>poodi</2>."
msgstr "<0>Poes</0> говорит, где ты находишься. После <1>lähen</1> нужно «куда»: <2>poodi</2>."

msgid "<0>Poes</0> says you’re in the shop. She asked where you’re going."
msgstr "<0>Poes</0> значит, что ты в магазине. Мари спросила, куда ты идёшь."

msgid "<0>Pole</0> means the same as <1>ei ole</1>. You’ll hear both."
msgstr "<0>Pole</0> значит то же, что <1>ei ole</1>. Услышишь оба."

msgid "<0>Pood</0> loses its d, and the second o turns to e: <1>poe</1>. <2>Turg</2> and <3>laud</3> drop their last letter and gain a vowel: <4>turu, laua</4>."
msgstr "<0>Pood</0> теряет d, а второе o становится e: <1>poe</1>. <2>Turg</2> и <3>laud</3> теряют последнюю букву, и в них появляется гласная: <4>turu, laua</4>."

msgid "<0>Pool</0>, <1>veerand</1> and <2>kolmveerand</2> name the hour that’s coming: <3>pool neli</3> is 3:30."
msgstr "<0>Pool</0>, <1>veerand</1> и <2>kolmveerand</2> называют наступающий час: <3>pool neli</3> — это 3:30."

msgid "<0>price elasticity</0> ?"
msgstr "<0>эластичность спроса</0> ?"

msgid "<0>Sa oled</0> is you are: this tells Mari she’s from Ukraine."
msgstr "<0>Sa oled</0> — «ты есть»: так ты говоришь Мари, что она из Украины."

msgid "<0>Sa</0> takes <1>-d</1>: <2>töötad</2>."
msgstr "После <0>sa</0> глагол оканчивается на <1>-d</1>: <2>töötad</2>."

msgid "<0>Sa</0> takes <1>oled</1>, not <2>on</2>."
msgstr "После <0>sa</0> идёт <1>oled</1>, а не <2>on</2>."

msgid "<0>Saan</0>: nothing stops you, not time, place or health."
msgstr "<0>Saan</0>: тебе ничто не мешает — ни время, ни место, ни здоровье."

msgid "<0>Sada</0> and <1>tuhat</1> need no “one”. Hundreds join up; thousands stay separate."
msgstr "Перед <0>sada</0> и <1>tuhat</1> «один» не говорят. Сотни пишутся слитно, тысячи отдельно."

msgid "<0>sin</0> when it happened; no ending after <1>ei</1>."
msgstr "<0>sin</0>, когда это случилось; после <1>ei</1> окончания нет."

msgid "<0>Sinu</0> is your: that says the coffee is Mari’s."
msgstr "<0>Sinu</0> — это «твой»: так ты говоришь, что это кофе Мари."

msgid "<0>Sinu</0> is your: this says “Your name is Andres.”"
msgstr "<0>Sinu</0> — это «твоё»: получается «Твоё имя — Андрес»."

msgid "<0>Sklep</0> is a shop, not a crypt, and <1>dynia</1> is a pumpkin, not a melon. The ready-made decks say in a card’s notes where a Polish word only looks like yours, and AI writes the same note for the words you add."
msgstr "<0>Sklep</0> — это магазин, а не склеп, а <1>dynia</1> — тыква, а не дыня. В готовых колодах заметка на карточке говорит, где польское слово только похоже на русское, а AI пишет такую же заметку к словам, которые ты добавляешь сам."

msgid "<0>Sõber</0> sounds like “sober”: the friend who gets you home."
msgstr "<0>Sõber</0> — родственник древнерусского «сябр», то есть друг. Белорусы до сих пор говорят «сябар»."

msgid "<0>Sõnaveeb</0>, the free dictionary of the Institute of the Estonian Language, lists them under <1>Sõnavormid</1>, word forms. Search for a word and scroll to that table: its left column holds the three forms, top to bottom. The right column is the plural."
msgstr "В <0>Sõnaveeb</0>, бесплатном словаре Института эстонского языка, они стоят в таблице <1>Sõnavormid</1> — «формы слова». Найди слово и пролистай до этой таблицы: в левом столбце сверху вниз три формы. Правый столбец — это множественное число."

msgid "<0>Sööma</0> and <1>jooma</1> break the pattern. Their commands build on the I form: <2>söön, sööge</2>; <3>joon, jooge</3>."
msgstr "<0>Sööma</0> и <1>jooma</1> — исключения. Их команды строятся на форме для «я»: <2>söön, sööge</2>; <3>joon, jooge</3>."

msgid "<0>Suured</0> ends in <1>-d</1>, so there is more than one room: <2>toad</2>."
msgstr "<0>Suured</0> оканчивается на <1>-d</1>, значит, комнат больше одной: <2>toad</2>."

msgid "<0>Ta</0> adds nothing after the i."
msgstr "<0>Ta</0> ничего не добавляет после i."

msgid "<0>Ta</0> drops the i: <1>läks</1>."
msgstr "<0>Ta</0> теряет i: <1>läks</1>."

msgid "<0>ta</0> gives way to <1>nud</1>, and the d stays: <2>oodanud</2>."
msgstr "<0>ta</0> меняется на <1>nud</1>, а d остаётся: <2>oodanud</2>."

msgid "<0>Ta</0> is both he and she. <1>Te</1> is you, to more than one, and polite you to one person."
msgstr "<0>Ta</0> — и «он», и «она». <1>Te</1> — «вы» нескольким людям и вежливое «Вы» одному."

msgid "<0>Ta</0> is one cat, so the adjective has no <1>-d</1>, like <2>ilus</2>."
msgstr "<0>Ta</0> — это одна кошка, поэтому прилагательное без <1>-d</1>, как <2>ilus</2>."

msgid "<0>Tahan, võin, saan, oskan, tohin, proovin, armastan</0> and <1>mulle meeldib</1> take the <2>-da</2> form."
msgstr "<0>Tahan, võin, saan, oskan, tohin, proovin, armastan</0> и <1>mulle meeldib</1> требуют формы на <2>-da</2>."

msgid "<0>Täna</0>, <1>homme</1>, <2>eile</2>: today, tomorrow, yesterday. <3>Üle-</3> goes one day further."
msgstr "<0>Täna</0>, <1>homme</1>, <2>eile</2> — сегодня, завтра, вчера. <3>Üle-</3> добавляет ещё один день."

msgid "<0>Tartu</0> and <1>haigla</1> stay as they are, and <2>-s</2> or <3>-l</3> goes straight on."
msgstr "<0>Tartu</0> и <1>haigla</1> не меняются, и <2>-s</2> или <3>-l</3> просто добавляется в конце."

msgid "<0>Tartust</0> says from Tartu. You’re going to Tartu: <1>Tartusse</1>."
msgstr "<0>Tartust</0> значит «из Тарту». А ты едешь в Тарту: <1>Tartusse</1>."

msgid "<0>te</0> now, <1>site</1> in the past."
msgstr "<0>te</0> сейчас, <1>site</1> в прошлом."

msgid "<0>Teha, näha, süüa</0> and <1>juua</1> end in a bare <2>-a</2> and change their stem. Learn these four whole."
msgstr "<0>Teha, näha, süüa</0> и <1>juua</1> оканчиваются просто на <2>-a</2>, и основа у них меняется. Эти четыре запоминай целыми словами."

msgid "<0>Teie</0> is your. For you and Martin, say <1>meie</1>, our."
msgstr "<0>Teie</0> — это «ваш». Про себя и Мартина говори <1>meie</1>, «наш»."

msgid "<0>Tere</0> is hello, and Mari is leaving."
msgstr "<0>Tere</0> — это «привет», а Мари уже уходит."

msgid "<0>Töötasin</0> is the past. For next weekend, the present: <1>ma töötan</1>."
msgstr "<0>Töötasin</0> — это прошедшее время. Про следующие выходные — настоящее: <1>ma töötan</1>, как «я работаю в субботу»."

msgid "<0>Töötasin</0> is the past. For tomorrow, the present: <1>töötan</1>."
msgstr "<0>Töötasin</0> — прошедшее время. Про завтра — настоящее: <1>töötan</1>."

msgid "<0>Tulema</0> again, as a command: come here to do it, so <1>-ma</1>."
msgstr "Снова <0>tulema</0>, но как команда: приходи сюда, чтобы что-то сделать, поэтому <1>-ma</1>."

msgid "<0>Tulema</0> takes <1>-mast</1> or <2>-ma</2>: <3>Ma tulen ujumast. Tule sööma!</3>"
msgstr "После <0>tulema</0> бывает и <1>-mast</1>, и <2>-ma</2>: <3>Ma tulen ujumast. Tule sööma!</3>"

msgid "<0>Ujuda</0> is a verb, and a verb takes <1>meeldib</1>."
msgstr "<0>Ujuda</0> — глагол, а с глаголом всегда <1>meeldib</1>."

msgid "<0>vad</0> now, <1>sid</1> in the past, as for <2>sa</2>."
msgstr "<0>vad</0> сейчас, <1>sid</1> в прошлом, как и для <2>sa</2>."

msgid "<0>Veerand neli</0> is a quarter of the way to four, 3:15. <1>Kolmveerand neli</1> is three quarters, 3:45."
msgstr "<0>Veerand neli</0> — четверть пути к четырём, 3:15. <1>Kolmveerand neli</1> — три четверти, 3:45."

msgid "<0>Võin</0> and <1>tohin</1> both say it’s allowed; <2>võin</2> also offers: <3>Ma võin sind oodata.</3> <4>Tohin</4> is mostly heard with <5>ei</5>: <6>Siin ei tohi süüa.</6>"
msgstr "<0>Võin</0> и <1>tohin</1> оба говорят, что что-то разрешено; <2>võin</2> ещё и предлагает: <3>Ma võin sind oodata.</3> <4>Tohin</4> чаще всего слышно с <5>ei</5>: <6>Siin ei tohi süüa.</6>"

msgid "<0>за́мок</0> is a castle."
msgstr "<0>за́мок</0> — это крепость."

msgid "<0>はし</0> can mean chopsticks, a bridge or an edge. Only the pitch tells them apart. Lymi charts it under the word, so you learn how it’s said as well as how it’s read."
msgstr "<0>はし</0> — это палочки для еды, мост или край. Различить их можно только по высоте тона. Lymi показывает график тона под словом, так что ты учишься и читать слово, и произносить его."

msgid "<0>乗る</0> to get on, plus <1>換える</1> to swap: you get on a different train."
msgstr "<0>乗る</0> — сесть, <1>換える</1> — заменить: ты садишься на другой поезд."

msgid "<0>换</0> to swap, <1>乘</1> to ride: you swap the line you ride."
msgstr "<0>换</0> — менять, <1>乘</1> — ехать: меняешь линию, по которой едешь."


msgstr "Тарту, больница, школа и магазин употребляются с <0>-s</0>, поэтому <1>-sse</1> или короткая форма: <2>Tartusse, kooli</2>."

msgid "Tartu; Tartu’s, of Tartu"
msgstr "Тарту"

msgid "tastes good"
msgstr "нравится на вкус"

msgid "tasty"
msgstr "вкусный"

msgid "tea"
msgstr "чай"

msgid "Tea"
msgstr "Чай"


msgstr "От арабского law šāʼ Allāh — «если Бог захочет»."

msgid "From G. K. Chesterton’s 1929 book The Thing."
msgstr "Из книги Г. К. Честертона «The Thing» 1929 года."

msgid "From now until your test date"
msgstr "С сегодняшнего дня до даты теста"

msgid "Generated audio stays with the related card or account until it is removed under the service’s storage lifecycle."
msgstr "Созданное озвучивание хранится вместе с соответствующей карточкой или аккаунтом, пока не будет удалено по правилам жизненного цикла хранилища сервиса."

msgid "Genitive"
msgstr "Родительный"

msgid "Geography"
msgstr "География"

msgid "German"
msgstr "Немецкий"

msgid "German A2 · Tuesdays"
msgstr "Немецкий A2 · по вторникам"

msgid "German road signs for the theory test"
msgstr "Дорожные знаки Германии для теории"

msgid "German road signs: every sign of the StVO"
msgstr "Дорожные знаки Германии: все знаки StVO"

msgid "Germany"
msgstr "Германия"


msgid "{added, plural, one {# card added} other {# cards added}}"
msgstr "{added, plural, one {Добавлена # карточка} few {Добавлено # карточки} many {Добавлено # карточек} other {Добавлено # карточки}}"

msgid "{cardCount, plural, one {See the card} other {See all # cards}}"
msgstr "{cardCount, plural, one {Посмотреть карточку} few {Посмотреть все # карточки} many {Посмотреть все # карточек} other {Посмотреть все # карточки}}"

msgid "{cardCount, plural, one {The one card} other {All # cards}}"
msgstr "{cardCount, plural, one {Единственная карточка} few {Все # карточки} many {Все # карточек} other {Все # карточки}}"

msgid "{cards, plural, one {card} other {cards}}"
msgstr "{cards, plural, one {карточка} few {карточки} many {карточек} other {карточки}}"

msgid "{CLASS_LEARNERS, plural, one {# learner joined} other {# learners joined}}"
msgstr "{CLASS_LEARNERS, plural, one {Присоединился # ученик} few {Присоединились # ученика} many {Присоединились # учеников} other {Присоединились # ученика}}"

msgid "{count, plural, one {# {language} card} other {# {language} cards}} at level {level}, with meanings in {meaningLanguage}. Try a few, then add the deck to Lymi to review them all."
msgstr "{count, plural, one {# карточка} few {# карточки} many {# карточек} other {# карточки}}. {language} язык, уровень {level}. Значения — {meaningLanguage}. Попробуй несколько, а потом добавь колоду в Lymi, чтобы повторять все."

msgid "{count, plural, one {# {language} card} other {# {language} cards}} with meanings in {meaningLanguage}. Try a few, then add the deck to Lymi to review them all."
msgstr "{count, plural, one {# карточка} few {# карточки} many {# карточек} other {# карточки}}. {language} язык. Значения — {meaningLanguage}. Попробуй несколько, а потом добавь колоду в Lymi, чтобы повторять все."

msgid "{count, plural, one {# card} other {# cards}}. Try a few, then add the deck to Lymi to review them all."
msgstr "{count, plural, one {# карточка} few {# карточки} many {# карточек} other {# карточки}}. Попробуй несколько, а потом добавь колоду в Lymi, чтобы повторять все."

msgid "{decks, plural, one {deck} other {decks}}"
msgstr "{decks, plural, one {колода} few {колоды} many {колод} other {колоды}}"

msgid "{found, plural, one {# deck} other {# decks}}"
msgstr "{found, plural, one {# колода} few {# колоды} many {# колод} other {# колоды}}"

msgid "{known}% known"
msgstr "Выучено {known}%"

msgid "{label} decks"
msgstr "Колоды: {label}"

msgid "{learners, plural, one {# learner} other {# learners}}"
msgstr "{learners, plural, one {# ученик} few {# ученика} many {# учеников} other {# ученика}}"

msgid "{learners, plural, one {Reached # learner} other {Reached all # learners}}"
msgstr "{learners, plural, one {Доставлено # ученику} few {Доставлено всем # ученикам} many {Доставлено всем # ученикам} other {Доставлено всем # ученикам}}"

msgid "{left, plural, =0 {That’s the whole deck. Add it, and Lymi chooses when to bring each card back.} one {One more card is waiting. Add the deck, and Lymi chooses when to bring each one back.} other {Another # cards are waiting. Add the deck, and Lymi chooses when to bring each one back.}}"
msgstr "{left, plural, =0 {Это вся колода. Добавь её, и Lymi сама выберет, когда вернуть каждую карточку.} one {Ждёт ещё одна карточка. Добавь колоду, и Lymi сама выберет, когда вернуть каждую.} few {Ждут ещё # карточки. Добавь колоду, и Lymi сама выберет, когда вернуть каждую.} many {Ждут ещё # карточек. Добавь колоду, и Lymi сама выберет, когда вернуть каждую.} other {Ждут ещё # карточки. Добавь колоду, и Lymi сама выберет, когда вернуть каждую.}}"

msgid "{name} · {language} vocabulary · Lymi"
msgstr "{name} · {language} язык · Lymi"

msgid "{name} · {language} vocabulary, level {level} · Lymi"
msgstr "{name} · {language} язык, уровень {level} · Lymi"

msgid "{name} · Flashcards · Lymi"
msgstr "{name} · Флеш-карточки · Lymi"

msgid "{name} on Lymi: {facts}"
msgstr "{name} в Lymi: {facts}"

msgid "{pictures, plural, one {# card brings its picture.} other {# cards bring their pictures.}}"
msgstr "{pictures, plural, one {# карточка переносится с картинкой.} few {# карточки переносятся с картинками.} many {# карточек переносятся с картинками.} other {# карточки переносятся с картинками.}}"

msgid "{reviews, plural, one {past review} other {past reviews}}"
msgstr "{reviews, plural, one {прошлое повторение} few {прошлых повторения} many {прошлых повторений} other {прошлого повторения}}"

msgid "{turned, plural, one {# turned} other {# turned}}"
msgstr "{turned, plural, one {# карточка перевёрнута} few {# карточки перевёрнуты} many {# карточек перевёрнуто} other {# карточки перевёрнуто}}"

#. placeholder {0}: said.cue
#. placeholder {1}: said.answer
msgid "<0>{0}</0>: <1>{1}</1>"
msgstr "<0>{0}</0>: <1>{1}</1>"

msgid "<0>Cloudflare</0> provides the website, application, database, object storage, session storage, network protection, aggregate usage metrics, operational logs and transactional email delivery."
msgstr "<0>Cloudflare</0> предоставляет сайт, приложение, базу данных, хранилище объектов, хранилище сессий, защиту сети, сводные показатели использования, рабочие журналы и доставку транзакционных писем."

msgid "<0>Google</0> provides Google sign-in and may provide speech generation when configured as the fallback provider."
msgstr "<0>Google</0> предоставляет вход через Google и может создавать озвучивание, если настроен как резервный поставщик."

msgid "<0>OpenAI</0> may provide speech generation. A configured Cloudflare AI Gateway may relay that request."
msgstr "<0>OpenAI</0> может создавать озвучивание. Настроенный Cloudflare AI Gateway может передавать этот запрос."

msgid "<0>Your browser’s push service</0> receives an encrypted reminder when you enable notifications."
msgstr "<0>Служба push-уведомлений твоего браузера</0> получает зашифрованное напоминание, когда ты включаешь уведомления."

msgid "<0>Your connected apps</0> receive only the data allowed by the permissions you approve. Disconnecting an app stops future access but does not erase data the app already received."
msgstr "<0>Подключённые приложения</0> получают только те данные, к которым ты одобряешь доступ. Отключение приложения прекращает будущий доступ, но не стирает уже полученные им данные."

msgid "10 min"
msgstr "10 мин"

msgid "2 days"
msgstr "2 дня"

msgid "20 September 2026"
msgstr "20 сентября 2026 года"

msgid "4 days"
msgstr "4 дня"

msgid "9 days"
msgstr "9 дней"

msgid "A bad idea that seemed good"
msgstr "Плохая идея, казавшаяся хорошей"

msgid "a bag"
msgstr "пакет"

msgid "A book"
msgstr "Книга"

msgid "A brilliant first round rarely repeats in the second."
msgstr "Блестящий первый раунд редко удаётся повторить во втором."

msgid "A café, an evening or a person can all be gezellig."
msgstr "Gezellig бывает и кафе, и вечер, и человек."

msgid "A class deck, Estonian A2 · Tuesdays, gets three new cards after today’s lesson: kohtuma, broneerima and ilm. They reach all {learners} learners."
msgstr "После сегодняшнего урока в колоде группы «Эстонский A2 · по вторникам» появляются три новые карточки: kohtuma, broneerima и ilm. Их получают все {learners} учеников."

msgid "A clever fix made from whatever is at hand"
msgstr "Смекалистое решение из подручных средств"

msgid "A coffee and a cinnamon bun, please."
msgstr "Кофе и булочку с корицей, пожалуйста."

msgid "A connected assistant may read lesson material in the conversation where you use it. Lymi does not receive that raw lesson material unless the assistant sends it in a card field such as the term, meaning, example, notes or source. The assistant provider handles the conversation under its own terms and privacy policy."
msgstr "Подключённый ассистент может читать материалы урока в разговоре, где ты им пользуешься. Lymi не получает эти исходные материалы, если ассистент не отправляет их в поле карточки, например в термине, значении, примере, заметках или источнике. Поставщик ассистента обрабатывает разговор по своим условиям и политике конфиденциальности."

msgid "A course or lesson"
msgstr "Курсы и занятия"

msgid "A deck in four sections. Greetings is done, Numbers and time is 82% known, so Food and drink opens next. Getting around stays locked."
msgstr "Колода из четырёх разделов. Раздел «Приветствия» пройден, «Числа и время» выучен на 82%, поэтому следующим открывается «Еда и напитки». «Как добраться» пока закрыт."

msgid "A false friend. Embarrassed is avergonzado."
msgstr "Не путай с английским embarrassed: «смущённый» — это avergonzado."

msgid "A flat plate on a door says push; a handle says pull."
msgstr "Гладкая накладка на двери подсказывает «толкай», ручка — «тяни»."

msgid "A full flashcard in seconds."
msgstr "Готовая флеш-карточка за несколько секунд."

msgid "A hobby"
msgstr "Хобби"

msgid "A language class"
msgstr "Языковая группа"

msgid "A lesson transcript"
msgstr "Расшифровка урока"

msgid "A longing for someone or something that is gone"
msgstr "Тоска по кому-то или чему-то, чего уже нет"

msgid "a lot of"
msgstr "много"

msgid "A major chord with a minor seventh, built on the fifth note of the key"
msgstr "Мажорный аккорд с малой септимой, построенный на пятой ступени тональности"

msgid "A new language"
msgstr "Иностранный язык"

msgid "A page that isn’t where the link says it is"
msgstr "Страница, которой нет там, куда ведёт ссылка"

msgid "A partnership between fungi and plant roots, trading water for sugar"
msgstr "Союз грибов и корней растений: вода в обмен на сахар"

msgid "A photo of German lesson notes goes to an assistant with “Make cards from this.” It uses Lymi and adds four cards: das Mädchen, aufhören, Feierabend and Schnapsidee."
msgstr "Фото заметок с урока немецкого приходит ассистенту с просьбой «Сделай из этого карточки». Он использует Lymi и добавляет четыре карточки: das Mädchen, aufhören, Feierabend и Schnapsidee."

msgid "A photo of the board, your tutor’s message, a lesson transcript, the book on your nightstand. Your assistant picks out what’s worth keeping and adds it to Lymi."
msgstr "Фото доски, сообщение репетитора, расшифровка урока, книга на тумбочке. Ассистент выберет то, что стоит запомнить, и добавит это в Lymi."

msgid "A pile of unread books"
msgstr "Стопка непрочитанных книг"

msgid "A pun on tsunde oku, to leave piled, and doku, reading."
msgstr "Игра слов: tsunde oku — «оставить лежать стопкой» и doku — «чтение»."

msgid "A thank-you to everyone who brought the food to the table."
msgstr "Благодарность всем, чьими трудами еда оказалась на столе."

msgid "A thermostat that turns on at 19° and off at 21°."
msgstr "Термостат, который включается при 19°, а выключается при 21°."

msgid "A thing; a whatsit"
msgstr "Штука; штуковина"

msgid "a word that makes a question"
msgstr "слово, которое делает предложение вопросом"

msgid "Accents that land between the beats"
msgstr "Акценты, которые приходятся между основными долями"

msgid "Access requests from the private beta"
msgstr "Запросы доступа со времён закрытой беты"

msgid "Access requests from the private beta stay until you ask us to remove them."
msgstr "Запросы доступа со времён закрытой беты хранятся, пока ты не попросишь их удалить."

msgid "Account and learning data stay while your account is active and are removed when we complete an account-deletion request, except where law requires a longer period."
msgstr "Данные аккаунта и обучения хранятся, пока аккаунт активен, и удаляются после выполнения запроса на удаление аккаунта, кроме случаев, когда закон требует более долгого хранения."

msgid "Account and sign-in data"
msgstr "Данные аккаунта и входа"

msgid "Account-wide access, export, correction and deletion are not self-service yet. Email <0>hello@lymi.app</0> from your account address and describe what you need. We may ask you to verify your identity before acting. We will respond as required by applicable data-protection law. You may also complain to the Estonian Data Protection Inspectorate or your local supervisory authority."
msgstr "Самостоятельный доступ ко всем данным аккаунта, их экспорт, исправление и удаление пока недоступны. Напиши на <0>hello@lymi.app</0> с адреса своего аккаунта и расскажи, что тебе нужно. Перед выполнением запроса мы можем попросить подтвердить личность. Мы ответим в соответствии с применимым законодательством о защите данных. Также можно подать жалобу в Инспекцию по защите данных Эстонии или местный надзорный орган."

msgid "Actually; really"
msgstr "Вообще-то; на самом деле"

msgid "Add"
msgstr "Добавить"

msgid "Add {title}"
msgstr "Добавить «{title}»"

msgid "Add it to your assistant"
msgstr "Добавь его в своего ассистента"

msgid "Add one and learn it for free — Lymi brings each card back right before you’d forget it."
msgstr "Добавь колоду и учи её бесплатно — Lymi возвращает каждую карточку прямо перед тем, как ты её забудешь."

msgid "Add the deck"
msgstr "Добавь колоду"

msgid "Add to Lymi"
msgstr "Добавить в Lymi"

msgid "Added"
msgstr "Добавлено"

msgid "Added 4 cards to your German deck."
msgstr "Добавлено 4 карточки в колоду по немецкому."

msgid "Added 8 cards to Spanish. I skipped “ojalá”, which you already have."
msgstr "Добавил 8 карточек в колоду «Испанский». Пропустил «ojalá»: такая карточка у тебя уже есть."

msgid "Added after this week’s lesson"
msgstr "Добавлено после урока на этой неделе"

msgid "Added to Chess, with the meaning and an example."
msgstr "Готово: карточка в колоде «Шахматы», со значением и примером."

msgid "adjective"
msgstr "прилагательное"

msgid "After today’s lesson"
msgstr "После сегодняшнего урока"

msgid "After you learn something new, you start noticing it everywhere"
msgstr "Когда узнаёшь что-то новое, начинаешь замечать это повсюду"

msgid "AI"
msgstr "AI"

msgid "AI assistants"
msgstr "AI-ассистенты"

msgid "Al que madruga, Dios lo ayuda: the early bird catches the worm."
msgstr "Al que madruga, Dios lo ayuda: кто рано встаёт, тому Бог подаёт."

msgid "All"
msgstr "Все"

msgid "All good?"
msgstr "Всё хорошо?"

msgid "All known"
msgstr "Всё выучено"

msgid "all right"
msgstr "нормально"

msgid "All right. Lots of work."
msgstr "Нормально. Много работы."

msgid "Allow"
msgstr "Разрешить"

msgid "Almost! It’s <0>„Dann <1>höre</1> ich <2>auf</2>“</0>: after “dann”, the verb comes second."
msgstr "Почти! Правильно <0>„Dann <1>höre</1> ich <2>auf</2>“</0>: после «dann» глагол стоит на втором месте."

msgid "Already in your deck, so it’s skipped"
msgstr "Уже есть в колоде, поэтому пропущено"

msgid "Also called the frequency illusion."
msgstr "Другое название — иллюзия частотности."

msgid "An extreme result is usually followed by a more ordinary one"
msgstr "После выдающегося результата обычно идёт более скромный"

msgid "An idea that only sounds brilliant after a few drinks"
msgstr "Идея, которая кажется гениальной только после пары рюмок"

msgid "An idea that only sounds good after a few drinks"
msgstr "Идея, которая кажется гениальной только после пары рюмок"

msgid "Anatomy"
msgstr "Анатомия"

msgid "Anatomy, drugs and the terms learners meet on the ward."
msgstr "Анатомия, препараты и термины, которые ученики слышат в отделении."

msgid "and"
msgstr "и"

msgid "And what am I due to review tonight?"
msgstr "А что мне повторить сегодня вечером?"

msgid "Anna Kask, language school"
msgstr "Anna Kask, языковая школа"

msgid "Any language you can type, in any script. Lymi can say most widely taught languages aloud."
msgstr "Любой язык и любая письменность, которую можно набрать. Большинство языков, которые часто учат, Lymi умеет произносить вслух."

msgid "Any move you make makes your position worse"
msgstr "Любой ход ухудшает твою позицию"

msgid "Anyone with the link can join this deck."
msgstr "Присоединиться к колоде может любой, у кого есть ссылка."

msgid "anything"
msgstr "своим кодом"

msgid "Anything you pick up and want to remember."
msgstr "Всё, что зацепило и хочется запомнить."

msgid "Anything your assistant writes is marked AI on the card, so you can check it and fix it in Lymi."
msgstr "Всё, что пишет ассистент, помечено на карточке как AI, так что ты можешь проверить это и исправить в Lymi."

msgid "Anyway; long story short"
msgstr "Короче; в общем"

msgid "API and connected-app data"
msgstr "Данные API и подключённых приложений"

msgid "API keys stay until you revoke them or they expire. Connected-app tokens and consent stay until expiry, revocation, disconnection or account deletion."
msgstr "Ключи API хранятся, пока ты их не отзовёшь или пока не закончится их срок действия. Токены подключённых приложений и согласие хранятся до окончания срока действия, отзыва, отключения или удаления аккаунта."

msgid "API reference"
msgstr "Справочник API"

msgid "Ask your AI assistant to add a card while you chat. It shows up in Lymi, ready to review."
msgstr "Попроси AI-ассистента добавить карточку прямо в разговоре. Она появится в Lymi, готовая к повторению."

msgid "Asked whether you’d like to win the lottery: “Magari!”"
msgstr "На вопрос «Хочешь выиграть в лотерею?» — «Magari!»"

msgid "At the café"
msgstr "В кафе"

msgid "At the shop"
msgstr "В магазине"

msgid "Audio, reminders and account email"
msgstr "Озвучивание, напоминания и письма об аккаунте"

msgid "Auditors use it to spot figures that were made up."
msgstr "С его помощью аудиторы находят выдуманные цифры."

msgid "Back in 10 minutes."
msgstr "Вернётся через 10 минут."

msgid "Back in 2 days."
msgstr "Вернётся через 2 дня."

msgid "Back in 4 days."
msgstr "Вернётся через 4 дня."

msgid "Back in 9 days."
msgstr "Вернётся через 9 дней."

msgid "Back to {name}"
msgstr "Назад к {name}"

msgid "Back to Lymi"
msgstr "На главную Lymi"

msgid "Biology"
msgstr "Биология"

msgid "Bridge, 橋, is also hashi. Only the pitch tells them apart."
msgstr "Мост, 橋, — тоже hashi. Различить их можно только по высоте тона."

msgid "Bring Lymi to your next class."
msgstr "Попробуй Lymi на следующем уроке."

msgid "Bring your assistant to Lymi."
msgstr "Подключи своего ассистента к Lymi."

msgid "Bring your existing decks."
msgstr "Перенеси свои колоды."

msgid "Bring your favourite AI along."
msgstr "Любимый AI тоже пригодится."

msgid "Build a course in sections and share it with your class."

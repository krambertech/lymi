msgid "“J’ai la flemme” is the whole excuse."
msgstr "«J’ai la flemme» — и никаких других объяснений."

msgid "“May it come easy”, said to someone at work"
msgstr "«Пусть будет легко» — говорят тому, кто работает"

msgid "“Schönen Feierabend!” wishes someone a good evening off."
msgstr "«Schönen Feierabend!» — пожелание хорошо отдохнуть после работы."

#. placeholder {0}: deck.cards
#. placeholder {0}: section.cards
msgid "{0, plural, one {# card} other {# cards}}"
msgstr "{0, plural, one {# карточка} few {# карточки} many {# карточек} other {# карточки}}"

#. placeholder {0}: deck.length - (index % deck.length)
msgid "{0, plural, one {# due} other {# due}}"
msgstr "{0, plural, one {# карточка к повторению} few {# карточки к повторению} many {# карточек к повторению} other {# карточки к повторению}}"

#. placeholder {0}: SECTIONS.length

msgstr "12 карточек повторено без сети"

msgid "12 minutes"
msgstr "12 минут"

msgid "12 Spanish cards are due, about five minutes. Quick warm-up first?"
msgstr "К повторению 12 карточек по испанскому, примерно пять минут. Сначала короткая разминка?"

msgid "120 cards"
msgstr "120 карточек"

msgid "135–145 mmol/L in adults"
msgstr "135–145 ммоль/л у взрослых"

msgid "14 cards"
msgstr "14 карточек"


msgid "Push subscriptions stay until you disable reminders, the push service reports the subscription expired, or the account is deleted."
msgstr "Push-подписки хранятся, пока ты не отключишь напоминания, push-сервис не сообщит об окончании подписки или аккаунт не будет удалён."

msgid "Questions before you connect."
msgstr "Вопросы перед подключением."

msgid "Questions before you start."
msgstr "Что стоит знать в начале."

msgid "Questions from teachers."
msgstr "Вопросы преподавателей."

msgid "Quick nunchi means sensing a mood before anyone says a word."
msgstr "Хорошее нунчи — уловить настроение, пока никто ещё не сказал ни слова."

msgid "Raise a glass and it becomes terviseks: to your health."
msgstr "Когда поднимают бокал, говорят terviseks: за здоровье."

msgid "Read the docs"
msgstr "Открыть документацию"

msgid "Read the meaning, then try to recall the term before you look. Try it on the cards here: they’re from all over the deck."
msgstr "Прочитай значение и сначала вспомни термин, а потом смотри. Попробуй на этих карточках: они из всей колоды."

msgid "Read your German deck"

msgid "*Bread* and butter."
msgstr "*Хлеб* с маслом."

msgid "*Come* here!"
msgstr "*Иди* сюда!"

msgid "*Dear* friend!"
msgstr "*Дорогой* друг!"

msgid "*Every day* is fun."
msgstr "*Каждый день* в радость."

msgid "*Good morning*, Ms Anna!"
msgstr "*Добрый день*, пани Анна!"

msgid "*Hello*, a coffee, please."
msgstr "*Здравствуйте*, кофе, пожалуйста."

msgid "*Sunday* is a day off."
msgstr "*Воскресенье* — выходной."

msgid "*Sunday* is my favourite day."
msgstr "*Воскресенье* — мой любимый день."


msgid "-n, -d, -b, -me, -te, -vad: each person has its own."
msgstr "-n, -d, -b, -me, -te, -vad: у каждого лица своё."

msgid "-s or -l?"
msgstr "-s или -l?"

msgid "-teist or -kümmend?"
msgstr "-teist или -kümmend?"

msgid "“J’ai la flemme” is the whole excuse."
msgstr "«J’ai la flemme» — и никаких других объяснений."

msgid "“Look at that VAT, MAma!”"
msgstr "«Смотри, какая ВАТА, МАма!»"

msgid "“May it come easy”, said to someone at work"
msgstr "«Пусть будет легко» — говорят тому, кто работает"

msgid "“On Monday” takes an ending: <0/>. That comes in lesson {when}."
msgstr "«В понедельник» по-эстонски — одно слово с окончанием: <0/>. Об этом — в уроке {when}."

msgid "“Schönen Feierabend!” wishes someone a good evening off."
msgstr "«Schönen Feierabend!» — пожелание хорошо отдохнуть после работы."

msgid "“To have”"
msgstr "«Иметь»"

msgid "“To like”"
msgstr "«Нравиться»"


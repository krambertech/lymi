msgstr "Дієприкметники"

msgid "Particle verbs"
msgstr "Складені дієслова"

msgid "Particles spreading from high to low concentration"
msgstr "Поширення частинок від вищої концентрації до нижчої"

msgid "Particles spreading from where there are more of them to where there are fewer"
msgstr "Рух частинок звідти, де їх більше, туди, де їх менше"


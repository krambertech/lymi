msgstr "Дякую за роботу"

msgid "Thanks; cheers"
msgstr "Дякую; дякую, друже"

msgid "That chess term you just used, add it to my deck."
msgstr "Додай у мою колоду цей шаховий термін."

msgid "That's a book."
msgstr "Це книжка."

msgid "That's Jaan."
msgstr "Це Яан."

msgid "The -des and -mata forms"
msgstr "Форми на -des і -mata"

msgid "The {name} app icon behind Lymi’s"

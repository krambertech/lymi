#: src/components/landing/hand-cards.ts
msgid "Don’t take down a fence until you know why it was put up"
msgstr "Не зноси паркан, доки не зрозумієш, навіщо його поставили"

#: src/components/landing/hand-cards.ts
msgid "Drinking at home, alone, in your underwear"
msgstr "Пити вдома на самоті в самих трусах"

#: src/components/landing/ReviewDemo.tsx
msgid "Easy"
msgstr "Легко"


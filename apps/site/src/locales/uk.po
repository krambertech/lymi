msgid "“J’ai la flemme” is the whole excuse."
msgstr "«J’ai la flemme» — і жодних інших пояснень."

msgid "“May it come easy”, said to someone at work"
msgstr "«Хай буде легко» — кажуть тому, хто працює"

msgid "“Schönen Feierabend!” wishes someone a good evening off."
msgstr "«Schönen Feierabend!» — побажання добре відпочити після роботи."

#. placeholder {0}: deck.cards
#. placeholder {0}: section.cards
msgid "{0, plural, one {# card} other {# cards}}"
msgstr "{0, plural, one {# картка} few {# картки} many {# карток} other {# картки}}"

#. placeholder {0}: deck.length - (index % deck.length)
msgid "{0, plural, one {# due} other {# due}}"
msgstr "{0, plural, one {# картка до повторення} few {# картки до повторення} many {# карток до повторення} other {# картки до повторення}}"

#. placeholder {0}: SECTIONS.length

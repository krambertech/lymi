msgstr "Підготовка до іспитів"

msgid "Exam revision"
msgstr "Підготовка до іспиту"

msgid "Example"
msgstr "Приклад"

msgid "Examples you can hear"
msgstr "Приклади, які можна послухати"

msgid "Exams"
msgstr "Іспити"

msgid "Excuse me"
msgstr "Перепрошую"

msgid "Excuse me; sorry"
msgstr "Перепрошую; вибачте"


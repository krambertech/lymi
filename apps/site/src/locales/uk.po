msgstr "Ще раз понатискай питальні слова вище, а тоді спробуй знову."

msgid "Tap the rows above once more, then try again."
msgstr "Ще раз торкнися рядків вище, а потім спробуй знову."

msgid "Tap the six forms above once more, then try again."
msgstr "Ще раз послухай шість форм вище, а тоді спробуй знову."

msgid "Tap the verbs above once more, then try again."
msgstr "Ще раз послухай дієслова вище, а потім спробуй знову."

msgid "Tap the Whose column above once more, then try again."
msgstr "Ще раз пройдися стовпцем «Чий» вище, а потім спробуй знову."

msgid "Tap the words above once more, then try again."
msgstr "Ще раз торкнися слів вище, а потім спробуй знову."

msgid "Tap the words in order"
msgstr "Торкайся слів по порядку"

msgid "Tap the words in order first."
msgstr "Спершу торкнися слів по порядку."

msgid "Tap to turn it over"
msgstr "Торкнися, щоб перевернути"

msgid "Tape, a spare part and some nerve."
msgstr "Скотч, запасна деталь і трохи сміливості."

msgid "Tartu"
msgstr "Тарту"

msgid "Tartu is a beautiful *city*."
msgstr "Тарту — гарне *місто*."


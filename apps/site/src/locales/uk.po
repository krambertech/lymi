msgid "The *book* is on the table."
msgstr "*Книжка* лежить на столі."

msgid "The *castle* is open to tourists."
msgstr "*Замок* відкритий для туристів."

msgid "The *flat* has two rooms."
msgstr "У *квартирі* дві кімнати."

msgid "The *flour* is on the top shelf."
msgstr "*Борошно* на верхній полиці."

msgid "The *girl* is reading a book."
msgstr "*Дівчинка* читає книжку."

msgid "The *hedgehog* is asleep under a bush."
msgstr "*Їжачок* спить під кущем."

msgid "The *lock* is broken again."
msgstr "*Замок* знову зламався."

msgid "The *lock* on the door is broken."
msgstr "*Замок* на дверях зламався."

msgid "The *metro* is faster than the bus."
msgstr "На *метро* швидше, ніж автобусом."

msgid "The *milk* is in the fridge."
msgstr "*Молоко* в холодильнику."

msgid "The *morning* was sunny."
msgstr "*Ранок* був сонячний."

msgid "The *night* was long and cold."
msgstr "*Ніч* була довга й холодна."

msgid "The *pumpkin* is orange."
msgstr "*Гарбуз* помаранчевий."

msgid "The *road* leads to the city."
msgstr "*Дорога* веде до міста."

msgid "The *shop* is closed."
msgstr "*Магазин* зачинений."

msgid "The *train* is late."
msgstr "*Потяг* запізнюється."

msgid "The *train* is running a little late."
msgstr "*Поїзд* трохи запізнюється."

msgid "The *water* is cold."
msgstr "*Вода* холодна."


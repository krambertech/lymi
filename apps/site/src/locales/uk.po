msgstr "Так ти просиш її взагалі не говорити."

msgid "That asks who she is; she told you."
msgstr "Це питання, хто вона, а вона вже сказала."

msgid "That chess term you just used, add it to my deck."
msgstr "Додай у мою колоду цей шаховий термін."

msgid "That goes for everyone."
msgstr "Це для всіх."

msgid "That holds even when the I form changes the stem: <0/> gives <1/>, though I read is <2/>. The same goes for <3/> and <4/>. Switch between the forms and tap a line to hear it."
msgstr "Це правило діє й тоді, коли форма для «я» змінює основу: з <0/> виходить <1/>, хоча «я читаю» — це <2/>. Те саме з <3/> та <4/>. Перемикай форми й торкнися рядка, щоб почути його."

msgid "That says Liisu’s name is <0>Kass</0>, Cat."
msgstr "Так виходить, що Лійсу звуть <0>Kass</0>, Кіт."

msgid "That says where you live. Mari asked how you are."
msgstr "Це про те, де ти живеш. Марі спитала, як у тебе справи."

msgid "That says you speak more slowly. To ask her, use the stem: räägi."
msgstr "Це означає, що повільніше говориш ти. Щоб попросити її, скажи основу: räägi."

msgid "That tells Jaan not to come."
msgstr "Так ти просиш Яана не підходити."

msgid "That tells Mari not to drink water. She asked what you’d like."
msgstr "Так ти просиш Марі не пити воду. А вона питала, що будеш ти."

msgid "That tells Mari to drink coffee. She asked what you’d like."
msgstr "Так ти кажеш Марі пити каву. А вона питала, що будеш ти."

msgid "That’s a book."
msgstr "Це книжка."

msgid "That’s good morning; Mari is leaving."
msgstr "Це «доброго ранку», а Марі йде."

msgid "That’s Jaan."
msgstr "Це Jaan."

msgid "That’s the time. Mari asked how you are."
msgstr "Це про те, котра година. Марі спитала, як у тебе справи."

msgid "That’s what you’re doing now. Kati asked about yesterday."
msgstr "Це про те, що ти робиш зараз. Каті питала про вчора."

msgid "The -da form of {ma}."
msgstr "Форма на -da від {ma}."

msgid "The -da form of lugema."
msgstr "Форма на -da від lugema."

msgid "The -da form of tegema."
msgstr "Форма на -da від tegema."

msgid "The -des and -mata forms"
msgstr "Форми на -des і -mata"


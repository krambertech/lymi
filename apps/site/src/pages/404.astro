---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Page not found · Lymi" description="This page does not exist." canonicalPath="/404">
  <meta slot="head" name="robots" content="noindex, nofollow" />
  <main class="mx-auto grid min-h-dvh max-w-xl place-content-center px-6 text-center">
    <p class="text-sm font-medium text-muted">404</p>
    <h1 class="mt-2 text-3xl font-medium tracking-[-0.02em] text-text">This page is not here.</h1>
    <p class="mt-3 text-base text-text-2">The public website has a smaller map than the product.</p>
    <a href="/" class="mt-6 font-medium text-text underline decoration-edge-2 underline-offset-4">Back to Lymi</a>
  </main>
</BaseLayout>

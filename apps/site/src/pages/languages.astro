---
import LanguagesPage from "../components/islands/LanguagesPage";
import { LANGUAGES_BLURB, LANGUAGES_TITLE } from "../components/landing/LanguagesView";
import BaseLayout from "../layouts/BaseLayout.astro";
import { pageI18n } from "../lib/i18n";

const i18n = pageI18n("en");
const title = i18n._(LANGUAGES_TITLE);
const description = i18n._(LANGUAGES_BLURB);

const structuredData = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Lymi",
  applicationCategory: "EducationalApplication",
  operatingSystem: "Web",
  description,
  url: "https://lymi.app/languages",
  inLanguage: "en",
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
};
---

<BaseLayout title={title} description={description} canonicalPath="/languages">
  <script
    slot="head"
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(structuredData).replaceAll("<", "\\u003c")}
  />
  <LanguagesPage client:load page="languages" />
</BaseLayout>

import { LANGUAGES_QUESTIONS } from "../components/landing/faq";
import MarketingLayout from "../layouts/MarketingLayout.astro";
---

<MarketingLayout page="languages" title={LANGUAGES_TITLE} blurb={LANGUAGES_BLURB} questions={LANGUAGES_QUESTIONS}>

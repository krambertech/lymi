---
import LanguagesPage from "../components/islands/LanguagesPage";
import { LANGUAGES_BLURB, LANGUAGES_TITLE } from "../components/landing/LanguagesView";
import { SHARE_IMAGE_ALT } from "../components/landing/LandingView";
import BaseLayout from "../layouts/BaseLayout.astro";
import { pageI18n } from "../lib/i18n";
import { localizedPath } from "../lib/routes";
import { marketingPage } from "../lib/structured-data";
import { LANGUAGES_QUESTIONS } from "../components/landing/faq";

const locale = Astro.currentLocale ?? "en";
const i18n = pageI18n(locale);
const title = i18n._(LANGUAGES_TITLE);
const description = i18n._(LANGUAGES_BLURB);
const shareImageAlt = i18n._(SHARE_IMAGE_ALT);
const path = localizedPath("languages", locale);

const structuredData = marketingPage({
  name: title,
  description,
  path,
  i18n,
  questions: LANGUAGES_QUESTIONS,
});
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath={path}
  localizedPage="languages"
  shareImageAlt={shareImageAlt}
>
  <script
    slot="head"
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(structuredData).replaceAll("<", "\\u003c")}
  />
  <LanguagesPage client:load page="languages" locale={locale} />
</BaseLayout>

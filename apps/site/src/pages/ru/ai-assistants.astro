---
import AssistantsPage from "../../components/islands/AssistantsPage";
import { ASSISTANTS_BLURB, ASSISTANTS_TITLE } from "../../components/landing/AssistantsView";
import { SHARE_IMAGE_ALT } from "../../components/landing/LandingView";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { pageI18n } from "../../lib/i18n";
import { localizedPath } from "../../lib/routes";
import { marketingPage } from "../../lib/structured-data";
import { ASSISTANTS_QUESTIONS } from "../../components/landing/faq";

const locale = Astro.currentLocale ?? "ru";
const i18n = pageI18n(locale);
const title = i18n._(ASSISTANTS_TITLE);
const description = i18n._(ASSISTANTS_BLURB);
const shareImageAlt = i18n._(SHARE_IMAGE_ALT);
const path = localizedPath("assistants", locale);

const structuredData = marketingPage({
  name: title,
  description,
  path,
  i18n,
  questions: ASSISTANTS_QUESTIONS,
});
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath={path}
  localizedPage="assistants"
  shareImageAlt={shareImageAlt}
>
  <script
    slot="head"
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(structuredData).replaceAll("<", "\\u003c")}
  />
  <AssistantsPage client:load locale={locale} />
</BaseLayout>

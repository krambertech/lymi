---
import { JOIN_BLURB, JOIN_TITLE } from "../../components/JoinView";
import JoinPage from "../../components/islands/JoinPage";
import { SHARE_IMAGE_ALT } from "../../components/landing/LandingView";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { pageI18n } from "../../lib/i18n";

const locale = Astro.currentLocale ?? "uk";
const i18n = pageI18n(locale);
const shareImageAlt = i18n._(SHARE_IMAGE_ALT);
---

<BaseLayout
  title={i18n._(JOIN_TITLE)}
  description={i18n._(JOIN_BLURB)}
  canonicalPath="/uk/join"
  localizedPage="join"
  shareImageAlt={shareImageAlt}
>
  <JoinPage client:load locale={locale} />
</BaseLayout>

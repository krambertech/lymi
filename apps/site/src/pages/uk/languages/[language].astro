---
import ShelfMissing from "../../../components/explore/ShelfMissing.astro";
import LanguagePage from "../../../components/languages/LanguagePage.astro";
import { MISSING_CACHE_CONTROL } from "../../../lib/deck-page";
import { LANGUAGE_PAGES, languageOfPage } from "../../../lib/language-pages";
import { offersLanguage } from "@lymi/core/catalog";
import { resolveLanguageDecks } from "../../../lib/public-catalog";
import { localizedPath } from "../../../lib/routes";

export const prerender = false;

const language = languageOfPage(Astro.params.language ?? "");
// This locale doesn't offer every language (`offersLanguage` in @lymi/core/catalog); those pages exist in English only.
if (language && !offersLanguage("uk", language)) {
  return Astro.redirect(localizedPath(LANGUAGE_PAGES[language].page, "en"), 301);
}
const page = language ? await resolveLanguageDecks(Astro, "uk", language) : null;
if (page instanceof Response) return page;
if (!page) {
  Astro.response.status = 404;
  Astro.response.headers.set("cache-control", MISSING_CACHE_CONTROL);
}
---

{page ? <LanguagePage page={page} /> : <ShelfMissing />}

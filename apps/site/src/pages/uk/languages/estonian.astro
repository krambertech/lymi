---
import EstonianPage from "../../../components/islands/EstonianPage";
import { ESTONIAN_BLURB, ESTONIAN_TITLE } from "../../../components/landing/EstonianView";
import MarketingLayout from "../../../layouts/MarketingLayout.astro";
import { resolveEstonianDecks } from "../../../lib/public-catalog";

export const prerender = false;

const locale = "uk";
const page = await resolveEstonianDecks(Astro, locale);
if (page instanceof Response) return page;
---

<MarketingLayout page="estonian" title={ESTONIAN_TITLE} blurb={ESTONIAN_BLURB} locale={locale}>
  <EstonianPage client:load locale={locale} decks={page.decks} />
</MarketingLayout>

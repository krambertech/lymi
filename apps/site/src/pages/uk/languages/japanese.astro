---
import LanguagesPage from "../../../components/islands/LanguagesPage";
import { JAPANESE_BLURB, JAPANESE_TITLE } from "../../../components/landing/JapaneseView";
import { SHARE_IMAGE_ALT } from "../../../components/landing/LandingView";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { pageI18n } from "../../../lib/i18n";
import { localizedPath } from "../../../lib/routes";
import { marketingPage } from "../../../lib/structured-data";

const locale = Astro.currentLocale ?? "uk";
const i18n = pageI18n(locale);
const title = i18n._(JAPANESE_TITLE);
const description = i18n._(JAPANESE_BLURB);
const shareImageAlt = i18n._(SHARE_IMAGE_ALT);
const path = localizedPath("japanese", locale);

const structuredData = marketingPage({
  name: title,
  description,
  path,
  i18n,
});
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath={path}
  localizedPage="japanese"
  shareImageAlt={shareImageAlt}
>
  <script
    slot="head"
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(structuredData).replaceAll("<", "\\u003c")}
  />
  <LanguagesPage client:load page="japanese" locale={locale} />
</BaseLayout>

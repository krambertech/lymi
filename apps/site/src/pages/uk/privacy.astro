---
import {
  PrivacyPolicy,
  PRIVACY_DESCRIPTION,
  PRIVACY_HEADING,
  PRIVACY_LEAD,
  PRIVACY_TITLE,
  PRIVACY_UPDATED,
} from "../../components/PrivacyPolicy";
import PublicDocumentLayout from "../../layouts/PublicDocumentLayout.astro";
import { pageI18n } from "../../lib/i18n";

const locale = Astro.currentLocale ?? "uk";
const i18n = pageI18n(locale);
---

<PublicDocumentLayout
  title={i18n._(PRIVACY_TITLE)}
  description={i18n._(PRIVACY_DESCRIPTION)}
  canonicalPath="/uk/privacy"
  localizedPage="privacy"
  heading={i18n._(PRIVACY_HEADING)}
  lead={i18n._(PRIVACY_LEAD)}
  updated={i18n._(PRIVACY_UPDATED)}
>
  <PrivacyPolicy locale={locale} />
</PublicDocumentLayout>

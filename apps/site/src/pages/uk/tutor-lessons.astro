---
import TutorLessonsPage from "../../components/islands/TutorLessonsPage";
import { TUTOR_LESSONS_BLURB, TUTOR_LESSONS_TITLE } from "../../components/landing/TutorLessonsView";
import { SHARE_IMAGE_ALT } from "../../components/landing/LandingView";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { pageI18n } from "../../lib/i18n";
import { localizedPath } from "../../lib/routes";
import { marketingPage } from "../../lib/structured-data";
import { TUTOR_LESSONS_QUESTIONS } from "../../components/landing/faq";

const locale = Astro.currentLocale ?? "uk";
const i18n = pageI18n(locale);
const title = i18n._(TUTOR_LESSONS_TITLE);
const description = i18n._(TUTOR_LESSONS_BLURB);
const shareImageAlt = i18n._(SHARE_IMAGE_ALT);
const path = localizedPath("tutorLessons", locale);

const structuredData = marketingPage({
  name: title,
  description,
  path,
  i18n,
  questions: TUTOR_LESSONS_QUESTIONS,
});
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath={path}
  localizedPage="tutorLessons"
  shareImageAlt={shareImageAlt}
>
  <script
    slot="head"
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(structuredData).replaceAll("<", "\\u003c")}
  />
  <TutorLessonsPage client:load locale={locale} />
</BaseLayout>

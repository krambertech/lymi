# Copy to .dev.vars (gitignored). Wrangler loads these as secrets in local dev,
# and they override the production `vars` in wrangler.jsonc.
PUBLIC_SITE_URL=http://localhost:5173
PRODUCT_URL=http://localhost:5173
# Local dev accepts email + password sign-in. Add the address you will use here.
ALLOWED_EMAILS=kateryna@buffer.com,dev@lymi.local
# Accounts that may exercise operational capabilities such as the email smoke test.
OPERATOR_EMAILS=dev@lymi.local
# Accounts that may publish decks they own. ADR 0020.
PUBLISHER_EMAILS=dev@lymi.local
BETTER_AUTH_SECRET=change-me-to-32-random-chars
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# The iPhone app's bundle identifier, which Apple's ID tokens name as their audience.
APPLE_APP_BUNDLE_IDENTIFIER=
# Full service-account JSON for the dedicated Google Cloud Text-to-Speech project.
# Gemini voices also need the account to hold roles/aiplatform.user.
GOOGLE_CLOUD_TTS_CREDENTIALS=
# AI Studio Gemini is the general default; Cloud Gemini is used when this key is absent.
GEMINI_API_KEY=
# Native reference voices override Gemini for configured languages.
ELEVENLABS_API_KEY=
ELEVENLABS_SPEECH_MODEL=eleven_v4
# Optional JSON map of locale/root to voice ID; null uses Gemini for that language.
# Example: {"cs": "KIDKfqJyZ6ASuyzsKfh5", "ru": null}
ELEVENLABS_SPEECH_VOICES=
# Optional Gemini speech overrides.
GEMINI_SPEECH_MODEL=gemini-3.1-flash-tts-preview
GEMINI_SPEECH_VOICE=Kore
# Generate once with `pnpm --filter @lymi/web exec web-push generate-vapid-keys`.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
OPENAI_API_KEY=
# Optional OpenAI speech overrides. OpenAI falls back to Chirp when Cloud credentials are present.
OPENAI_BASE_URL=
OPENAI_SPEECH_MODEL=gpt-4o-mini-tts
OPENAI_SPEECH_VOICE=marin
AI_GATEWAY_TOKEN=
# Only while an OpenAI plugin submission is verifying the domain.
OPENAI_APPS_CHALLENGE=
# The phone app's `TEAMID.bundle`, so join and add links open it. Empty turns universal links off.
APPLE_APP_ID=
# Comma-separated SHA-256 fingerprints of the Android app's signing certificates. Empty turns app links off.
ANDROID_CERT_FINGERPRINTS=
# Reads lesson photos, PDFs and text into a pick list. Operators only until a paid plan exists.
ANTHROPIC_API_KEY=
# Needed when the key belongs to the organisation rather than one workspace.
ANTHROPIC_WORKSPACE_ID=
ANTHROPIC_LESSON_MODEL=claude-haiku-5-5
# AI_GATEWAY_ID and ANTHROPIC_BASE_URL come from wrangler.jsonc; lesson reads use the gateway
# only when AI_GATEWAY_TOKEN is set.

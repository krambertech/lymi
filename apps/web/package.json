{
  "name": "@lymi/web",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "vite build && wrangler deploy -c dist/lymi/wrangler.json",
    "deploy:ci": "node ../../scripts/apply-migrations-ci.mjs && wrangler deploy -c dist/lymi/wrangler.json --tag \"$WORKERS_CI_COMMIT_SHA\"",
    "deploy:check": "wrangler deploy --dry-run -c dist/lymi/wrangler.json",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.worker.json",
    "test": "vitest run --passWithNoTests",
    "cf-typegen": "wrangler types",
    "db:generate": "drizzle-kit generate && node ../../scripts/check-migrations.mjs --write",
    "db:check": "drizzle-kit check",
    "db:migrate": "wrangler d1 migrations apply lymi --local",
    "db:migrate:prod": "wrangler d1 migrations apply lymi --remote",
    "auth:schema": "auth generate --config src/server/auth-cli.ts --output ../../packages/core/src/schema/auth.ts -y",
    "i18n:extract": "lingui extract --clean"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@cloudflare/vite-plugin": "^1.54.4",
    "@modelcontextprotocol/client": "2.0.0",
    "@lingui/babel-plugin-lingui-macro": "6.7.0",
    "@lingui/cli": "6.7.0",
    "@lingui/format-po": "6.7.0",
    "@lingui/vite-plugin": "6.7.0",
    "@rolldown/plugin-babel": "0.2.3",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-plugin": "^1.168.35",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.1.1",
    "auth": "1.7.2",
    "drizzle-kit": "^0.31.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.0",
    "wrangler": "^4.129.0"
  },
  "dependencies": {
    "@better-auth/api-key": "1.7.2",
    "@better-auth/cimd": "1.7.2",
    "@better-auth/core": "1.7.2",
    "@better-auth/mcp": "1.7.2",
    "@better-auth/oauth-provider": "1.7.2",
    "@better-auth/utils": "0.4.2",
    "@fontsource-variable/onest": "^5.3.1",
    "@hono/standard-validator": "^0.2.3",
    "@lingui/core": "6.7.0",
    "@lingui/react": "6.7.0",
    "@lymi/core": "workspace:*",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@tanstack/query-sync-storage-persister": "^5.102.8",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-query-persist-client": "^5.102.8",
    "@tanstack/react-router": "^1.170.32",
    "agents": "0.22.0",
    "better-auth": "^1.7.2",
    "clsx": "^2.1.1",
    "hono": "^4.13.7",
    "hono-openapi": "1.3.1",
    "lucide-react": "^1.41.0",
    "motion": "^13.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "vaul": "^1.1.2",
    "web-push": "^3.6.7",
    "workbox-window": "^7.4.1",
    "zod": "^4.5.4"
  }
}

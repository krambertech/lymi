{
  "name": "@lymi/web",
  "version": "0.0.1",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "vite build && wrangler deploy -c dist/lymi/wrangler.json",
    "deploy:ci": "node ../../scripts/apply-migrations-ci.mjs && wrangler deploy -c dist/lymi/wrangler.json --tag \"$WORKERS_CI_COMMIT_SHA\"",
    "deploy:check": "wrangler deploy --dry-run -c dist/lymi/wrangler.json",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.worker.json",
    "test": "vitest run --passWithNoTests",
    "cf-typegen": "wrangler types",
    "db:generate": "drizzle-kit generate && node ../../scripts/check-migrations.mjs --write",
    "db:check": "drizzle-kit check",
    "db:migrate": "wrangler d1 migrations apply lymi --local",
    "db:migrate:prod": "wrangler d1 migrations apply lymi --remote",
    "auth:schema": "auth generate --config src/server/auth-cli.ts --output ../../packages/core/src/schema/auth.ts -y",
    "i18n:extract": "lingui extract --clean"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@cloudflare/vite-plugin": "^1.63.1",
    "@lingui/babel-plugin-lingui-macro": "6.9.1",
    "@lingui/cli": "6.9.1",
    "@lingui/format-po": "6.9.1",
    "@lingui/vite-plugin": "6.9.1",
    "@modelcontextprotocol/client": "2.0.0",
    "@rolldown/plugin-babel": "0.2.3",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-plugin": "^1.168.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser-playwright": "5.0.3",
    "auth": "1.7.2",
    "drizzle-kit": "^0.31.11",
    "playwright": "1.64.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.3",
    "vitest-browser-react": "^2.3.0",
    "wrangler": "^4.149.0"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@better-auth/api-key": "1.7.2",
    "@better-auth/cimd": "1.7.2",
    "@better-auth/core": "1.7.2",
    "@better-auth/mcp": "1.7.2",
    "@better-auth/oauth-provider": "1.7.2",
    "@better-auth/utils": "0.4.2",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/onest": "^5.3.1",
    "@hono/standard-validator": "^0.4.0",
    "@lingui/core": "6.9.1",
    "@lingui/react": "6.9.1",
    "@lymi/core": "workspace:*",
    "@modelcontextprotocol/ext-apps": "2.0.3",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-query-persist-client": "^5.104.1",
    "@tanstack/react-router": "^1.170.42",
    "agents": "0.28.0",
    "better-auth": "^1.7.2",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "fzstd": "0.1.1",
    "hono": "^4.13.13",
    "hono-openapi": "1.3.5",
    "lucide-react": "^1.55.0",
    "motion": "^14.1.0",
    "posthog-js": "^1.438.7",
    "posthog-node": "^5.55.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "web-push": "^3.6.7",
    "workbox-window": "^7.4.1",
    "zod": "^4.6.5"
  }
}

msgstr "Ключ без названия"

msgid "Unverified"
msgstr "Не проверено"

msgid "Up to {MAX_FILES} files at a time. The first {room} were added."
msgstr "Не больше {MAX_FILES} файлов за раз. Добавлены первые {room}."


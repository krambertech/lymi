msgid "US civics test"
msgstr "Тест на гражданство США"

msgid "Use “{tag}” as the tag"
msgstr "Использовать «{tag}» как тег"

msgid "Use a JPEG, PNG, WebP or still GIF under 10 MB."
msgstr "Используй JPEG, PNG, WebP или статичный GIF до 10 МБ."

msgid "Use a language tag like ca, pt-BR or zh-Hant."
msgstr "Используй языковой тег вроде ca, pt-BR или zh-Hant."

msgid "Use a public http or https link to a picture."
msgstr "Используй публичную ссылку на изображение через http или https."

msgid "Use AI services"
msgstr "Использовать AI-сервисы"

msgid "Use another account"
msgstr "Войти в другой аккаунт"

msgid "Use at least {MIN_PASSWORD_LENGTH} characters."
msgstr "Используй не меньше {MIN_PASSWORD_LENGTH} символов."

msgid "Use at most {MAX_PASSWORD_LENGTH} characters."
msgstr "Используй не больше {MAX_PASSWORD_LENGTH} символов."

msgid "Use link"
msgstr "Использовать ссылку"

msgid "Use these fields"
msgstr "Использовать эти поля"

msgid "Use these languages"
msgstr "Использовать эти языки"

msgid "Use up to 20 tags of 40 characters or fewer."
msgstr "Используй до 20 тегов, каждый до 40 символов."

msgid "used {d} d ago"
msgstr "использован {d} дн. назад"

msgid "used {date}"
msgstr "использован {date}"

msgid "used {h} h ago"
msgstr "использован {h} ч назад"

msgid "used {m} min ago"
msgstr "использован {m} мин назад"

msgid "used just now"
msgstr "только что использован"

msgid "View card"
msgstr "Посмотреть карточку"

msgid "Visibility"
msgstr "Видимость"

msgid "We read every report within a day. The owner isn’t told who sent it."
msgstr "Мы читаем каждую жалобу в течение суток. Владелец не узнает, кто её отправил."

msgid "We signed out your other devices."
msgstr "Мы вышли из аккаунта на других устройствах."

msgid "We’ll email you a 6-digit code. Enter it below, then choose Delete account."
msgstr "Мы отправим на почту шестизначный код. Введи его ниже и нажми «Удалить аккаунт»."

msgid "We’ll email you a link to set a new one."
msgstr "Отправим на почту ссылку, чтобы задать новый."

msgid "We’ll reply by email."
msgstr "Мы ответим по почте."

msgctxt "Password strength"
msgid "Weak"
msgstr "Слабый"


msgid "Travel"
msgstr "Подорожі"

msgid "Try a clearer photo or paste the lesson text."
msgstr "Спробуй чіткіше фото або встав текст уроку."

msgid "Try a deck’s name, its language or its series."
msgstr "Спробуй назву колоди, її мову або серію."

msgid "Try a different term or meaning, or clear the search."
msgstr "Спробуй інший термін чи значення або очисть пошук."

msgid "Try a memory hook"
msgstr "Спробуй зачіпку"

msgid "Try again"
msgstr "Спробувати ще раз"

msgid "Try again on a steadier connection and keep Lymi open until the upload finishes."
msgstr "Спробуй ще раз зі стабільнішим з’єднанням і не закривай Lymi, доки файл не завантажиться."

msgid "Try to remember, then reveal the answer"
msgstr "Спробуй згадати, потім відкрий відповідь"

msgid "Try to remember, then tap to reveal"
msgstr "Спробуй згадати, потім торкнися картки"

msgid "Turn off link"
msgstr "Вимкнути посилання"

msgid "Turn off the join link?"
msgstr "Вимкнути посилання для приєднання?"

msgid "Turn your notes into cards"
msgstr "Перетвори нотатки на картки"

msgid "Turned off the join link for {deck}"
msgstr "Посилання для приєднання до «{deck}» вимкнено"

msgid "Turned on the join link for {deck}"
msgstr "Посилання для приєднання до «{deck}» увімкнено"

msgid "Type a name above, then press Enter to tag this card."
msgstr "Введи назву вище й натисни Enter, щоб додати тег до картки."

msgid "Type the term."
msgstr "Введи термін."

msgid "Type your own cards"
msgstr "Напиши свої картки"

msgid "Undo"

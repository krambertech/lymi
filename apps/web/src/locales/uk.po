msgid "US civics test"
msgstr "Тест на громадянство США"

msgid "Use “{tag}” as the tag"
msgstr "Використати «{tag}» як тег"

msgid "Use a JPEG, PNG, WebP or still GIF under 10 MB."
msgstr "Використай JPEG, PNG, WebP або статичний GIF до 10 МБ."

msgid "Use a language tag like ca, pt-BR or zh-Hant."
msgstr "Використовуй мовний тег на кшталт ca, pt-BR або zh-Hant."

msgid "Use a public http or https link to a picture."
msgstr "Використай публічне посилання на зображення через http або https."

msgid "Use at least {MIN_PASSWORD_LENGTH} characters."
msgstr "Використай щонайменше {MIN_PASSWORD_LENGTH} символів."

msgid "Use at most {MAX_PASSWORD_LENGTH} characters."
msgstr "Використай не більше {MAX_PASSWORD_LENGTH} символів."

msgid "Use link"
msgstr "Використати посилання"

msgid "Use these fields"
msgstr "Використати ці поля"

msgid "Use these languages"
msgstr "Використати ці мови"

msgid "Use up to 20 tags of 40 characters or fewer."
msgstr "Використай до 20 тегів, кожен до 40 символів."

msgid "used {d} d ago"
msgstr "використано {d} дн. тому"

msgid "used {date}"
msgstr "використано {date}"

msgid "used {h} h ago"
msgstr "використано {h} год тому"

msgid "used {m} min ago"
msgstr "використано {m} хв тому"

msgid "used just now"
msgstr "щойно використано"

msgid "View card"
msgstr "Переглянути картку"

msgid "Visibility"
msgstr "Видимість"

msgid "We signed out your other devices."
msgstr "Ми вийшли з акаунта на інших пристроях."

msgid "We’ll email you a 6-digit code. Enter it below, then choose Delete account."
msgstr "Ми надішлемо на пошту шестизначний код. Введи його нижче й натисни «Видалити акаунт»."

msgid "We’ll email you a link to set a new one."
msgstr "Надішлемо на пошту посилання, щоб задати новий."

msgid "We’ll reply by email."
msgstr "Ми відповімо на пошту."

msgctxt "Password strength"
msgid "Weak"
msgstr "Слабкий"


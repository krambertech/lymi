msgstr "Це запрошення працює лише для цієї адреси. Якщо ти на нього не чекаєш, проігноруй цей лист."

msgid "This invitation was sent to {invited}. Sign in with that address to join."
msgstr "Це запрошення надіслано на {invited}. Увійди з цією адресою, щоб приєднатися."

msgid "This isn’t a .mochi file. Choose the file you exported from Mochi."
msgstr "Це не файл .mochi. Вибери файл, експортований з Mochi."

msgid "This isn’t a .zip file. Choose the file you exported from Lymi."
msgstr "Це не файл .zip. Вибери файл, експортований з Lymi."

msgid "This isn’t an .apkg or .colpkg file. Choose the file you exported from Anki."
msgstr "Це не файл .apkg чи .colpkg. Вибери файл, експортований з Anki."

msgid "This join link does not work"
msgstr "Це посилання для приєднання не працює"

msgid "This join link is turned off"
msgstr "Це посилання для приєднання вимкнено"

msgid "This join link stopped working. Ask the owner for a new one."
msgstr "Це посилання перестало працювати. Попроси нове у власника колоди."

msgid "This link is missing the app that asked. Start again from the app."
msgstr "У цьому посиланні немає застосунку, який надіслав запит. Почни знову із застосунку."

msgid "This takes a few seconds for most files. Nothing is added to your decks yet."
msgstr "Для більшості файлів це займає кілька секунд. У колоди поки нічого не додано."

msgid "This test confirms that Lymi can send account emails."
msgstr "Цей тест підтверджує, що Lymi може надсилати листи щодо акаунта."

msgid "This week"
msgstr "Цього тижня"

msgid "Time"
msgstr "Час"

msgid "To export every deck at once, open <0>Settings</0> and choose <1>Export everything</1> instead."
msgstr "Щоб експортувати всі колоди одразу, відкрий <0>Settings</0> і вибери <1>Export everything</1>."

msgid "To move a deck into or out of a series, press Space, use the arrow keys, and press Space again."
msgstr "Щоб перенести колоду в серію чи з неї, натисни пробіл, пересунь її стрілками й натисни пробіл ще раз."


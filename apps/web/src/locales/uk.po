msgid "Untitled key"
msgstr "Ключ без назви"

msgid "Unverified"
msgstr "Не перевірено"

msgid "Up to {MAX_FILES} files at a time. The first {room} were added."
msgstr "Не більше {MAX_FILES} файлів за раз. Додано перші {room}."

msgid "Updated {lastAdded}"
msgstr "Оновлено {lastAdded}"

msgid "Uploading"
msgstr "Завантаження"


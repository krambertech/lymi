msgid "The upload stopped partway"
msgstr "Завантаження зупинилося на півдорозі"

msgid "Their invitation link stops working. You can invite them again any time."
msgstr "Посилання із запрошення перестане працювати. Ти можеш запросити знову будь-коли."

msgid "Theme"
msgstr "Тема"

msgid "There is no deck at this address"
msgstr "За цією адресою немає колоди"

msgid "They already have a pending invitation."
msgstr "У цієї людини вже є запрошення без відповіді."

msgid "They get an email with a link only they can use. They can study the deck but not change it."
msgstr "Людина отримає лист із посиланням лише для неї. Вона зможе вивчати колоду, але не змінювати її."

msgid "They lose this deck and can’t rejoin, by link or invitation. Their reviews are kept."
msgstr "Людина втратить доступ до колоди й не зможе повернутися ні за посиланням, ні за запрошенням. Її повторення збережуться."

msgid "They’re already in this deck."
msgstr "Ця людина вже в колоді."

msgid "This account publishes decks"
msgstr "Цей акаунт публікує колоди"

msgid "This browser can’t show reminders."
msgstr "Цей браузер не показує нагадувань."

msgid "This card’s picture was removed."
msgstr "Зображення цієї картки прибрано."

msgid "This code has expired. Send a new one."
msgstr "Термін дії коду минув. Надішли новий."

msgid "This deck is already in Library."
msgstr "Ця колода вже є в Бібліотеці."

msgid "This deck is already yours."
msgstr "Ця колода вже твоя."

msgid "This deck is archived"
msgstr "Ця колода в архіві"

msgid "This deck is no longer here"
msgstr "Цієї колоди більше немає"

msgid "This deck is no longer published"
msgstr "Цю колоду більше не опубліковано"

msgid "This deck is no longer published."
msgstr "Цю колоду більше не опубліковано."

msgid "This deck is not published"
msgstr "Ця колода не опублікована"

msgid "This file expired after a day. Export again to get a new one."
msgstr "Термін дії файлу минув через день. Експортуй ще раз, щоб отримати новий."

msgid "This file has no learning progress, so every card starts as new. To keep your progress, export again with learning progress turned on."
msgstr "У цьому файлі немає прогресу навчання, тож кожна картка почнеться як нова. Щоб зберегти прогрес, експортуй ще раз з увімкненим прогресом навчання."

msgid "This file has no review history, so every card starts as new."
msgstr "У цьому файлі немає історії повторень, тож кожна картка почнеться як нова."

msgid "This file has no review history, so every card starts as new. To keep your progress, export again with Include Scheduling Information ticked."
msgstr "У цьому файлі немає історії повторень, тож кожна картка почнеться як нова. Щоб зберегти прогрес, експортуй ще раз з позначкою Include Scheduling Information."

msgid "This file is damaged"
msgstr "Цей файл пошкоджено"

msgid "This file is empty. Export it again from {app}."
msgstr "Цей файл порожній. Експортуй його ще раз з {app}."

msgid "This file is larger than 1 GB. Export one deck at a time."
msgstr "Цей файл більший за 1 ГБ. Експортуй колоди по одній."

msgid "This file is larger than 5 MB. Split the set and import it in parts."
msgstr "Цей файл більший за 5 МБ. Розділи набір та імпортуй його частинами."

msgid "This file is too large to import at once"
msgstr "Цей файл завеликий, щоб імпортувати його за раз"

msgid "This import expired"
msgstr "Термін цього імпорту минув"

msgid "This import is archived"
msgstr "Цей імпорт архівовано"

msgid "This invitation only works for this email address. If you weren’t expecting it, ignore this email."
msgstr "Це запрошення працює лише для цієї адреси. Якщо ти на нього не чекаєш, просто не зважай на цей лист."

msgid "This invitation was sent to {invited}. Sign in with that address to join."
msgstr "Це запрошення надіслано на {invited}. Увійди з цією адресою, щоб приєднатися."

msgid "This is how it will look in Lymi. Change fields if a part is in the wrong place."
msgstr "Так вона виглядатиме в Lymi. Зміни поля, якщо щось стоїть не на своєму місці."

msgid "This isn’t a .mochi file. Choose the file you exported from Mochi."
msgstr "Це не файл .mochi. Вибери файл, експортований з Mochi."

msgid "This isn’t a .txt file. Paste the text Quizlet copies, or choose a .txt file."
msgstr "Це не файл .txt. Встав текст, який копіює Quizlet, або вибери файл .txt."

msgid "This isn’t a .zip file. Choose the file you exported from Lymi."
msgstr "Це не файл .zip. Вибери файл, експортований з Lymi."

msgid "This isn’t an .apkg or .colpkg file. Choose the file you exported from Anki."
msgstr "Це не файл .apkg чи .colpkg. Вибери файл, експортований з Anki."

msgid "This isn’t an .ofc file. Choose the file you exported from Noji."
msgstr "Це не файл .ofc. Вибери файл, експортований з Noji."

msgid "This join link does not work"
msgstr "Це посилання для приєднання не працює"

msgid "This join link is turned off"
msgstr "Це посилання для приєднання вимкнено"

msgid "This join link stopped working. Ask the owner for a new one."
msgstr "Це посилання перестало працювати. Попроси нове у власника колоди."

msgid "This link is missing the app that asked. Start again from the app."
msgstr "У цьому посиланні немає застосунку, який надіслав запит. Почни знову із застосунку."

msgid "This shelf has no page"
msgstr "У цієї полиці немає сторінки"

msgid "This takes a few seconds for most files. Nothing is added to your decks yet."
msgstr "Для більшості файлів це займає кілька секунд. У колоди поки нічого не додано."

msgid "This test confirms that Lymi can send account emails."
msgstr "Цей тест підтверджує, що Lymi може надсилати листи щодо акаунта."

msgid "This text is larger than 5 MB. Split the set and import it in parts."
msgstr "Цей текст більший за 5 МБ. Розділи набір та імпортуй його частинами."

msgid "This week"
msgstr "Цього тижня"

msgid "Tick a tag to put it on every card, or untick it to take it off."
msgstr "Познач тег, щоб додати його на всі картки, або зніми позначку, щоб прибрати."

msgid "Time"
msgstr "Час"

msgid "To export every deck at once, open <0>Settings</0> and choose <1>Export everything</1> instead."
msgstr "Щоб експортувати всі колоди одразу, відкрий <0>Settings</0> і вибери <1>Export everything</1>."

msgid "To move a deck into or out of a series, press Space, use the arrow keys, and press Space again."
msgstr "Щоб перенести колоду в серію чи з неї, натисни пробіл, пересунь її стрілками й натисни пробіл ще раз."

msgid "Today"
msgstr "Сьогодні"

msgid "Today, {day}: {reviews}"
msgstr "Сьогодні, {day}: {reviews}"

msgid "Today, {day}: {reviews} of {goal}"
msgstr "Сьогодні, {day}: {reviews} з {goal}"

msgid "Today, {day}: {reviews}, from an import"
msgstr "Сьогодні, {day}: {reviews}, з імпорту"

msgid "Today, {day}: all due cards reviewed, {reviews}"
msgstr "Сьогодні, {day}: повторено всі картки, {reviews}"

msgid "Today, {day}: goal reached, {reviews}"
msgstr "Сьогодні, {day}: мету досягнуто, {reviews}"

msgid "Today, {day}: no reviews yet"
msgstr "Сьогодні, {day}: ще без повторень"

msgid "Today, {day}: nothing due"
msgstr "Сьогодні, {day}: нічого повторювати"

msgid "Today’s goal"
msgstr "Мета на сьогодні"

msgid "Tomorrow"
msgstr "Завтра"

msgid "Too many attempts. Try again in {minutes, plural, one {# minute} other {# minutes}}."
msgstr "Забагато спроб. Спробуй ще через {minutes, plural, one {# хвилину} few {# хвилини} many {# хвилин} other {# хвилини}}."

msgid "Too many attempts. Try again later."
msgstr "Забагато спроб. Спробуй трохи згодом."

msgid "Took “{deckName}” out of its series"
msgstr "«{deckName}» вийнято з серії"

msgid "Took “{term}” out of its section"
msgstr "Картку «{term}» вийнято з розділу"

msgid "Took {count, plural, one {# card} other {# cards}} out of their sections"
msgstr "{count, plural, one {# картку вийнято з розділу} few {# картки вийнято з розділів} many {# карток вийнято з розділів} other {# картки вийнято з розділів}}"


{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lymi",
  "main": "src/server/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // One origin only: Better Auth trusts APP_URL, so preview URLs would fail sign-in.
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "not_found_handling": "single-page-application",
    // Only these paths run the Worker. Everything else is a static asset and costs nothing,
    // the landing page at "/" included: it is the same shell for every visitor, so it is
    // cheaper and faster served from the edge than through a Worker that only forwards it.
    "run_worker_first": [
      "/api/*",
      "/mcp",
      "/mcp/*",
      "/.well-known/*",
      "/robots.txt",
      "/sitemap.xml"
    ]
  },
  // Production values. Local dev overrides these from .dev.vars.
  "vars": {
    "APP_URL": "https://lymi.app",
    // Comma-separated. Only these Google accounts can sign in while the app is private.
    "ALLOWED_EMAILS": "kateryna@buffer.com,k.porshnieva@gmail.com"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lymi",
      "database_id": "b4668cb8-7e22-48c0-8936-75ee28650a4a",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "AUDIO", "bucket_name": "lymi-audio" }],
  "kv_namespaces": [
    {
      "binding": "SESSIONS",
      "id": "9d47517e26c44e23967a77a0f46d049f"
    }
  ],
  "routes": [{ "pattern": "lymi.app", "custom_domain": true }]
}

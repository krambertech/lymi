{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lymi",
  "main": "src/server/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "assets": {
    "not_found_handling": "single-page-application",
    // Only these paths run the Worker. Everything else is a static asset and costs nothing.
    "run_worker_first": ["/api/*", "/mcp", "/mcp/*"]
  },
  // Production values. Local dev overrides these from .dev.vars.
  "vars": {
    "APP_URL": "https://lymi.app",
    // Comma-separated. Only these Google accounts can sign in while the app is private.
    "ALLOWED_EMAILS": "kateryna@buffer.com"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lymi",
      // Replace with the id from `wrangler d1 create lymi`. Local dev works with the placeholder.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "AUDIO", "bucket_name": "lymi-audio" }],
  "kv_namespaces": [
    {
      "binding": "SESSIONS",
      // Replace with the id from `wrangler kv namespace create SESSIONS`.
      "id": "00000000000000000000000000000000"
    }
  ]
  // Uncomment once lymi.app is registered and on this Cloudflare account:
  // "routes": [{ "pattern": "lymi.app", "custom_domain": true }]
}

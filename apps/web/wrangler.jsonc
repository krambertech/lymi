{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lymi",
  "main": "src/server/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 }
  },
  "triggers": { "crons": ["*/15 * * * *"] },
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  // Authentication is canonical on PRODUCT_URL, so preview URLs do not become auth origins.
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "binding": "ASSETS",
    // Keep /index.html as the exact private-app shell used by the service worker.
    "html_handling": "none",
    "not_found_handling": "single-page-application",
    // Product routing and authentication must happen before any SPA fallback is served.
    "run_worker_first": true
  },
  // Production values. Local dev overrides these from .dev.vars.
  "vars": {
    "PUBLIC_SITE_URL": "https://lymi.app",
    "PRODUCT_URL": "https://my.lymi.app",
    // Comma-separated. Only these Google accounts can sign in while the app is private.
    "ALLOWED_EMAILS": "kateryna@buffer.com,k.porshnieva@gmail.com"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lymi",
      "database_id": "b4668cb8-7e22-48c0-8936-75ee28650a4a",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "AUDIO", "bucket_name": "lymi-audio" }],
  "kv_namespaces": [
    {
      "binding": "SESSIONS",
      "id": "9d47517e26c44e23967a77a0f46d049f"
    }
  ],
  "routes": [{ "pattern": "my.lymi.app", "custom_domain": true }]
}

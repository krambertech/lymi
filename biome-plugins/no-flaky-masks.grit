// The ways a flaky test is made to pass without fixing it. docs/testing.md#flaky-tests.
or {
  `$_.waitForTimeout($_)`,
  `$_.describe.configure($config)` where { $config <: contains `retries` },
  `$_.slow()`,
  `$_.slow($_)`,
  `$_.fixme()`,
  `$_.fixme($_)`,
  `$_.fixme($_, $_)`,
  `$_.fixme($_, $_, $_)`
} as $mask where {
  register_diagnostic(span=$mask, message="A sleep, a retry, a slow or a fixme makes a flaky test pass without fixing it. Wait for the state the next step needs, such as a response, focus or a visible row; fix the cause; or delete the test and record the coverage lost (docs/testing.md#flaky-tests). A wait that proves nothing happens takes a biome-ignore saying so.")
}

{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/.astro",
      "!**/*.astro",
      "!**/node_modules",
      "!**/.wrangler",
      "!**/routeTree.gen.ts",
      "!**/migrations",
      "!design",
      "!**/public",
      "!apps/web/index.html",
      "!**/worker-configuration.d.ts",
      "!packages/design/uniwind.gen.css",
      "!apps/mobile/src/uniwind-types.d.ts",
      "!apps/mobile/contract"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "a11y": {
        "preset": "recommended",
        "noSvgWithoutTitle": "off"
      },
      "suspicious": {
        "noExplicitAny": "warn"
      },
      "style": {
        "useImportType": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": ["apps/web/src/client/**", "!apps/web/src/client/routes/**"],
      "linter": {
        "rules": {
          "style": {
            "useFilenamingConvention": {
              "level": "error",
              "options": {
                "filenameCases": ["kebab-case"]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "packages/client/src/**",
        "!packages/client/src/analytics.ts",
        "!packages/client/src/analytics.test.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "posthog-js": "Only the browser adapter in analytics.ts may load posthog-js; keep the rest of @lymi/client portable to the phone.",
                  "./analytics": "analytics.ts is the browser adapter; the phone cannot load it."
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/mobile/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "@lymi/client/analytics": "This is the browser's PostHog adapter; the phone sends through src/telemetry/posthog.ts.",
                  "posthog-js": "The phone uses posthog-react-native through src/telemetry/posthog.ts."
                }
              }
            }
          }
        }
      }
    }
  ],
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  }
}

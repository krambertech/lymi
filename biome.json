{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/.astro",
      "!**/*.astro",
      "!**/node_modules",
      "!**/.wrangler",
      "!**/routeTree.gen.ts",
      "!**/migrations",
      "!design",
      "!**/public",
      "!apps/web/index.html",
      "!**/worker-configuration.d.ts",
      "!packages/design/uniwind.gen.css",
      "!apps/mobile/src/uniwind-types.d.ts",
      "!apps/mobile/contract"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "a11y": {
        "preset": "recommended",
        "noSvgWithoutTitle": "off"
      },
      "suspicious": {
        "noExplicitAny": "warn"
      },
      "style": {
        "useImportType": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": ["apps/web/src/client/**", "!apps/web/src/client/routes/**"],
      "linter": {
        "rules": {
          "style": {
            "useFilenamingConvention": {
              "level": "error",
              "options": {
                "filenameCases": ["kebab-case"]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "packages/client/src/**",
        "!packages/client/src/analytics.ts",
        "!packages/client/src/analytics.test.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "posthog-js": "Only the browser adapter in analytics.ts may load posthog-js; keep the rest of @lymi/client portable to the phone."
                },
                "patterns": [
                  {
                    "group": [
                      "./analytics",
                      "./analytics.ts",
                      "../**/analytics",
                      "../**/analytics.ts",
                      "../analytics",
                      "../analytics.ts"
                    ],
                    "message": "analytics.ts is the browser adapter; the phone cannot load it."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "apps/web/src/client/**",
        "!apps/web/src/client/lib/use-reduce-motion.ts",
        "!**/*.test.tsx"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "motion/react": {
                    "importNames": ["useReducedMotion", "useReducedMotionConfig"],
                    "message": "Use useReduceMotion() from lib/use-reduce-motion.ts: the app has no MotionConfig provider, so useReducedMotionConfig() alone ignores the learner's setting, and useReducedMotion() alone ignores /design's reduced-motion switch."
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/site/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "motion/react": {
                    "importNames": ["useReducedMotionConfig"],
                    "message": "Use useReducedMotion() instead: most of the site has no MotionConfig provider, so useReducedMotionConfig() returns false even when the reader asks for reduced motion."
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/mobile/**", "!apps/mobile/src/i18n/list.ts"],
      "plugins": ["./biome-plugins/no-intl-list-format.grit"]
    },
    {
      "includes": ["apps/mobile/**"],
      "plugins": ["./biome-plugins/scroll-view-persist-taps.grit"]
    },
    {
      "includes": ["apps/mobile/**", "!apps/mobile/src/theme/motion.ts"],
      "plugins": [
        "./biome-plugins/spring-presets.grit",
        "./biome-plugins/no-logical-text-align.grit"
      ]
    },
    {
      "includes": ["apps/web/src/server/**", "packages/core/src/**"],
      "plugins": ["./biome-plugins/no-sql-lower.grit"]
    },
    {
      "includes": ["apps/mobile/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "@lymi/client/analytics": "This is the browser's PostHog adapter; the phone sends through src/telemetry/posthog.ts.",
                  "posthog-js": "The phone uses posthog-react-native through src/telemetry/posthog.ts.",
                  "@expo/ui/swift-ui": {
                    "importNames": ["BottomSheet"],
                    "message": "Use Sheet from src/ui/sheet.tsx: it owns the title, description, save header and the inset every sheet shares."
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/mobile/src/ui/sheet.tsx"],
      "linter": { "rules": { "style": { "noRestrictedImports": "off" } } }
    }
  ],
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  }
}

  "publication": {
    "slug": "everyday-estonian",
    "summary": "Words and phrases for your first weeks in Estonia: saying hello, shops and cafés, getting around, and the doctor.",
    "level": "A1",
    "meaningLanguage": "en",
    "publisher": "Lymi",
    "sources": [
      {
        "title": "Written for Lymi and checked against the Institute of the Estonian Language A1 vocabulary list",
        "url": "https://arhiiv.eki.ee/litsents/idkaart/A1A2B1/A1.pdf"
      }
    ]

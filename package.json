{
  "name": "lymi",
  "private": true,
  "version": "0.0.1",
  "description": "Vocabulary app with a storm lantern.",
  "packageManager": "pnpm@10.16.1",
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "dev": "pnpm --parallel --stream --filter @lymi/site --filter @lymi/web dev",
    "build": "pnpm -r build",
    "deploy": "pnpm deploy:product",
    "deploy:product": "pnpm --filter @lymi/web run deploy",
    "deploy:site": "pnpm --filter @lymi/site run deploy",
    "deploy:check": "pnpm build && pnpm check:boundaries && pnpm --filter @lymi/web run deploy:check && pnpm --filter @lymi/site run deploy:check",
    "deploy:check:product": "pnpm --filter @lymi/web run build && pnpm --filter @lymi/web run deploy:check",
    "deploy:check:site": "pnpm --filter @lymi/site run build && pnpm --filter @lymi/site run deploy:check",
    "deploy:health": "pnpm deploy:health:product && pnpm deploy:health:site",
    "deploy:health:product": "node scripts/check-deployment.mjs https://my.lymi.app/api/health lymi-product",
    "deploy:health:site": "node scripts/check-deployment.mjs https://lymi.app/api/health lymi-site",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test && node --test scripts/*.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:chromium": "playwright test --project=chromium",
    "test:e2e:ui": "playwright test --ui",
    "check": "biome check .",
    "check:migrations": "pnpm --filter @lymi/web db:check && node scripts/check-migrations.mjs && node scripts/check-schema-drift.mjs",
    "verify": "pnpm check && pnpm i18n:check && pnpm check:migrations && pnpm build && pnpm check:boundaries && pnpm typecheck && pnpm test",
    "check:boundaries": "node scripts/check-deployment-boundaries.mjs",
    "fix": "biome check --write .",
    "db:generate": "pnpm --filter @lymi/web db:generate",
    "db:migrate": "pnpm --filter @lymi/web db:migrate",
    "db:migrate:prod": "pnpm --filter @lymi/web db:migrate:prod",
    "icons": "sh scripts/icons.sh",
    "i18n:extract": "pnpm -r --filter @lymi/web --filter @lymi/site i18n:extract",
    "i18n:check": "pnpm i18n:extract && git diff --exit-code --stat -- 'apps/*/src/locales/*.po'",
    "local": "node scripts/local.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "@playwright/test": "1.63.0",
    "typescript": "^5.9.0"
  }
}

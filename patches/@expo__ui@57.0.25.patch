+#if os(iOS)
+// Lymi: SwiftUI snaps a sheet to a replaced detent, so once the sheet is up its later heights go
+// through UIKit's animateChanges, which glides; under Reduce Motion or while the keyboard moves they snap.
+private final class SheetResizer: ObservableObject {
+  weak var sheet: UISheetPresentationController? {
+    didSet { height = 0 }
+  }
+  private(set) var latest: CGSize = .zero
+  private var height: CGFloat = 0
+  private var keyboardUntil = Date.distantPast
+  private var observer: NSObjectProtocol?
+
+  init() {
+    observer = NotificationCenter.default.addObserver(
+      forName: UIResponder.keyboardWillChangeFrameNotification, object: nil, queue: .main
+    ) { [weak self] note in
+      let duration = note.userInfo?[UIResponder.keyboardAnimationDurationUserInfoKey] as? Double ?? 0.25
+      self?.keyboardUntil = Date().addingTimeInterval(duration + 0.1)
+    }
+  }
+
+  deinit {
+    if let observer { NotificationCenter.default.removeObserver(observer) }
+  }
+
+  /// Applies the height through UIKit, or returns false while the sheet is not up yet.
+  func resize(to size: CGSize) -> Bool {
+    latest = size
+    let newHeight = size.height
+    guard let sheet, sheet.presentedViewController.viewIfLoaded?.window != nil else { return false }
+    guard newHeight != height else { return true }
+    height = newHeight
+    let apply = {
+      sheet.detents = [.custom(identifier: .init("expo.ui.fitted")) { _ in newHeight }]
+      sheet.invalidateDetents()
+    }
+    if UIAccessibility.isReduceMotionEnabled || Date() < keyboardUntil {
+      apply()
+    } else {
+      sheet.animateChanges(apply)
+    }
+    return true
+  }
+}
+
+// Reaches the sheet's presentation controller from inside its content once it has appeared.
+private struct SheetControllerReader: UIViewControllerRepresentable {
+  let resizer: SheetResizer
+
+  final class Reader: UIViewController {
+    weak var resizer: SheetResizer?
+
+    override func viewDidAppear(_ animated: Bool) {
+      super.viewDidAppear(animated)
+      var top: UIViewController = self
+      while let parent = top.parent { top = parent }
+      resizer?.sheet = top.sheetPresentationController
+    }
+  }
+
+  func makeUIViewController(context: Context) -> Reader {
+    let reader = Reader()
+    reader.view.isUserInteractionEnabled = false
+    reader.resizer = resizer
+    return reader
+  }
+
+  func updateUIViewController(_ reader: Reader, context: Context) {
+    reader.resizer = resizer
+  }
+}
+#endif
